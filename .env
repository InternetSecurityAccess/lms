# ============================================================
# Переменные окружения (инфраструктура).
#
# Все бизнес-настройки приложения — в /admin/settings.
# Демо-данные (группа, студент, преподаватель, материалы)
# создаются автоматически при старте, если включён флаг
# demo.enabled в настройках. По умолчанию он включён.
#
# Логины и пароли демо-учёток заданы в config/index.js:
#   студент:        student@demo.local / Demo2026!
#   преподаватель:  teachers@demo.local / Demo2026!
# ============================================================


# ─── Режим работы ───────────────────────────────────────────
NODE_ENV=development


# ─── Сеть ───────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false


# ─── Демо-кнопки ───────────────────────────────────────────
# Показывать кнопки «Войти без пароля» на странице входа.
# Игнорируется при NODE_ENV=production.
DEMO_MODE=true


# ─── Данные ────────────────────────────────────────────────
DATA_DIR=


# ─── Секреты ───────────────────────────────────────────────
# production: обязателен, минимум 32 символа.
# development: пусто => генерируется в DATA_DIR/.session-secret.
SESSION_SECRET=


# ─── Первый администратор (bootstrap) ─────────────────────
# Используется ТОЛЬКО при первом запуске, когда таблица admins пуста.
# Дальше логин и пароль меняются в /admin/profile.
ADMIN_NAME=admin
ADMIN_PASSWORD=admin
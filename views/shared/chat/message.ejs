<%
  const isDeleted = !!m.deleted_at;
  // isOwn: сообщение отправлено текущим зрителем.
  // Сравниваем sender_type с viewerRole и sender_id с viewerId.
  const isOwn = !isDeleted
    && m.sender_id != null
    && String(m.sender_id) === String(viewerId)
    && m.sender_type === viewerRole;
  const mine = isOwn;
  const canDelete = !isDeleted
    && typeof deleteAction !== 'undefined'
    && !!deleteAction
    && (mine || (typeof canDeleteAll !== 'undefined' && canDeleteAll));
  const showFile = !isDeleted && m.file_path;
  const fileName = m.file_name || (showFile ? String(m.file_path).split('/').pop() : '');
  const isPreviewable = showFile && canPreview(fileName);
  const fileBase = showFile
    ? (typeof fileUrl !== 'undefined' && fileUrl
        ? fileUrl
        : `/file/chat-file/${encodeURIComponent(String(m.file_path).split('/').pop())}`)
    : null;
  const viewUrl = fileBase ? `${fileBase}?inline=1` : null;
  const sideClass = isOwn ? 'is-own' : 'is-other';
%>
<article class="message <%= sideClass %> <%= isDeleted ? 'message-deleted' : '' %>"
         data-id="<%= m.id %>">
  <div class="message-header">
    <span class="message-sender"><%= m.sender_name %></span>
    <div class="actions-row gap-2">
      <time class="message-time"><%= formatDate(m.created_at, true) %></time>
      <% if (!isDeleted) { %>
        <button type="button" class="btn btn-ghost btn-sm"
                data-reply-to="<%= m.id %>"
                data-reply-sender="<%= m.sender_name %>"
                data-reply-text="<%= String(m.message || '').slice(0, 80) %>">↩</button>
      <% } %>
      <% if (canDelete) { %>
        <form method="POST" action="<%= deleteAction %>" class="inline-form"
              data-confirm="Удалить это сообщение?">
          <button type="submit" class="btn-delete-message" title="Удалить сообщение">×</button>
        </form>
      <% } %>
    </div>
  </div>
  <% if (m.reply_sender) { %>
    <div class="message-reply">
      <strong><%= m.reply_sender %></strong>: <%= String(m.reply_text || '').slice(0, 120) %>
    </div>
  <% } %>
  <% if (isDeleted) { %>
    <div class="message-text message-text-deleted">Сообщение удалено</div>
  <% } else { %>
    <% if (m.message) { %>
      <div class="message-text"><%- renderText(m.message) %></div>
    <% } %>
    <% if (showFile) { %>
      <div class="message-file">
        <div>Вложение: <strong class="anywhere"><%= fileName %></strong></div>
        <div class="actions-row mt-1">
          <% if (isPreviewable) { %>
            <a href="<%= viewUrl %>"
               class="btn btn-ghost btn-sm"
               data-file-preview
               data-file-name="<%= fileName %>"
               data-view-url="<%= viewUrl %>"
               data-download-url="<%= fileBase %>">Открыть</a>
          <% } %>
          <a href="<%= fileBase %>" class="btn btn-secondary btn-sm">Скачать</a>
        </div>
      </div>
    <% } %>
  <% } %>
</article>
<%
  const _action      = (typeof action      !== 'undefined') ? action      : '';
  const _accept      = (typeof accept      !== 'undefined') ? accept      : ACCEPT_UPLOAD;
  const _hint        = (typeof hint        !== 'undefined') ? hint        : null;
  const _placeholder = (typeof placeholder !== 'undefined') ? placeholder : 'Напишите сообщение';
  const _errCode     = (typeof query !== 'undefined' && query && query.error)
    ? String(query.error) : '';
%>
<form action="<%= _action %>" method="POST" enctype="multipart/form-data" class="mt-3">
  <% if (_errCode) { %>
    <div class="info-box info-box-red" role="alert" style="margin-bottom: var(--space-2);">
      <% if (_errCode === 'file_too_large') { %>
        <strong>Файл не загружен:</strong> больше <%= MAX_FILE_SIZE_MB %> МБ. <%= HINT_UPLOAD %>
      <% } else if (_errCode === 'file_type_invalid') { %>
        <strong>Файл не загружен:</strong> недопустимый формат. <%= HINT_UPLOAD %>
      <% } else { %>
        <strong>Файл не загружен.</strong> Попробуйте ещё раз.
      <% } %>
    </div>
  <% } %>
  <div class="form-grid">
    <label for="chat-msg" class="form-label">Сообщение</label>
    <div class="field">
      <div id="replyPreview" class="reply-preview" hidden>
        <div><strong>Ответ на:</strong> <span id="replyPreviewText"></span></div>
        <button type="button" class="btn btn-ghost btn-sm" data-action="clear-reply">Отмена</button>
        <input type="hidden" name="reply_to_id" id="replyToId" value="">
      </div>
      <textarea id="chat-msg" name="message" maxlength="10000"
                placeholder="<%= _placeholder %>"></textarea>
      <div class="hint">
        <% if (_hint) { %><%= _hint %><br><% } %>
        Один файл до <%= MAX_FILE_SIZE_MB %> МБ.
        Форматы: <%= _accept %>.
      </div>
    </div>
    <label for="chat-file" class="form-label">Вложение</label>
    <div class="field">
      <input type="file" name="file" id="chat-file"
             accept="<%= _accept %>"
             data-max-size-mb="<%= MAX_FILE_SIZE_MB %>"
             data-max-files="1">
    </div>
    <div class="actions">
      <button type="submit" class="btn btn-success">Отправить</button>
    </div>
  </div>
</form>
<%
  const _items = (typeof items !== 'undefined' && Array.isArray(items)) ? items : [];
%>
<div class="info-list">
  <% _items.forEach((it) => { %>
    <div>
      <strong><%= it.label %></strong>
      <span><% if (it.html) { %><%- sanitizeHtml(it.html) %><% } else { %><%= it.value %><% } %></span>
    </div>
  <% }) %>
</div>
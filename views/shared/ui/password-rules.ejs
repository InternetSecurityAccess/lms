<%
  const _items = (typeof items !== 'undefined' && Array.isArray(items))
    ? items
    : (typeof passwordRequirements !== 'undefined' ? passwordRequirements : []);
%>
<div class="hint">
  <div>Требования к паролю:</div>
  <ul class="hint-list">
    <% _items.forEach((r) => { %>
      <li><%= r.text %></li>
    <% }) %>
  </ul>
</div>
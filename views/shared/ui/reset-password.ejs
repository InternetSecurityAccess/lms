<%
  const _autoName     = (typeof autoPasswordName     !== 'undefined') ? autoPasswordName     : null;
  const _autoPassword = (typeof autoPasswordPassword !== 'undefined') ? autoPasswordPassword : null;
  const _autoDigits   = (typeof autoPasswordDigits   !== 'undefined' && autoPasswordDigits) ? autoPasswordDigits : 8;
%>
<div id="resetPasswordModal" class="modal" hidden
  <% if (_autoPassword) { %>
    data-auto-name="<%= _autoName || '' %>"
    data-auto-password="<%= _autoPassword %>"
    data-auto-digits="<%= _autoDigits %>"
  <% } %>>
  <div class="modal-backdrop"></div>
  <div class="modal-dialog">
    <h3>Пароль сброшен</h3>
    <p>Пользователь: <strong id="rpStudentName"></strong></p>
    <p style="margin-top: 8px;">Новый пароль:</p>
    <div class="password-display">
      <code id="rpPassword"></code>
      <button type="button" id="rpCopy" class="btn btn-secondary btn-sm">Копировать</button>
    </div>
    <div class="info-box info-box-blue">
      Пароль состоит <strong>только из цифр</strong> —
      удобно продиктовать по телефону: <span id="rpDigitsCount"></span> знаков.
    </div>
    <div class="info-box info-box-yellow">
      Передайте этот пароль пользователю лично. После закрытия окна он больше не будет показан.
      При первом входе пользователь обязан сменить пароль.
    </div>
    <div class="actions-row" style="justify-content: flex-end;">
      <button type="button" id="rpClose" class="btn btn-primary">Закрыть</button>
    </div>
  </div>
</div>
<script src="/js/reset-password.js" defer></script>
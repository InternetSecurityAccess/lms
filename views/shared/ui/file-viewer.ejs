<div id="file-viewer-modal" class="file-viewer-modal" style="display:none;">
  <div class="file-viewer-backdrop" onclick="js_pdf_viewer_close()"></div>
  <div class="file-viewer-dialog">
    <div class="file-viewer-header">
      <span id="file-modal-title" class="file-viewer-title">Просмотр файла</span>
      <div class="actions-row">
        <a id="file-download-link" href="#" class="btn btn-secondary btn-sm">Скачать</a>
        <button type="button" id="file-close" class="modal-close" aria-label="Закрыть">✕</button>
      </div>
    </div>
    <div class="file-viewer-body">
      <div id="pdf-controls" class="pdf-controls" style="display:none;">
        <button type="button" id="pdf-prev-page" class="btn btn-ghost btn-sm">←</button>
        <span id="pdf-page-info" class="cell-secondary">1 / …</span>
        <button type="button" id="pdf-next-page" class="btn btn-ghost btn-sm">→</button>
        <span style="flex:1"></span>
        <button type="button" id="pdf-zoom-out" class="btn btn-ghost btn-sm">−</button>
        <button type="button" id="pdf-zoom-in" class="btn btn-ghost btn-sm">+</button>
      </div>
      <canvas id="pdf-canvas" style="display:none;"></canvas>
      <img id="image-viewer" style="display:none;" alt="">
      <pre id="text-viewer" style="display:none;"></pre>
      <div id="unsupported-viewer" style="display:none;">
        <p>Этот формат нельзя открыть в браузере. Скачайте файл.</p>
        <a id="unsupported-download-link" href="#" class="btn btn-primary">Скачать</a>
      </div>
    </div>
  </div>
</div>
<script src="/js/file-viewer.js" defer></script>
<%
  const _name        = (typeof name        !== 'undefined') ? name        : '';
  const _size        = (typeof size        !== 'undefined') ? size        : 0;
  const _viewUrl     = (typeof viewUrl     !== 'undefined') ? viewUrl     : '';
  const _downloadUrl = (typeof downloadUrl !== 'undefined') ? downloadUrl : '';
  const _previewable = canPreview(_name);
  const _sizeMb      = (Number(_size) / 1024 / 1024).toFixed(2);
%>
<div class="file-attachment-row">
  <div class="file-attachment-info">
    📎 <strong><%= _name %></strong>
    <span class="cell-secondary">(<%= _sizeMb %> МБ)</span>
  </div>
  <div class="actions-row">
    <% if (_previewable) { %>
      <a href="<%= _viewUrl %>" class="btn btn-ghost btn-sm"
         data-file-preview
         data-file-name="<%= _name %>"
         data-view-url="<%= _viewUrl %>"
         data-download-url="<%= _downloadUrl %>">Открыть</a>
    <% } %>
    <a href="<%= _downloadUrl %>" class="btn btn-secondary btn-sm">Скачать</a>
  </div>
</div>
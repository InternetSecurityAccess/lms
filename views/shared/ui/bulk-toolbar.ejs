<%
  const _entity = (typeof entity !== 'undefined') ? entity : '';
  const _scope = (typeof scope !== 'undefined' && scope) ? scope : _entity;
  const _extraClass = (typeof extraClass !== 'undefined') ? extraClass : '';
  const _actions = (typeof actions !== 'undefined' && Array.isArray(actions)) ? actions : [
    {
      href: '/admin/bulk-delete',
      label: 'Удалить выбранные',
      class: 'btn-danger btn-sm',
      method: 'POST',
      confirm: 'Удалить выбранные элементы? Действие необратимо.',
    },
  ];
%>
<div class="bulk-toolbar <%= _extraClass %>"
     data-bulk-toolbar
     data-bulk-entity="<%= _entity %>"
     data-bulk-scope="<%= _scope %>">
  <div class="bulk-toolbar-info">
    Выбрано: <strong data-bulk-count>0</strong>
  </div>
  <div class="bulk-toolbar-actions">
    <% _actions.forEach((a) => { %>
      <button type="button"
        class="btn <%= a.class || 'btn-danger btn-sm' %>"
        data-bulk-action="<%= a.href %>"
        data-bulk-method="<%= a.method || 'POST' %>"
        data-bulk-confirm="<%= a.confirm || '' %>"
        <% if (a.okText) { %>data-bulk-ok-text="<%= a.okText %>"<% } %>
        <% if (a.okClass) { %>data-bulk-ok-class="<%= a.okClass %>"<% } %>
        <% if (a.needsReason) { %>data-bulk-needs-reason="1"<% } %>
        disabled>
        <%= a.label %>
      </button>
    <% }) %>
    <button type="button" class="btn btn-ghost btn-sm" data-bulk-clear>Отмена выделения</button>
  </div>
</div>
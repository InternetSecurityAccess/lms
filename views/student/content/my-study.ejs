<%- include('../../layout/header', { title: 'Вся учёба' }) %>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: 'Вся учёба',
    actions: [{ href: '/my-subjects', label: 'Текущие предметы →', class: 'btn-secondary btn-sm' }]
  }) %>
  <div class="info-box info-box-blue info-box-how">
    <strong>Вся учёба.</strong> Все предметы, где вы учитесь или сдавали:
    активные — для текущей работы, завершённые — как история (только для чтения).
    Задания — во вкладке <a href="/my-assignments">«Мои задания»</a>.
  </div>
  <form method="GET" action="/my-study" class="inline-add-form">
    <input type="search" name="q" value="<%= q || '' %>"
      placeholder="Поиск по предмету или преподавателю"
      maxlength="100" class="search-input">
    <button type="submit" class="btn btn-primary btn-sm">Найти</button>
    <% if (q) { %><a href="/my-study" class="btn btn-ghost btn-sm">Сбросить</a><% } %>
  </form>
  <% if (total === 0) { %>
    <%- include('../../shared/ui/empty-state', {
      primary: q
        ? `Ничего не найдено по запросу «${q}».`
        : 'У вас пока нет предметов.',
      secondary: q
        ? null
        : 'Как только преподаватель прикрепит предмет к вашей группе — он появится здесь.',
      action: q
        ? { href: '/my-study', label: 'Сбросить поиск' }
        : { href: '/my-subjects', label: 'Мои предметы' }
    }) %>
  <% } else { %>
    <% if (activeSubjects.length > 0) { %>
      <section class="card">
        <div class="card-header">
          <h2>Активные предметы (<%= totalActive %>)</h2>
          <span class="cell-secondary">Вы в группе, предмет и преподаватель активны</span>
        </div>
        <div class="card-grid">
          <% activeSubjects.forEach((s) => { %>
            <a href="/t/<%= s.teacher_id %>/subjects/<%= s.id %>" class="entity-card">
              <div class="entity-card-title"><%= s.title %></div>
              <div class="entity-card-subtitle"><%= s.teacher_name %></div>
              <div class="entity-card-stats">
                <span>Тем: <%= s.topics_count %></span>
                <% if (s.my_works_count > 0) { %>
                  <span>Моих работ: <%= s.my_works_count %></span>
                <% } %>
                <span class="status-badge status-success">активен</span>
              </div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>
    <% if (finishedSubjects.length > 0) { %>
      <section class="card">
        <div class="card-header">
          <h2>Завершённые предметы (<%= totalFinishedSubjects %>)</h2>
          <span class="cell-secondary">Только для чтения</span>
        </div>
        <div class="card-grid">
          <% finishedSubjects.forEach((s) => { %>
            <a href="/t/<%= s.teacher_id %>/subjects/<%= s.id %>" class="entity-card">
              <div class="entity-card-title"><%= s.title %></div>
              <div class="entity-card-subtitle"><%= s.teacher_name %></div>
              <div class="entity-card-stats">
                <span>Тем: <%= s.topics_count %></span>
                <span>Работ: <%= s.my_works_count %></span>
                <% if (s.status === 'finished') { %>
                  <span class="status-badge status-muted">предмет завершён</span>
                <% } else if (s.teacher_status === 'finished') { %>
                  <span class="status-badge status-muted">преподаватель завершил</span>
                <% } else if (!groupActive) { %>
                  <span class="status-badge status-muted">группа завершена</span>
                <% } else { %>
                  <span class="status-badge status-muted">только чтение</span>
                <% } %>
              </div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>
  <% } %>
</div>
<%- include('../../layout/footer') %>
<%- include('../../layout/header', { title: topic.title }) %>
<%
  const hasLecture = !!(
    topic.description
    || (topic.attachments && topic.attachments.length)
    || topic.content_url
  );
  const latestWork = works && works.length > 0 ? works[0] : null;
  const hasHomework = !!(topic.homework_text || topic.assignment_url);
  const isAccepted = latestWork && latestWork.status === 'accepted';
  const canSubmit = !isAccepted
    && assignment
    && assignment.status === 'active'
    && !subject.readonly;
  const archiveHref = assignment
    ? `/t/${subject.teacher_id}/assignments/${assignment.id}/archive`
    : null;
  const isArchived = assignment
    ? (assignment.status === 'finished' || subject.readonly)
    : false;
%>
<div class="content-wrapper medium">
  <%- include('../../shared/page-top', {
    title: topic.title,
    back: { href: `/t/${subject.teacher_id}/subjects/${subject.id}` }
  }) %>
  <% if (subject.readonly) { %>
    <div class="info-box info-box-yellow">
      <strong>Только для чтения.</strong>
      Предмет завершён, преподаватель завершён или группа закрыта.
      Материалы и работы доступны, но сдавать новые и писать в чат нельзя.
      <a href="/my-study">Вся учёба →</a>
    </div>
  <% } %>
  <% if (query && query.uploaded === '1') { %>
    <div class="info-box info-box-green">Работа по заданию загружена.</div>
  <% } %>
  <% if (hasLecture) { %>
    <div id="lectureShell" class="lecture-shell">
      <div class="lecture-toolbar">
        <button type="button" class="btn btn-secondary btn-sm" data-action="toggle-lecture-fullscreen">
          <span id="lectureFsLabel">⛶ На весь экран</span>
        </button>
      </div>
      <% if (topic.description) { %>
        <section class="card">
          <% const desc = String(topic.description); %>
          <% if (desc.includes('<')) { %>
            <div class="topic-html"><%- sanitizeHtml(desc) %></div>
          <% } else { %>
            <div class="topic-html text-pre"><%= desc %></div>
          <% } %>
        </section>
      <% } %>
      <% if ((topic.attachments && topic.attachments.length) || topic.content_url) { %>
        <section class="card">
          <div class="card-header"><h2>Материалы</h2></div>
          <% if (topic.attachments && topic.attachments.length > 0) { %>
            <%- include('../../shared/ui/attachments-list', {
              items: topic.attachments, empty: '—'
            }) %>
          <% } %>
          <% if (topic.content_url) { %>
            <div class="info-box info-box-blue mt-2">
              🔗 <a href="<%= topic.content_url %>" target="_blank" rel="noopener"><%= topic.content_url %></a>
            </div>
          <% } %>
        </section>
      <% } %>
    </div>
  <% } %>
  <% if (!assignment && hasHomework) { %>
    <section class="card">
      <div class="card-header"><h2>Домашнее задание</h2></div>
      <% if (topic.homework_text) { %><div class="text-pre"><%= topic.homework_text %></div><% } %>
      <% if (topic.assignment_url) { %>
        <div class="info-box info-box-blue mt-2">
          🔗 <a href="<%= topic.assignment_url %>" target="_blank" rel="noopener"><%= topic.assignment_url %></a>
        </div>
        <div class="actions-row mt-3">
          <a href="<%= topic.assignment_url %>" target="_blank" rel="noopener" class="btn btn-primary">
            Открыть ссылку ↗
          </a>
        </div>
      <% } %>
    </section>
  <% } %>
  <% if (assignment) { %>
    <div class="info-box info-box-blue info-box-how">
      <strong>«Сдать работу»</strong> — приложите файлы или ссылку, статус «На проверке».<br>
      <strong>«Открыть в архиве»</strong> — когда задание завершено или предмет только для чтения.
      Сдать новую версию уже нельзя, но материалы и переписка доступны.<br>
      <strong>«Переписка»</strong> — обсудить замечания с преподавателем (пока работа не принята).
    </div>
    <section class="card">
      <div class="card-header">
        <h2>Задание по теме</h2>
        <% if (assignment.status === 'finished') { %>
          <span class="status-badge status-muted" title="Задание завершено">📋 завершено</span>
        <% } else if (latestWork) { %>
          <% const st = WORK_STATUSES[latestWork.status]; %>
          <span class="status-badge status-<%= st.cls %>"><%= st.label %></span>
        <% } else { %>
          <span class="status-badge status-pending">не сдано</span>
        <% } %>
      </div>
      <div class="info-list">
        <div><strong>Название</strong><span><%= assignment.title %></span></div>
        <% if (assignment.deadline) { %>
          <div><strong>Срок сдачи</strong><span><%= formatDate(assignment.deadline, true) %></span></div>
        <% } %>
        <% if (assignment.description) { %>
          <div><strong>Описание</strong><span class="text-pre"><%= assignment.description %></span></div>
        <% } %>
      </div>
      <% if (assignment.attachments && assignment.attachments.length > 0) { %>
        <div class="hint mt-2 mb-1">Файлы задания:</div>
        <%- include('../../shared/ui/attachments-list', {
          items: assignment.attachments, empty: '—'
        }) %>
      <% } %>
      <div class="actions-row mt-3">
        <% if (canSubmit) { %>
          <a href="/t/<%= subject.teacher_id %>/assignments/<%= assignment.id %>" class="btn btn-primary">
            <%= latestWork ? 'Сдать заново' : 'Сдать работу' %>
          </a>
        <% } else if (isArchived) { %>
          <a href="<%= archiveHref %>" class="btn btn-secondary">Открыть в архиве</a>
        <% } else if (latestWork) { %>
          <a href="/t/<%= subject.teacher_id %>/works/<%= latestWork.id %>" class="btn btn-secondary">
            <%= latestWork.status === 'accepted' ? 'Смотреть работу' : 'Переписка' %>
            <% if (latestWork.unread_count > 0) { %>
              <span class="unread-badge"><%= latestWork.unread_count %></span>
            <% } %>
          </a>
        <% } %>
      </div>
      <% if (isArchived) { %>
        <div class="info-box info-box-yellow mt-3">
          <strong>Задание в архиве.</strong> Сдать заново нельзя.
          Информация о сдаче — в архиве задания.
        </div>
      <% } else if (latestWork && latestWork.status === 'rejected') { %>
        <div class="info-box info-box-red mt-3">
          <strong>Работа отклонена.</strong> Откройте переписку, чтобы увидеть замечания.
          Чтобы сдать заново — нажмите «Сдать заново» выше.
        </div>
      <% } else if (latestWork && latestWork.status === 'accepted') { %>
        <div class="info-box info-box-green mt-3">
          <strong>Работа принята.</strong> Действия по заданию завершены.
        </div>
      <% } %>
    </section>
  <% } %>
</div>
<%- include('../../shared/ui/file-viewer') %>
<%- include('../../layout/footer') %>
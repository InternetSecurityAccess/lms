<%- include('../../layout/header', { title: subject.title }) %>
<%
const basePath = `/t/${subject.teacher_id}/subjects/${subject.id}`;
const baseQuery = { topics_q: topicsQ || '', type: typeFilter || '' };
const _quizCount = (typeof topicCounts.quizzes !== 'undefined') ? topicCounts.quizzes : 0;
const typeFilters = [
  { key: 'all',         label: `Все (${topicCounts.all})` },
  { key: 'lectures',    label: `Лекции (${topicCounts.lectures})` },
  { key: 'assignments', label: `Задания (${topicCounts.assignments})` },
  { key: 'quizzes',     label: `Тесты (${_quizCount})` }
].map((f) => ({
  ...f,
  href: buildUrl(basePath, baseQuery, { type: f.key === 'all' ? '' : f.key }),
  active: typeFilter === f.key
}));
%>
<div class="content-wrapper">

<%- include('../../shared/page-top', {
  title: subject.title,
  back: { href: `/t/${subject.teacher_id}` }
}) %>

<% if (subject.readonly) { %>
  <div class="info-box info-box-yellow">
    <strong>Только для чтения.</strong>
    Предмет завершён, преподаватель завершён или группа закрыта.
    Материалы, работы и результаты тестов доступны, но сдавать, писать в чат
    и проходить тесты нельзя.
    <a href="/my-study">Вся учёба →</a>
  </div>
<% } %>

<% if (subject.description) { %>
  <div class="info-box info-box-blue"><%= subject.description %></div>
<% } %>

<% if (totalAll === 0) { %>
  <div class="info-box info-box-blue info-box-how">
    Преподаватель ещё не опубликовал ни одной темы. Как только он добавит
    материал, он появится здесь: лекции, задания, тесты и приложенные файлы.
    Если вы ожидаете материалы — обратитесь к преподавателю или в
    <a href="/support">поддержку</a>.
  </div>
<% } %>

<section class="card">
  <div class="card-header">
    <h2>Темы (<%= topics.length %><%= (topicsQ || typeFilter !== 'all') ? ' из ' + totalAll : '' %>)</h2>
  </div>

  <% if (totalAll > 0) { %>
    <%- include('../../shared/ui/filter-chips', { items: typeFilters }) %>
    <form method="GET" action="<%= basePath %>" class="inline-add-form mb-2">
      <% if (typeFilter !== 'all') { %><input type="hidden" name="type" value="<%= typeFilter %>"><% } %>
      <input type="search" name="topics_q" value="<%= topicsQ %>"
             placeholder="Поиск по названию или описанию темы" maxlength="100" class="search-input">
      <button type="submit" class="btn btn-primary btn-sm">Найти</button>
      <% if (topicsQ) { %>
        <a href="<%= buildUrl(basePath, {}, { type: typeFilter === 'all' ? '' : typeFilter }) %>"
           class="btn btn-ghost btn-sm">Сбросить</a>
      <% } %>
    </form>
  <% } %>

  <% if (topics.length === 0) { %>
    <div class="empty-state">
      <% if (topicsQ) { %>
        <p>Ничего не найдено по запросу «<%= topicsQ %>».</p>
      <% } else if (typeFilter === 'lectures') { %>
        <p>Лекций пока нет.</p>
      <% } else if (typeFilter === 'assignments') { %>
        <p>Заданий пока нет.</p>
      <% } else if (typeFilter === 'quizzes') { %>
        <p>Тестов пока нет.</p>
      <% } else if (totalAll === 0) { %>
        <p>Преподаватель пока не опубликовал ни одной темы.</p>
      <% } %>
    </div>
  <% } else { %>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th class="th-40">#</th>
            <th>Тема</th>
            <th class="th-140">Материал</th>
            <th class="th-200">Задание / Тест</th>
            <th class="th-120"></th>
          </tr>
        </thead>
        <tbody>
        <% topics.forEach((t, idx) => {
          const fileCount = (t.attachments || []).length;
          const hasUrl = !!t.content_url;
          const hasMaterials = fileCount > 0 || hasUrl;
          const qz = t.quiz || null;

          let actionHref = `/t/${subject.teacher_id}/subjects/${subject.id}/topics/${t.id}`;
          let actionLabel = 'Открыть';
          if (qz) {
            actionHref = qz.url;
            if (qz.inProgressId) actionLabel = 'Продолжить';
            else if (qz.canStart) actionLabel = qz.used > 0 ? 'Заново' : 'Пройти';
            else actionLabel = 'Открыть';
          }
        %>
          <tr>
            <td class="cell-secondary"><%= idx + 1 %></td>
            <td>
              <strong><%= t.title %></strong>
              <% if (qz) { %>
                <span class="status-badge status-info" title="Тестирование">🧪 Тест</span>
              <% } %>
              <% if (t.status === 'finished') { %>
                <span class="status-badge status-muted" title="Тема завершена">📦 завершено</span>
              <% } %>
              <% if (t.description) { %>
                <% const plain = String(t.description).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim(); %>
                <div class="cell-secondary"><%= plain.slice(0, 120) %><%= plain.length > 120 ? '…' : '' %></div>
              <% } %>
            </td>
            <td class="cell-secondary">
              <% if (hasMaterials) { %>
                <% if (fileCount > 0) { %>
                  <span title="<%= fileCount %> <%= fileCount === 1 ? 'файл' : 'файлов' %>">📎 <%= fileCount %></span>
                <% } %>
                <% if (fileCount > 0 && hasUrl) { %><span> · </span><% } %>
                <% if (hasUrl) { %><span title="Внешняя ссылка">🔗 ссылка</span><% } %>
              <% } else { %>
                —
              <% } %>
            </td>
            <td class="cell-secondary">
              <% if (qz) { %>
                <div><%= t.quiz_title || t.title %></div>
                <div class="cell-secondary">
                  Попытки: <%= qz.used %> / <%= qz.unlimited ? '∞' : qz.total %>
                  <% if (t.quiz_time_limit_minutes) { %> · <%= t.quiz_time_limit_minutes %> мин<% } %>
                </div>
                <% if (qz.inProgressId) { %>
                  <span class="status-badge status-pending">в процессе</span>
                <% } else if (qz.percent != null) { %>
                  <span class="status-badge <%= qz.passed ? 'status-accepted' : 'status-rejected' %>">
                    <%= qz.passed ? 'сдал' : 'не сдал' %> · <%= qz.percent %>%
                  </span>
                <% } else if (!qz.canStart && !qz.unlimited && qz.attemptsLeft === 0) { %>
                  <span class="status-badge status-muted">попытки закончились</span>
                <% } else { %>
                  <span class="status-badge status-pending">не пройден</span>
                <% } %>
              <% } else if (t.assignment_id) { %>
                <% if (t.assignment_status === 'finished') { %>
                  <span class="status-badge status-muted" title="Задание завершено">📋 завершено</span>
                <% } else if (t.my_last_status === 'accepted') { %>
                  <span class="status-badge status-accepted">📋 принято</span>
                <% } else if (t.my_last_status === 'rejected') { %>
                  <span class="status-badge status-rejected">📋 отклонено</span>
                <% } else if (t.my_last_status === 'pending') { %>
                  <span class="status-badge status-pending">📋 на проверке</span>
                <% } else { %>
                  <span class="status-badge status-pending">📋 не сдано</span>
                <% } %>
                <% if (t.my_works_count > 1) { %>
                  <div class="cell-secondary mt-1">работ: <%= t.my_works_count %></div>
                <% } %>
              <% } else if (t.homework_text || t.assignment_url) { %>
                <span class="status-badge status-pending">📖 ДЗ</span>
              <% } else { %>—<% } %>
            </td>
            <td>
              <a href="<%= actionHref %>" class="btn btn-primary btn-sm"><%= actionLabel %></a>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
</div>
<%- include('../../layout/footer') %>
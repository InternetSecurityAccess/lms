<%- include('../../layout/header', { title: 'Мои предметы' }) %>
<div class="content-wrapper">
  <%- include('../../shared/page-top', { title: 'Мои предметы' }) %>
  <div class="info-box info-box-blue info-box-how">
    Предметы, привязанные к вашей группе. Внутри — лекции, темы, задания и материалы.
    Если предмета нет — преподаватель ещё не прикрепил его к группе.
    Завершённые предметы доступны в <a href="/my-study">«Всей учёбе»</a> как только для чтения.
  </div>
  <% if (total === 0 && !q) { %>
    <section class="card">
      <div class="empty-state">
        <p>Преподаватели пока не прикрепили к вашей группе ни одного активного предмета.</p>
        <p class="cell-secondary">Обратитесь к преподавателю, если ожидаете материалы.</p>
        <% if (finishedCount > 0) { %>
          <p class="cell-secondary mt-2">
            У вас есть <strong><%= finishedCount %></strong>
            <%= plural(finishedCount, 'завершённый предмет', 'завершённых предмета', 'завершённых предметов') %>.
          </p>
          <a href="/my-study" class="btn btn-primary mt-3">Перейти в «Всю учёбу»</a>
        <% } %>
      </div>
    </section>
  <% } else { %>
    <form method="GET" action="/my-subjects" class="inline-add-form">
      <input type="search" name="q" value="<%= q || '' %>"
        placeholder="Поиск по названию, описанию или ФИО преподавателя"
        maxlength="100" class="search-input">
      <button type="submit" class="btn btn-primary btn-sm">Найти</button>
      <% if (q) { %>
        <a href="/my-subjects" class="btn btn-ghost btn-sm">Сбросить</a>
      <% } %>
    </form>
    <% if (finishedCount > 0) { %>
      <div class="info-box info-box-blue">
        Есть <strong><%= finishedCount %></strong>
        <%= plural(finishedCount, 'завершённый предмет', 'завершённых предмета', 'завершённых предметов') %>
        — их можно посмотреть в <a href="/my-study">«Всей учёбе»</a>.
      </div>
    <% } %>
    <% if (q) { %>
      <div class="info-box info-box-blue">
        Найдено: <strong><%= total %></strong> <%= plural(total, 'предмет', 'предмета', 'предметов') %>
        по запросу «<%= q %>».
      </div>
    <% } else if (total > 0) { %>
      <div class="info-box info-box-blue">
        <strong>Всего активных предметов:</strong> <%= total %> у <%= groups.length %>
        <%= plural(groups.length, 'преподавателя', 'преподавателей', 'преподавателей') %>.
      </div>
    <% } %>
    <% if (total === 0) { %>
      <section class="card">
        <div class="empty-state">
          <p>Ничего не найдено по запросу «<%= q %>».</p>
          <a href="/my-subjects" class="btn btn-secondary mt-3">Сбросить поиск</a>
        </div>
      </section>
    <% } else { %>
      <% groups.forEach((g) => { %>
        <section class="card">
          <div class="card-header">
            <h2><a href="/t/<%= g.teacher_id %>"><%= g.teacher_name %></a></h2>
            <span class="cell-secondary">Предметов: <%= g.subjects.length %></span>
          </div>
          <div class="card-grid">
            <% g.subjects.forEach((s) => { %>
              <a href="/t/<%= g.teacher_id %>/subjects/<%= s.id %>" class="entity-card">
                <div class="entity-card-title"><%= s.title %></div>
                <% if (s.description) { %>
                  <div class="entity-card-subtitle"><%= s.description.slice(0, 100) %><%= s.description.length > 100 ? '…' : '' %></div>
                <% } %>
                <div class="entity-card-stats">
                  <span>Тем: <%= s.topics_count %></span>
                </div>
              </a>
            <% }) %>
          </div>
        </section>
      <% }) %>
    <% } %>
  <% } %>
</div>
<%- include('../../layout/footer') %>
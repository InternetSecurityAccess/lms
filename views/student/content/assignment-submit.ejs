<%- include('../../layout/header', { title: assignment.title }) %>
<%
  const fd = (typeof formData !== 'undefined' && formData) ? formData : {};
  const commentVal = fd.comment !== undefined ? fd.comment : (existing ? (existing.comment || '') : '');
  const urlVal = fd.external_url !== undefined ? fd.external_url : (existing ? (existing.external_url || '') : '');
  const hasExisting = !!(existing && works && works.length > 0);
  const assignmentFiles = assignment.attachments || [];
  const topicFiles = (topic && topic.attachments) || [];
%>
<div class="content-wrapper medium">
  <%- include('../../shared/page-top', {
    title: assignment.title,
    back: { href: '/my-assignments' },
    flashes: [
      ...(typeof error !== 'undefined' && error ? [{ type: 'red', text: `<strong>Не удалось сохранить работу.</strong> ${error}` }] : []),
      ...(justUploaded ? [{ type: 'green', text: 'Работа загружена. Ожидайте проверки.' }] : [])
    ]
  }) %>
  <div class="info-box info-box-blue info-box-how">
    <strong>Первая сдача:</strong> приложите файл или укажите ссылку (одно из двух обязательно).<br>
    <strong>Новая версия:</strong> доступна, пока работа не принята. Файлы и ссылка
    сохраняются, статус сбрасывается на «На проверке» — преподаватель увидит работу заново.<br>
    <strong>Принято:</strong> заменить файлы уже нельзя; уточнения — в переписке по работе
    или в <a href="/support">поддержке</a>.<br>
    <strong>Отклонено:</strong> можно приложить новую версию — старая останется в переписке.
  </div>
  <section class="card">
    <div class="card-header"><h2>Задание</h2></div>
    <div class="info-list">
      <div>
        <strong>Предмет</strong>
        <span><a href="/t/<%= assignment.teacher_id %>/subjects/<%= assignment.subject_id %>"><%= assignment.subject_title %></a></span>
      </div>
      <div><strong>Преподаватель</strong><span><%= assignment.teacher_name %></span></div>
      <% if (assignment.deadline) { %>
        <div><strong>Срок сдачи</strong><span><%= formatDate(assignment.deadline, true) %></span></div>
      <% } %>
      <% if (assignment.description) { %>
        <div><strong>Описание</strong><span class="text-pre"><%= assignment.description %></span></div>
      <% } %>
      <% if (assignmentFiles.length > 0) { %>
        <div>
          <strong>Файлы задания</strong>
          <div>
            <%- include('../../shared/ui/attachments-list', {
              items: assignmentFiles, empty: '—'
            }) %>
          </div>
        </div>
      <% } %>
      <% if (topicFiles.length > 0) { %>
        <div>
          <strong>Материал к заданию</strong>
          <div>
            <%- include('../../shared/ui/attachments-list', {
              items: topicFiles, empty: '—'
            }) %>
          </div>
        </div>
      <% } %>
      <% if (assignment.external_url) { %>
        <div>
          <strong>Ссылка на материалы</strong>
          <a href="<%= assignment.external_url %>" target="_blank" rel="noopener"><%= assignment.external_url %></a>
        </div>
      <% } %>
    </div>
  </section>
  <% if (hasExisting) { %>
    <section class="card">
      <div class="card-header">
        <h2>Ваша работа</h2>
        <%- include('../../shared/ui/status-badge', { status: existing.status }) %>
      </div>
      <div class="info-list">
        <div><strong>Сдано</strong><span><%= formatDate(existing.uploaded_at, true) %></span></div>
        <% if (existing.comment) { %>
          <div><strong>Комментарий</strong><span class="text-pre"><%= existing.comment %></span></div>
        <% } %>
        <% if (existing.external_url) { %>
          <div>
            <strong>Ссылка</strong>
            <a href="<%= existing.external_url %>" target="_blank" rel="noopener"><%= existing.external_url %></a>
          </div>
        <% } %>
        <div>
          <strong>Файлы</strong>
          <div>
            <%- include('../../shared/ui/attachments-list', {
              items: existingFiles || [], empty: '—'
            }) %>
          </div>
        </div>
      </div>
      <div class="actions-row mt-3">
        <a href="/t/<%= assignment.teacher_id %>/works/<%= existing.id %>" class="btn btn-primary">
          Переписка с преподавателем
          <% if (existing.unread_count > 0) { %>
            <span class="unread-badge"><%= existing.unread_count %></span>
          <% } %>
        </a>
      </div>
    </section>
  <% } %>
  <% if (submitBlocked) { %>
    <% if (!hasExisting) { %>
      <div class="info-box info-box-red mt-3">
        <strong>Работа не сдана.</strong> Сдать новую невозможно — задание в архиве.
        Обратитесь к преподавателю.
      </div>
    <% } %>
  <% } else if (hasAccepted) { %>
    <div class="info-box info-box-green mt-3">
      <strong>Работа принята.</strong> Повторная сдача невозможна.
    </div>
  <% } else { %>
    <section class="card">
      <div class="card-header"><h2><%= hasExisting ? 'Новая версия работы' : 'Сдать работу' %></h2></div>
      <% if (hasExisting) { %>
        <div class="info-box info-box-yellow">
          Можно добавить новые файлы, удалить отдельные, изменить ссылку.
          После отправки статус снова станет «На проверке», а преподаватель
          увидит все файлы и сообщения в переписке.
        </div>
      <% } %>
      <form id="submitForm"
            action="/t/<%= assignment.teacher_id %>/assignments/<%= assignment.id %>/submit"
            method="POST" enctype="multipart/form-data">
        <div class="form-grid">
          <% if (hasExisting && existingFiles && existingFiles.length > 0) { %>
            <label class="form-label">Текущие файлы</label>
            <div class="field">
              <%- include('../../shared/ui/attachments-list', {
                items: existingFiles,
                empty: '—',
                removeAction: true
              }) %>
              <div class="hint mt-1">
                Отметьте файлы, которые нужно удалить. Остальные сохранятся.
              </div>
            </div>
          <% } %>
          <label for="submit-files" class="form-label"><%= hasExisting ? 'Добавить файлы' : 'Файлы' %></label>
          <div class="field">
            <input type="file" id="submit-files" name="work" multiple
              accept="<%= ACCEPT_UPLOAD %>"
              data-max-size-mb="<%= MAX_FILE_SIZE_MB %>"
              data-max-files="<%= MAX_FILES_PER_UPLOAD %>">
            <div class="hint">
              <%= HINT_UPLOAD %>
              <% if (hasExisting) { %>Добавятся к текущим.<% } %>
            </div>
          </div>
          <label for="submit-url" class="form-label">Ссылка</label>
          <div class="field">
            <input type="url" id="submit-url" name="external_url" maxlength="1000" value="<%= urlVal %>"
              placeholder="https://disk.yandex.ru/...">
            <div class="hint">
              Необязательно. Если файл большой — загрузите на облако и укажите ссылку.
              <% if (hasExisting && existing.external_url) { %>Очистите поле, чтобы удалить ссылку.<% } %>
            </div>
          </div>
          <label for="submit-comment" class="form-label">Комментарий</label>
          <div class="field">
            <textarea id="submit-comment" name="comment" maxlength="2000" rows="3"
              placeholder="Необязательно"><%= commentVal %></textarea>
          </div>
          <div class="actions">
            <% if (hasExisting) { %>
              <button type="submit"
                class="btn btn-warning"
                data-confirm="Отправить новую версию работы?&#10;Текущая версия сохранится в переписке.&#10;Статус сбросится на «На проверке» — преподаватель увидит работу заново.&#10;Отправить?"
                data-confirm-ok-text="Отправить"
                data-confirm-ok-class="warning">
                Отправить новую версию
              </button>
            <% } else { %>
              <button type="submit" class="btn btn-primary">
                Отправить на проверку
              </button>
            <% } %>
            <a href="/my-assignments" class="btn btn-ghost">Отмена</a>
          </div>
        </div>
      </form>
    </section>
  <% } %>
</div>
<%- include('../../shared/ui/file-viewer') %>
<%- include('../../layout/footer') %>
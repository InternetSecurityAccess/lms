<%- include('../../layout/header', { title: 'Мои задания' }) %>
<%
const basePath = '/my-assignments';
const baseQuery = {
  q: q || '',
  teacher: teacherFilter || '',
  filter: filter || 'all',
  sort: sort || 'deadline'
};
const filters = [
  { key: 'all',      label: `Все (${counts.all})` },
  { key: 'todo',     label: `К сдаче (${counts.todo})` },
  { key: 'overdue',  label: `Просрочено (${counts.overdue})` },
  { key: 'pending',  label: `На проверке (${counts.pending})` },
  { key: 'accepted', label: `Принято (${counts.accepted})` },
  { key: 'rejected', label: `Отклонено (${counts.rejected})` }
].map((f) => ({ ...f, href: buildUrl(basePath, baseQuery, { filter: f.key }), active: filter === f.key }));

const statusLabels = {
  todo:     { label: 'Не сдано',    cls: 'pending' },
  overdue:  { label: 'Просрочено',  cls: 'rejected' },
  pending:  { label: 'На проверке', cls: 'pending' },
  accepted: { label: 'Принято',     cls: 'accepted' },
  rejected: { label: 'Отклонено',   cls: 'rejected' }
};

const titleHtml = 'Мои задания' + (teacher
  ? ` <span class="cell-secondary page-subtitle">— ${teacher.name}</span>`
  : '');

const _quizzes = (typeof quizzes !== 'undefined' && Array.isArray(quizzes)) ? quizzes : [];
%>
<div class="content-wrapper">

<%- include('../../shared/page-top', {
  titleHtml,
  actions: teacher
    ? [{ href: '/my-assignments', label: 'Сбросить преподавателя', class: 'btn-ghost btn-sm' }]
    : []
}) %>

<div class="info-box info-box-blue info-box-how">
  <strong>Текущая учёба.</strong> Активные задания и тесты по вашим предметам.
  Завершённые задания и тесты — в <a href="/my-study">«Всей учёбе»</a>: заходите через предмет → тему.
  <br>Чипы фильтрации ниже относятся только к заданиям.
</div>

<%- include('../../shared/ui/filter-chips', { items: filters }) %>

<form method="GET" action="<%= basePath %>" class="inline-add-form">
  <% if (teacherFilter) { %><input type="hidden" name="teacher" value="<%= teacherFilter %>"><% } %>
  <% if (filter !== 'all') { %><input type="hidden" name="filter" value="<%= filter %>"><% } %>
  <% if (sort !== 'deadline') { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
  <input type="search" name="q" value="<%= q %>" maxlength="100"
         placeholder="Поиск: название, предмет, преподаватель" class="search-input">
  <select name="sort">
    <option value="deadline" <%= sort === 'deadline' ? 'selected' : '' %>>По сроку сдачи</option>
    <option value="teacher" <%= sort === 'teacher' ? 'selected' : '' %>>По преподавателю</option>
    <option value="subject" <%= sort === 'subject' ? 'selected' : '' %>>По предмету</option>
    <option value="created" <%= sort === 'created' ? 'selected' : '' %>>Сначала новые</option>
  </select>
  <button type="submit" class="btn btn-primary btn-sm">Найти</button>
  <% if (q) { %>
    <a href="<%= buildUrl(basePath, baseQuery, { q: '' }) %>" class="btn btn-ghost btn-sm">Сбросить</a>
  <% } %>
</form>

<%# ═══════════ БЛОК «ТЕСТЫ» ═══════════ %>
<% if (_quizzes.length > 0) { %>
<section class="card">
  <div class="card-header">
    <h2>🧪 Тесты (<%= _quizzes.length %>)</h2>
    <span class="cell-secondary">Автоматическая проверка, результат сразу</span>
  </div>
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>Тест</th>
          <th>Предмет</th>
          <th>Преподаватель</th>
          <th class="th-120">Попытки</th>
          <th class="th-160">Лучший балл</th>
          <th class="th-130"></th>
        </tr>
      </thead>
      <tbody>
      <% _quizzes.forEach((t) => {
        const s = t.state;
        let label = 'Пройти';
        if (s.inProgressId) label = 'Продолжить';
        else if (s.readonly || !s.canStart) label = 'Открыть';
        else if (s.used > 0) label = 'Заново';
      %>
        <tr>
          <td>
            <div class="cell-primary"><%= t.quiz_title || t.topic_title %></div>
            <div class="cell-secondary">
              Порог: <%= t.pass_percent %>%
              <% if (t.time_limit_minutes) { %> · <%= t.time_limit_minutes %> мин<% } %>
            </div>
          </td>
          <td class="cell-secondary"><%= t.subject_title %></td>
          <td class="cell-secondary"><a href="/t/<%= t.teacher_id %>"><%= t.teacher_name %></a></td>
          <td class="cell-secondary text-nowrap">
            <%= s.used %> / <%= s.unlimited ? '∞' : s.total %>
          </td>
          <td>
            <% if (s.inProgressId) { %>
              <span class="status-badge status-pending">в процессе</span>
            <% } else if (s.percent != null) { %>
              <div class="cell-primary"><%= s.bestScore %> / <%= s.bestMax %></div>
              <span class="status-badge <%= s.passed ? 'status-accepted' : 'status-rejected' %>">
                <%= s.passed ? 'сдал' : 'не сдал' %> · <%= s.percent %>%
              </span>
            <% } else if (!s.unlimited && s.attemptsLeft === 0) { %>
              <span class="status-badge status-muted">попытки закончились</span>
            <% } else { %>
              <span class="cell-secondary">не пройден</span>
            <% } %>
          </td>
          <td>
            <a href="<%= t.url %>" class="btn btn-primary btn-sm"><%= label %></a>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<%# ═══════════ БЛОК «ЗАДАНИЯ» ═══════════ %>
<% if (assignments.length === 0) { %>
  <%- include('../../shared/ui/empty-state', {
    primary: q ? `Ничего не найдено по запросу «${q}».`
      : filter === 'todo' ? 'Заданий к сдаче нет.'
      : filter === 'overdue' ? 'Просроченных заданий нет.'
      : filter === 'pending' ? 'Нет работ на проверке.'
      : filter === 'accepted' ? 'Нет принятых работ.'
      : filter === 'rejected' ? 'Нет отклонённых работ.'
      : 'Активных заданий пока нет.',
    secondary: !q && filter === 'all'
      ? 'Завершённые задания ищутся через «Всю учёбу» → предмет → тему.'
      : null,
    action: q
      ? { href: buildUrl(basePath, baseQuery, { q: '' }), label: 'Сбросить поиск' }
      : { href: '/my-study', label: 'Вся учёба' }
  }) %>
<% } else { %>
<section class="card">
  <div class="card-header"><h2>📋 Задания (<%= assignments.length %>)</h2></div>
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>Задание</th>
          <th>Предмет</th>
          <th>Преподаватель</th>
          <th class="th-160">Срок сдачи</th>
          <th class="th-130">Статус</th>
          <th class="th-120"></th>
        </tr>
      </thead>
      <tbody>
      <% assignments.forEach((a) => {
        const st = statusLabels[a.computed_status] || statusLabels.todo;
        const buttonLabel = (a.computed_status === 'todo' || a.computed_status === 'overdue') ? 'Сдать' : 'Открыть';
      %>
        <tr>
          <td>
            <div class="cell-primary"><%= a.title %></div>
            <% if (a.description) { %>
              <div class="cell-secondary"><%= a.description.slice(0, 80) %><%= a.description.length > 80 ? '…' : '' %></div>
            <% } %>
          </td>
          <td class="cell-secondary"><%= a.subject_title %></td>
          <td class="cell-secondary"><a href="/t/<%= a.teacher_id %>"><%= a.teacher_name %></a></td>
          <td class="cell-secondary text-nowrap">
            <%= a.deadline ? formatDate(a.deadline, true) : '—' %>
          </td>
          <td>
            <span class="status-badge status-<%= st.cls %>"><%= st.label %></span>
            <% if (a.works_count > 1) { %>
              <div class="cell-secondary mt-1">работ: <%= a.works_count %></div>
            <% } %>
          </td>
          <td>
            <a href="/t/<%= a.teacher_id %>/assignments/<%= a.id %>" class="btn btn-primary btn-sm"><%= buttonLabel %></a>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>
</div>
<%- include('../../layout/footer') %>
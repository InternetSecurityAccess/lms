<%- include('../../layout/header', { title: 'Прохождение теста' }) %>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: topic.quiz_title || topic.topic_title,
    actions: [
      { href: '/my-subjects/' + topic.subject_id + '/topics/' + topic.id + '/quiz', label: '← к описанию', class: 'btn-ghost btn-sm' }
    ]
  }) %>

  <form id="quiz-attempt-form"
        method="post"
        action="/my-subjects/<%= topic.subject_id %>/topics/<%= topic.id %>/quiz/attempt/<%= attempt.id %>/submit">
    <input type="hidden" name="answers_json" value="">

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;gap:16px;flex-wrap:wrap;">
      <div class="quiz-counter">
        Отвечено <strong class="quiz-counter-n">0</strong> из <strong><%= questions.length %></strong>
      </div>
      <% if (timeLimitMinutes > 0) { %>
        <div class="quiz-timer" hidden
             data-limit="<%= timeLimitMinutes %>"
             data-started="<%= attempt.started_at %>">--:--</div>
      <% } %>
    </div>

    <div class="quiz-accordion" id="quiz-questions">
      <% questions.forEach(function (q, i) {
           var allHaveImages = q.options.length > 0
             && q.options.every(function (o) { return !!o.image_stored_name; });
           var useTiles = (q.type !== 'ordering') && allHaveImages;
           var inputType = q.type === 'single' ? 'radio' : (q.type === 'multiple' ? 'checkbox' : '');
      %>
        <div class="quiz-q" data-open="0" data-qid="<%= q.id %>" data-qtype="<%= q.type %>">
          <div class="quiz-q-head">
            <span class="quiz-q-num"><%= i + 1 %>.</span>
            <% if (q.image_stored_name) { %>
              <img src="/file/quiz-image/question/<%= q.id %>" alt=""
                   style="max-height:32px;max-width:80px;border-radius:4px;flex:0 0 auto;">
            <% } %>
            <span class="quiz-q-preview"><%= q.text || '(без текста)' %></span>
            <span class="quiz-q-status">не отвечен</span>
          </div>
          <div class="quiz-q-body" hidden>
            <% if (q.text) { %>
              <div style="font-weight:600;font-size:15px;color:#1e293b;"><%= q.text %></div>
            <% } %>
            <% if (q.image_stored_name) { %>
              <div style="margin:10px 0 12px;">
                <img src="/file/quiz-image/question/<%= q.id %>" alt=""
                     style="max-height:320px;max-width:100%;border-radius:6px;">
              </div>
            <% } %>

            <% if (q.type === 'single' || q.type === 'multiple') { %>
              <% if (useTiles) { %>
                <div class="quiz-tile-grid">
                  <% q.options.forEach(function (o) { %>
                    <label class="quiz-tile">
                      <input type="<%= inputType %>" name="q_<%= q.id %>"
                             data-oid="<%= o.id %>" value="<%= o.id %>">
                      <% if (o.image_stored_name) { %>
                        <img src="/file/quiz-image/option/<%= o.id %>" alt="">
                      <% } %>
                      <% if (o.text) { %>
                        <span class="quiz-tile-label"><%= o.text %></span>
                      <% } %>
                    </label>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="quiz-row-list">
                  <% q.options.forEach(function (o) { %>
                    <label class="quiz-row">
                      <input type="<%= inputType %>" name="q_<%= q.id %>"
                             data-oid="<%= o.id %>" value="<%= o.id %>">
                      <% if (o.image_stored_name) { %>
                        <img src="/file/quiz-image/option/<%= o.id %>" alt=""
                             style="max-height:44px;border-radius:4px;">
                      <% } %>
                      <span class="quiz-row-label"><%= o.text || '' %></span>
                    </label>
                  <% }); %>
                </div>
              <% } %>
            <% } else if (q.type === 'ordering') { %>
              <div class="cell-secondary" style="font-size:12px;margin-bottom:6px;">
                Расставьте элементы в правильном порядке кнопками ↑↓.
              </div>
              <div class="quiz-ordering">
                <% q.options.forEach(function (o, idx) { %>
                  <div class="quiz-ordering-item" data-oid="<%= o.id %>">
                    <span class="quiz-ordering-num"><%= idx + 1 %></span>
                    <% if (o.image_stored_name) { %>
                      <img src="/file/quiz-image/option/<%= o.id %>" alt="">
                    <% } %>
                    <span class="quiz-ordering-label"><%= o.text || '' %></span>
                    <div class="quiz-ordering-actions">
                      <button type="button" data-action="up"
                              <%= idx === 0 ? 'disabled' : '' %>>↑</button>
                      <button type="button" data-action="down"
                              <%= idx === q.options.length - 1 ? 'disabled' : '' %>>↓</button>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>

    <div style="margin-top:20px;text-align:right;">
      <button type="button" class="btn btn-primary" data-action="finish">Завершить тест</button>
    </div>
  </form>
</div>

<div id="quiz-confirm-dialog" class="quiz-modal-backdrop" hidden>
  <div class="quiz-modal" style="max-width:420px;">
    <h3>Завершить тест?</h3>
    <p id="quiz-confirm-text"></p>
    <div class="quiz-modal-actions">
      <button type="button" class="btn" data-action="cancel">Отмена</button>
      <button type="button" class="btn btn-primary" data-action="confirm">Завершить</button>
    </div>
  </div>
</div>

<link rel="stylesheet" href="/css/quiz.css">
<script src="/js/quiz-attempt.js" defer></script>
<%- include('../../layout/footer') %>
<%- include('../../layout/header', { title: submission.topic }) %>
<%
  const isAccepted = submission.status === 'accepted';
  const isAiFlagged = !!submission.ai_flag;
  const isReadonly = !!submission.readonly;
  const assignmentFinished = submission.assignment_status === 'finished';
  const chatLocked = isAccepted || isReadonly;
  const canResubmit = !chatLocked
    && submission.assignment_id
    && submission.assignment_status === 'active';
  const assignmentHref = submission.assignment_id
    ? ((isReadonly || assignmentFinished)
        ? `/t/${submission.teacher_id}/assignments/${submission.assignment_id}/archive`
        : `/t/${submission.teacher_id}/assignments/${submission.assignment_id}`)
    : null;
  const assignmentLabel = (isReadonly || assignmentFinished)
    ? 'К заданию (архив)'
    : 'К заданию';
%>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: submission.topic,
    actions: [
      canResubmit
        ? { href: `/t/${submission.teacher_id}/assignments/${submission.assignment_id}`, label: 'Сдать заново', class: 'btn-warning' }
        : null,
      assignmentHref
        ? { href: assignmentHref, label: assignmentLabel, class: 'btn-secondary' }
        : null,
      { href: `/t/${submission.teacher_id}`, label: 'К работам' }
    ].filter(Boolean),
    flashes: [
      ...(justUploaded ? [{ type: 'green', text: 'Работа загружена. Ожидайте проверки.' }] : []),
      ...(justReplaced ? [{ type: 'green', text: 'Новая версия работы загружена.' }] : []),
      ...(query && query.accepted === '1' ? [{ type: 'red', text: '<strong>Работа принята.</strong> Замена файла недоступна.' }] : [])
    ]
  }) %>
  <% if (isReadonly) { %>
    <div class="info-box info-box-yellow info-box-how">
      <strong>Только для чтения.</strong>
      <% if (assignmentFinished) { %>
        Задание завершено преподавателем.
      <% } else { %>
        Предмет, преподаватель или группа завершены.
      <% } %>
      Переписка и файлы доступны, но новые сообщения и сдачи недоступны.
      Полная история — в <a href="/my-study">«Всей учёбе»</a>.
    </div>
  <% } %>
  <div class="info-box info-box-blue info-box-how">
    Это ваша работа у <%= submission.teacher_name %>.
    Здесь видно статус, файлы и переписку.
  </div>
  <section class="card">
    <div class="card-header">
      <h2>Работа</h2>
      <div class="actions-row">
        <% if (isAiFlagged) { %>
          <span class="status-badge status-flag" title="Преподаватель отметил работу как сделанную с помощью ИИ">🤖 Сделано с ИИ</span>
        <% } %>
        <%- include('../../shared/ui/status-badge', { status: submission.status }) %>
        <% if (assignmentFinished) { %>
          <span class="status-badge status-muted" title="Задание завершено">📋 задание завершено</span>
        <% } %>
      </div>
    </div>
    <% if (isAiFlagged) { %>
      <div class="info-box info-box-yellow">
        <strong>Преподаватель отметил эту работу как «Сделано с ИИ».</strong>
        Это не меняет статус, но преподаватель видит метку и учитывает её при проверке.
      </div>
    <% } %>
    <div class="info-list">
      <div>
        <strong>Предмет</strong>
        <span>
          <% if (submission.subject_title) { %>
            <a href="/t/<%= submission.teacher_id %>/subjects/<%= submission.subject_id %>"><%= submission.subject_title %></a>
          <% } else { %><span class="cell-secondary">—</span><% } %>
        </span>
      </div>
      <div><strong>Тема</strong><span><%= submission.topic %></span></div>
      <div><strong>Задание</strong><span><%= submission.assignment_title || '—' %></span></div>
      <% if (submission.external_url) { %>
        <div>
          <strong>Ссылка</strong>
          <a href="<%= submission.external_url %>" target="_blank" rel="noopener"><%= submission.external_url %></a>
        </div>
      <% } %>
      <div>
        <strong>Файлы</strong>
        <div>
          <%- include('../../shared/ui/attachments-list', {
            items: attachments || [], empty: '—'
          }) %>
        </div>
      </div>
      <div><strong>Загружено</strong><span><%= formatDate(submission.uploaded_at, true) %></span></div>
      <% if (submission.comment) { %>
        <div><strong>Комментарий</strong><span class="text-pre"><%= submission.comment %></span></div>
      <% } %>
    </div>
    <% if (isAccepted) { %>
      <div class="info-box info-box-green mt-3">
        <strong>Работа принята.</strong> Действия по работе завершены.
        Писать сообщения и прикреплять файлы нельзя.
      </div>
    <% } else if (isReadonly) { %>
      <div class="info-box info-box-yellow mt-3">
        <strong>Работа в архиве.</strong>
        <% if (assignmentFinished) { %>
          Задание завершено преподавателем — переписка и файлы доступны,
          но новые сообщения и сдачи недоступны.
        <% } else { %>
          Предмет или преподаватель завершены — переписка и файлы доступны,
          но новые сообщения и сдачи недоступны.
        <% } %>
      </div>
    <% } %>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Переписка с преподавателем</h2>
      <div class="chat-meta">
        <span>Сообщений: <strong id="messageCount"><%= messages.length %></strong></span>
        <span id="lastUpdateTime"></span>
      </div>
    </div>
    <div class="chat-toolbar gap-2 items-center flex-wrap">
      <form method="GET" action="<%= basePath %>" class="inline-add-form search-input-240 m-0">
        <input type="search" name="q" value="<%= q || '' %>" maxlength="200" placeholder="Поиск по сообщениям" class="search-input-180">
        <button type="submit" class="btn btn-primary btn-sm">Найти</button>
        <% if (q) { %><a href="<%= basePath %>" class="btn btn-ghost btn-sm">Сбросить</a><% } %>
      </form>
      <button type="button" class="btn btn-secondary btn-sm" id="refreshBtn" >
        <span class="spinner"></span> ↻ Обновить
      </button>
    </div>
    <div id="messages" class="messages-list" aria-live="polite">
      <% if (messages.length === 0) { %>
        <%- include('../../shared/ui/empty-state', { primary: q ? 'Ничего не найдено.' : 'Сообщений пока нет.', wrapper: false }) %>
      <% } else { %>
        <% messages.forEach((m) => { %>
          <%- include('../../shared/chat/message', {
            m,
            viewerRole: 'student',
            viewerId: session.studentId,
            deleteAction: chatLocked ? null : `${basePath}/messages/${m.id}/delete`
          }) %>
        <% }) %>
      <% } %>
    </div>
    <% if (isAccepted) { %>
      <div class="info-box info-box-green mt-3">
        <strong>Работа принята.</strong> Переписка закрыта, новые сообщения и файлы не принимаются.
        Если нужно что-то уточнить, обратитесь в <a href="/support">поддержку</a>.
      </div>
    <% } else if (isReadonly) { %>
      <div class="info-box info-box-yellow mt-3">
        <strong>Только для чтения.</strong>
        <% if (assignmentFinished) { %>
          Задание завершено преподавателем. Новые сообщения и файлы не принимаются.
        <% } else { %>
          Предмет или преподаватель завершены. Новые сообщения и файлы не принимаются.
        <% } %>
        Существующая переписка сохранена.
      </div>
    <% } else { %>
      <%- include('../../shared/chat/form', {
        action: `${basePath}/messages`,
        placeholder: 'Введите сообщение'
      }) %>
    <% } %>
  </section>
</div>
<div id="newMessagesToast" class="toast"></div>
<script>
  window.submissionId = <%= JSON.stringify(submission.id) %>;
  window.userRole = 'student';
  window.userId = <%= JSON.stringify(session.studentId) %>;
  window.baseUrl = '<%= basePath %>';
</script>
<script src="/js/chat.js" defer></script>
<%- include('../../shared/ui/file-viewer') %>
<%- include('../../layout/footer') %>
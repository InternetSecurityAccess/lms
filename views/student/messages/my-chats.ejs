<%- include('../../layout/header', { title: 'Групповые чаты' }) %>
<div class="content-wrapper">
  <%- include('../../shared/page-top', { title: 'Групповые чаты' }) %>
  <% if (!hasGroup) { %>
    <section class="card">
      <div class="empty-state">
        <p>Вы не привязаны ни к одной группе.</p>
        <p class="cell-secondary">Обратитесь к администратору, чтобы вас добавили в группу.</p>
      </div>
    </section>
  <% } else { %>
    <div class="info-box info-box-blue info-box-how">
      Ваша группа «<%= group.name %>».
      Здесь можно переписываться с преподавателями, которые ведут вашу группу.
      У каждого преподавателя свой чат.
    </div>
    <% if (threads.length === 0 && !q) { %>
      <section class="card">
        <div class="empty-state">
          <p>Пока ни один преподаватель не ведёт вашу группу.</p>
          <p class="cell-secondary">Как только кто-то из преподавателей отметит «Моя группа», он появится здесь.</p>
        </div>
      </section>
    <% } else { %>
      <form method="GET" action="/my-chats" class="inline-add-form mb-2">
        <input type="search" name="q" value="<%= q %>" maxlength="100"
          placeholder="Поиск по имени преподавателя" class="search-input">
        <button type="submit" class="btn btn-primary btn-sm">Найти</button>
        <% if (q) { %>
          <a href="/my-chats" class="btn btn-ghost btn-sm">Сбросить</a>
        <% } %>
      </form>
      <% if (q) { %>
        <div class="info-box info-box-blue">
          По запросу «<strong><%= q %></strong>» найдено: <strong><%= threads.length %></strong>.
        </div>
      <% } %>
      <section class="card">
        <div class="card-header">
          <h2>Преподаватели группы (<%= threads.length %>)</h2>
        </div>
        <% if (threads.length === 0) { %>
          <div class="empty-state">
            <% if (q) { %>
              <p>Ничего не найдено по запросу «<%= q %>».</p>
              <a href="/my-chats" class="btn btn-secondary mt-3">Сбросить поиск</a>
            <% } %>
          </div>
        <% } else { %>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Преподаватель</th>
                  <th>Последнее сообщение</th>
                  <th class="th-130">Непрочитанных</th>
                  <th class="th-160">Когда</th>
                  <th class="th-140"></th>
                </tr>
              </thead>
              <tbody>
                <% threads.forEach((t) => { %>
                  <tr>
                    <td>
                      <div class="cell-primary"><%= t.teacher_name %></div>
                    </td>
                    <td>
                      <% if (t.last_message) { %>
                        <div class="cell-secondary">
                          <strong><%= t.last_sender_name || (t.last_sender_type === 'teacher' ? 'Преподаватель' : 'Студент') %>:</strong>
                          <%= t.last_message.slice(0, 80) %><%= t.last_message.length > 80 ? '…' : '' %>
                        </div>
                      <% } else { %>
                        <span class="cell-secondary">—</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (t.unread_count > 0) { %>
                        <span class="unread-badge"><%= t.unread_count %></span>
                      <% } else { %>
                        <span class="cell-secondary">—</span>
                      <% } %>
                    </td>
                    <td class="cell-secondary text-nowrap">
                      <%= t.last_message_at ? formatDate(t.last_message_at, true) : '—' %>
                    </td>
                    <td>
                      <a href="/my-chats/<%= group.id %>/t/<%= t.teacher_id %>"
                         class="btn btn-primary btn-sm">Открыть чат</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>
  <% } %>
</div>
<%- include('../../layout/footer') %>
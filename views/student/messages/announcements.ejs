<%- include('../../layout/header', { title: 'Объявления' }) %>
<div class="content-wrapper">
  <%- include('../../shared/page-top', { title: 'Объявления' }) %>
  <div class="info-box info-box-blue info-box-how">
    Объявления от преподавателей вашей группы. Прочитанные помечаются
    автоматически, как только вы открыли страницу. Отвечать здесь нельзя —
    это не чат. Задать вопрос можно в «Групповых чатах».
  </div>
  <% if (announcements.length === 0) { %>
    <section class="card">
      <div class="empty-state">
        <p>Объявлений пока нет.</p>
        <p class="cell-secondary">Здесь появятся сообщения от преподавателей вашей группы.</p>
      </div>
    </section>
  <% } else { %>
    <% announcements.forEach((a) => { %>
      <article class="card mb-3">
        <div class="card-header">
          <h2><% if (a.pinned) { %>📌 <% } %><%= a.title %></h2>
          <span class="cell-secondary">
            <%= a.teacher_name %> · <%= formatDate(a.created_at, true) %>
          </span>
        </div>
        <% if (a.content) { %>
          <div class="message-text text-pre"><%= a.content %></div>
        <% } %>
      </article>
    <% }) %>
  <% } %>
</div>
<%- include('../../layout/footer') %>
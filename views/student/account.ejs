<%- include('../layout/header', { title: 'Профиль' }) %>
<div class="content-wrapper narrow">
  <%- include('../shared/page-top', { title: 'Профиль' }) %>
  <div class="info-box info-box-blue info-box-how">
    Здесь ваши данные и смена пароля. Роль и группу меняет только администратор.
    Пароль — вы сами: минимум 8 символов, отличается от текущего.
  </div>
  <section class="card">
    <div class="card-header"><h2>Мои данные</h2></div>
    <div class="info-list">
      <div>
        <strong>Роль</strong>
        <span><span class="status-badge status-info">Студент</span></span>
      </div>
      <div>
        <strong>ФИО</strong>
        <span><%= me.name %></span>
      </div>
      <div>
        <strong>Группа</strong>
        <span>
          <% if (me.group_name) { %>
            <%= me.group_name %>
            <% if (me.group_status === 'finished') { %>
              <span class="status-badge status-muted">завершена</span>
            <% } %>
          <% } else { %>
            <span class="cell-secondary">—</span>
          <% } %>
        </span>
      </div>
      <div>
        <strong>Логин</strong>
        <span><code class="user-select-all"><%= me.login %></code></span>
      </div>
      <div>
        <strong>Статус</strong>
        <span>
          <% if (me.status === 'finished') { %>
            <span class="status-badge status-muted">выпускник</span>
          <% } else if (me.status === 'rejected') { %>
            <span class="status-badge status-rejected">отклонён</span>
          <% } else { %>
            <span class="status-badge status-success">активен</span>
          <% } %>
        </span>
      </div>
    </div>
    <div class="info-box info-box-blue mt-3">
      <strong>Логин для входа.</strong>
      <%= studentLoginType === 'email' ? 'Email, указанный при регистрации.' : 'Номер студенческого билета.' %>
      Меняется только администратором.
    </div>
  </section>
  <section class="card">
    <div class="card-header"><h2>Смена пароля</h2></div>
    <% if (error) { %><div class="info-box info-box-red"><%= error %></div><% } %>
    <% if (success) { %><div class="info-box info-box-green"><%= success %></div><% } %>
    <form action="/my-profile/change-password" method="POST">
      <div class="form-grid">
        <label for="old-pass" class="form-label">Текущий пароль</label>
        <div class="field">
          <input type="password" id="old-pass" name="old_password" required maxlength="200" autocomplete="current-password">
        </div>
        <label for="new-pass" class="form-label">Новый пароль</label>
        <div class="field">
          <input type="password" id="new-pass" name="new_password" required
            minlength="<%= passwordRequirements[0]?.text.match(/\d+/)?.[0] || 8 %>"
            maxlength="200" autocomplete="new-password">
          <div class="hint">
            <div>Требования к паролю:</div>
            <ul class="hint-list">
              <% passwordRequirements.forEach((r) => { %><li><%= r.text %></li><% }) %>
            </ul>
          </div>
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-success">Сохранить</button>
        </div>
      </div>
    </form>
  </section>
</div>
<%- include('../layout/footer') %>
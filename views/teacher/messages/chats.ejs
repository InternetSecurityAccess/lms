<%- include('../../layout/header', { title: 'Групповые чаты' }) %>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: 'Групповые чаты',
    actions: [{ href: '/my-groups', label: 'Мои группы', class: 'btn-secondary' }]
  }) %>
  <div class="info-box info-box-blue info-box-how">
    Здесь чаты с группами, которые вы ведёте.
    У каждого преподавателя свой чат с группой, другие преподаватели переписку не видят.
  </div>
  <% if (chats.length === 0) { %>
    <section class="card">
      <div class="empty-state">
        <p>Вы пока не ведёте ни одной группы.</p>
        <p class="cell-secondary">
          Отметьте «Моя группа» в <a href="/groups">списке групп</a> —
          после этого чат с группой появится здесь.
        </p>
        <a href="/groups" class="btn btn-primary mt-3">Перейти к группам</a>
      </div>
    </section>
  <% } else { %>
    <form method="GET" action="/my-group-chats" class="inline-add-form">
      <input type="search" name="q" value="<%= q %>" maxlength="100"
        placeholder="Поиск по названию группы" class="search-input">
      <button type="submit" class="btn btn-primary btn-sm">Найти</button>
      <% if (q) { %><a href="/my-group-chats" class="btn btn-ghost btn-sm">Сбросить</a><% } %>
    </form>
    <section class="card">
      <div class="card-header">
        <h2>Чаты групп (<%= chats.length %>)</h2>
        <% if (totalUnread > 0) { %>
          <span class="status-badge status-warning">непрочитанных: <%= totalUnread %></span>
        <% } %>
      </div>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Группа</th>
              <th class="th-100">Студентов</th>
              <th>Последнее сообщение</th>
              <th class="th-130">Непрочитанных</th>
              <th class="th-160">Когда</th>
              <th class="th-140"></th>
            </tr>
          </thead>
          <tbody>
            <% chats.forEach((c) => { %>
              <tr>
                <td>
                  <div class="cell-primary"><%= c.group_name %></div>
                  <div class="cell-secondary">
                    <a href="/g/<%= c.group_id %>" class="text-muted">К группе →</a>
                  </div>
                </td>
                <td class="cell-secondary"><%= c.students_count %></td>
                <td>
                  <% if (c.last_message) { %>
                    <div class="cell-secondary">
                      <strong><%= c.last_sender_name || (c.last_sender_type === 'teacher' ? 'Вы' : 'Студент') %>:</strong>
                      <%= c.last_message.slice(0, 80) %><%= c.last_message.length > 80 ? '…' : '' %>
                    </div>
                  <% } else { %>
                    <span class="cell-secondary">— нет сообщений —</span>
                  <% } %>
                </td>
                <td>
                  <% if (c.unread_count > 0) { %>
                    <span class="unread-badge"><%= c.unread_count %></span>
                  <% } else { %>
                    <span class="cell-secondary">—</span>
                  <% } %>
                </td>
                <td class="cell-secondary text-nowrap">
                  <%= c.last_message_at ? formatDate(c.last_message_at, true) : '—' %>
                </td>
                <td>
                  <a href="/g/<%= c.group_id %>/chat" class="btn btn-primary btn-sm">
                    Открыть чат
                    <% if (c.unread_count > 0) { %>
                      <span class="unread-badge"><%= c.unread_count %></span>
                    <% } %>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>
</div>
<%- include('../../layout/footer') %>
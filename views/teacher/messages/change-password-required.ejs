<%- include('../../layout/header', { title: 'Смена пароля' }) %>
<div class="content-wrapper narrow">
  <div class="top-bar">
    <h1 class="top-bar-title">Требуется смена пароля</h1>
  </div>
  <section class="card">
    <div class="info-box info-box-yellow">
      <strong>Ваш пароль был сброшен администратором.</strong>
      Для продолжения работы задайте новый пароль. Пока вы этого не сделаете,
      остальные разделы системы недоступны.
    </div>
    <% if (error) { %>
      <div class="info-box info-box-red" role="alert"><%= error %></div>
    <% } %>
    <form action="/change-password-required" method="POST">
      <div class="form-grid">
        <label for="new-pass" class="form-label">Новый пароль</label>
        <div class="field">
          <input type="password" id="new-pass" name="new_password"
            required
            minlength="<%= passwordRequirements[0]?.text.match(/\d+/)?.[0] || 8 %>"
            maxlength="200"
            autocomplete="new-password" autofocus>
          <div class="hint">
            <div>Требования к паролю:</div>
            <ul class="hint-list">
              <% passwordRequirements.forEach((r) => { %><li><%= r.text %></li><% }) %>
            </ul>
          </div>
        </div>
        <label for="confirm-pass" class="form-label">Повторите пароль</label>
        <div class="field">
          <input type="password" id="confirm-pass" name="confirm_password"
            required
            minlength="<%= passwordRequirements[0]?.text.match(/\d+/)?.[0] || 8 %>"
            maxlength="200"
            autocomplete="new-password">
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-success">Сохранить и продолжить</button>
        </div>
      </div>
    </form>
  </section>
</div>
<%- include('../../layout/footer') %>
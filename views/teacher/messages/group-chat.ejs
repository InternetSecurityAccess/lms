<%- include('../../layout/header', { title: 'Групповой чат: ' + group.name }) %>
<%
  const flashes = [];
  if (typeof cleared !== 'undefined' && cleared) flashes.push({ type: 'yellow', text: 'Чат очищен.' });
  if (deletedMsgId) flashes.push({ type: 'yellow', text: 'Сообщение удалено.' });
%>
<div class="content-wrapper">
  <div class="workspace-bar">
    <div>
      <h1 class="top-bar-title">
        <%= group.name %>
        <span class="page-subtitle">· Групповой чат</span>
      </h1>
    </div>
    <% if (messages.length > 0) { %>
      <div class="actions-row">
        <form method="POST" action="<%= basePath %>/clear" class="inline-form"
          data-confirm="Очистить весь чат? Все сообщения и вложения будут удалены. Необратимо."
          data-confirm-ok-text="Очистить"
          data-confirm-ok-class="danger">
          <button type="submit" class="btn btn-danger btn-sm">🗑 Очистить</button>
        </form>
      </div>
    <% } %>
  </div>
  <div class="tabs">
    <a href="/g/<%= group.id %>?tab=subjects" class="tab">Предметы</a>
    <a href="/g/<%= group.id %>?tab=students" class="tab">Студенты</a>
    <a href="<%= basePath %>" class="tab active">💬 Чат</a>
  </div>
  <% flashes.forEach((f) => { %>
    <div class="info-box info-box-<%= f.type %>" role="status"><%= f.text %></div>
  <% }) %>
  <div class="info-box info-box-blue info-box-how">
    Это ваш личный чат с этой группой.
    Видят все студенты группы и только вы из преподавателей.
  </div>
  <section class="card">
    <div class="card-header">
      <h2>Переписка</h2>
      <div class="chat-meta">
        <span>Сообщений: <strong id="messageCount"><%= messages.length %></strong></span>
        <span id="lastUpdateTime"></span>
      </div>
    </div>
    <div class="chat-toolbar gap-2 items-center flex-wrap">
      <form method="GET" action="<%= basePath %>" class="inline-add-form search-input-240 m-0">
        <input type="search" name="q" value="<%= q %>" maxlength="200"
               placeholder="Поиск по сообщениям" class="search-input-180">
        <button type="submit" class="btn btn-primary btn-sm">Найти</button>
        <% if (q) { %>
          <a href="<%= basePath %>" class="btn btn-ghost btn-sm">Сбросить</a>
        <% } %>
      </form>
      <button type="button" class="btn btn-secondary btn-sm" id="refreshBtn" >
        <span class="spinner"></span> ↻ Обновить
      </button>
    </div>
    <% if (q) { %>
      <div class="info-box info-box-blue">
        Найдено: <strong><%= messages.length %></strong> по запросу «<%= q %>».
      </div>
    <% } %>
    <div id="messages" class="messages-list" aria-live="polite">
      <% if (messages.length === 0) { %>
        <%- include('../../shared/ui/empty-state', {
          primary: q ? 'Ничего не найдено.' : 'Сообщений пока нет. Напишите первым.',
          wrapper: false
        }) %>
      <% } else { %>
        <% messages.forEach((m) => { %>
          <%- include('../../shared/chat/message', {
            m,
            viewerRole: 'teacher',
            viewerId: session.teacherId,
            canDeleteAll: true,
            deleteAction: `${basePath}/messages/${m.id}/delete`
          }) %>
        <% }) %>
      <% } %>
    </div>
    <%- include('../../shared/chat/form', {
      action: `${basePath}/messages`,
      placeholder: 'Напишите группе'
    }) %>
  </section>
</div>
<div id="newMessagesToast" class="toast"></div>
<script>
  window.baseUrl = '<%= basePath %>';
  window.userRole = 'teacher';
  window.userId = <%= JSON.stringify(session.teacherId) %>;
</script>
<script src="/js/chat.js" defer></script>
<%- include('../../shared/ui/file-viewer') %>
<%- include('../../layout/footer') %>
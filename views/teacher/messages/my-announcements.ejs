<%- include('../../layout/header', { title: 'Объявления' }) %>
<div class="content-wrapper">
  <%- include('../../shared/page-top', { title: 'Объявления' }) %>
  <div class="info-box info-box-blue info-box-how">
    Выберите группу, чтобы опубликовать объявление или посмотреть существующие.
    <strong>Здесь учитываются только ваши объявления.</strong>
    Студенты видят также объявления других преподавателей группы,
    но вам они не показываются — это личный канал каждого преподавателя.
  </div>
  <% if (groups.length === 0) { %>
    <section class="card">
      <div class="empty-state">
        <p>Вы не ведёте ни одной группы.</p>
        <a href="/groups" class="btn btn-primary mt-md">Перейти к группам</a>
      </div>
    </section>
  <% } else { %>
    <div class="card-grid">
      <% groups.forEach((g) => { %>
        <a href="/g/<%= g.id %>/announcements" class="entity-card">
          <div class="entity-card-title"><%= g.name %></div>
          <div class="entity-card-stats">
            <span>Моих объявлений: <%= g.announcements_count %></span>
            <span>Студентов: <%= g.students_count %></span>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../../layout/footer') %>
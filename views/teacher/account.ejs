<%- include('../layout/header', { title: 'Профиль' }) %>
<%
  const mErr = (typeof maxError !== 'undefined' && maxError) ? maxError : null;
  const mOk  = (typeof maxSuccess !== 'undefined' && maxSuccess) ? maxSuccess : null;
%>
<div class="content-wrapper narrow">
  <%- include('../shared/page-top', { title: 'Профиль' }) %>
  <div class="info-box info-box-blue info-box-how">
    Здесь меняются ФИО (только через администратора), пароль и ссылка на канал MAX.
    Смена пароля <strong>завершает все остальные ваши сессии</strong> — на других
    устройствах потребуется войти заново.
  </div>
  <section class="card">
    <div class="card-header"><h2>Мои данные</h2></div>
    <div class="info-list">
      <div>
        <strong>Роль</strong>
        <span><span class="status-badge status-warning">Преподаватель</span></span>
      </div>
      <div>
        <strong>ФИО</strong>
        <span><%= me.name %></span>
      </div>
      <div>
        <strong>Логин (email)</strong>
        <span><code class="user-select-all"><%= me.login %></code></span>
      </div>
      <div>
        <strong>Статус</strong>
        <span>
          <% if (me.status === 'finished') { %>
            <span class="status-badge status-muted">завершён</span>
          <% } else { %>
            <span class="status-badge status-success">активен</span>
          <% } %>
        </span>
      </div>
    </div>
    <div class="info-box info-box-blue mt-3">
      <strong>Логин для входа.</strong> Email, по которому вы входите в систему.
      Меняется только администратором.
    </div>
  </section>
  <section class="card">
    <div class="card-header"><h2>Канал MAX</h2></div>
    <% if (mErr) { %><div class="info-box info-box-red" role="alert"><%= mErr %></div><% } %>
    <% if (mOk) { %><div class="info-box info-box-green" role="status"><%= mOk %></div><% } %>
    <div class="info-box info-box-blue info-box-how">
      Укажите ссылку на ваш публичный канал в мессенджере MAX.
      Студенты увидят её на вашей карточке в разделе «Мои преподаватели» и на странице предмета.
    </div>
    <form action="/my-profile/update-max" method="POST" autocomplete="off">
      <div class="form-grid">
        <label for="max-url" class="form-label">Ссылка на канал</label>
        <div class="field">
          <input type="url" id="max-url" name="max_url" maxlength="500"
            value="<%= me.max_url || '' %>"
            placeholder="https://max.ru/your_channel">
          <div class="hint">
            Только ссылки вида <code>https://max.ru/...</code>.
            Очистите поле и сохраните, чтобы убрать ссылку.
          </div>
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-success">Сохранить</button>
          <% if (me.max_url) { %>
            <a href="<%= me.max_url %>" target="_blank" rel="noopener noreferrer"
               class="btn btn-secondary">Открыть канал ↗</a>
          <% } %>
        </div>
      </div>
    </form>
  </section>
  <section class="card">
    <div class="card-header"><h2>Смена пароля</h2></div>
    <% if (error) { %><div class="info-box info-box-red"><%= error %></div><% } %>
    <% if (success) { %><div class="info-box info-box-green"><%= success %></div><% } %>
    <form action="/my-profile/change-password" method="POST">
      <div class="form-grid">
        <label for="old-pass" class="form-label">Текущий пароль</label>
        <div class="field">
          <input type="password" id="old-pass" name="old_password" required maxlength="200" autocomplete="current-password">
        </div>
        <label for="new-pass" class="form-label">Новый пароль</label>
        <div class="field">
          <input type="password" id="new-pass" name="new_password" required
            minlength="<%= passwordRequirements[0]?.text.match(/\d+/)?.[0] || 8 %>"
            maxlength="200" autocomplete="new-password">
          <div class="hint">
            <div>Требования к паролю:</div>
            <ul class="hint-list">
              <% passwordRequirements.forEach((r) => { %><li><%= r.text %></li><% }) %>
            </ul>
          </div>
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-success">Сохранить</button>
        </div>
      </div>
    </form>
  </section>
</div>
<%- include('../layout/footer') %>
<%- include('../../layout/header', { title: mode === 'create' ? 'Новый предмет' : 'Редактировать предмет' }) %>
<div class="content-wrapper narrow">
  <%- include('../../shared/page-top', {
    title: mode === 'create' ? 'Новый предмет' : 'Редактировать предмет',
    back: { href: mode === 'edit' ? `/subjects/${subject.id}/topics` : '/subjects' }
  }) %>
  <div class="info-box info-box-blue info-box-how">
    Название видят студенты ваших привязанных групп. Описание — краткое пояснение,
    что изучается. После создания привяжите предмет к группам — иначе студенты его не увидят.
  </div>
  <section class="card">
    <% if (error) { %><div class="info-box info-box-red"><%= error %></div><% } %>
    <form action="<%= mode === 'create' ? '/subjects' : '/subjects/' + subject.id %>" method="POST">
      <div class="form-grid">
        <label for="s-title" class="form-label">Название <span class="required">*</span></label>
        <div class="field">
          <input type="text" id="s-title" name="title" required maxlength="200"
            value="<%= subject.title || '' %>" placeholder="Например: Базы данных">
        </div>
        <label for="s-desc" class="form-label">Описание</label>
        <div class="field">
          <textarea id="s-desc" name="description" maxlength="2000" rows="4"
            placeholder="Краткое описание предмета"><%= subject.description || '' %></textarea>
        </div>
        <% if (mode === 'create' && attachGroupId) { %>
          <input type="hidden" name="attach_group_id" value="<%= attachGroupId %>">
          <div class="info-box info-box-blue" style="grid-column: 1 / -1;">
            После создания предмет будет автоматически привязан к группе, из которой вы перешли.
          </div>
        <% } %>
        <div class="actions">
          <% if (mode === 'create') { %>
            <button type="submit" name="_next" value="topics" class="btn btn-success">Создать и перейти к предмету</button>
            <button type="submit" name="_next" value="groups" class="btn btn-success">Создать и привязать группы</button>
          <% } else { %>
            <button type="submit" class="btn btn-success">Сохранить изменения</button>
          <% } %>
          <a href="<%= mode === 'edit' ? '/subjects/' + subject.id + '/topics' : '/subjects' %>" class="btn btn-ghost">Отмена</a>
        </div>
      </div>
    </form>
  </section>
</div>
<%- include('../../layout/footer') %>
<%- include('../../layout/header', { title: 'Импорт тем' }) %>
<div class="content-wrapper narrow">
  <%- include('../../shared/page-top', {
    title: 'Импорт тем',
    subtitle: subject.title,
    back: { href: `/subjects/${subject.id}/topics` }
  }) %>
  <div class="info-box info-box-blue info-box-how">
    <strong>Формат CSV:</strong> UTF-8, разделитель <code>;</code> (или <code>,</code> — определится автоматически).
    Первая строка — заголовки. Колонки: <code>title</code>, <code>description</code>,
    <code>content_url</code>, <code>assignment_url</code>, <code>status</code>.<br>
    <strong>Статус:</strong> <code>published</code> (по умолчанию) или <code>draft</code>.
    Значение <code>finished</code>/«завершён» игнорируется — завершить тему может только администратор,
    такая строка создастся как <code>published</code>.
  </div>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="info-box info-box-red" role="alert"><%= error %></div>
  <% } %>
  <% if (result) { %>
    <div class="info-box info-box-green">
      <strong>Импорт завершён.</strong> Создано тем: <strong><%= result.created %></strong>.
      <% if (result.errors && result.errors.length > 0) { %>
        Ошибок: <strong><%= result.errors.length %></strong>.
      <% } %>
    </div>
    <% if (result.errors && result.errors.length > 0) { %>
      <section class="card">
        <div class="card-header"><h2>Ошибки и пропуски</h2></div>
        <div class="table-scroll">
          <table class="data-table">
            <thead><tr><th class="th-80">Строка</th><th>Причина</th></tr></thead>
            <tbody>
              <% result.errors.forEach((e) => { %>
                <tr>
                  <td class="cell-secondary"><%= e.line %></td>
                  <td><span class="status-badge status-rejected"><%= e.reason %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>
    <div class="actions-row">
      <a href="/subjects/<%= subject.id %>/topics/import" class="btn btn-secondary">Импортировать ещё</a>
      <a href="/subjects/<%= subject.id %>/topics" class="btn btn-primary">К темам</a>
    </div>
  <% } else { %>
    <section class="card">
      <div class="card-header">
        <h2>Загрузить CSV</h2>
        <a href="/subjects/<%= subject.id %>/topics/import/template" class="btn btn-secondary btn-sm">Скачать шаблон</a>
      </div>
      <form action="/subjects/<%= subject.id %>/topics/import" method="POST" enctype="multipart/form-data">
        <div class="form-grid">
          <label for="import-file" class="form-label">Файл CSV <span class="required">*</span></label>
          <div class="field">
            <input type="file" id="import-file" name="file" accept=".csv,text/csv" required>
            <div class="hint">Максимум 2 МБ. Кодировка — UTF-8. Максимум 2000 строк.</div>
          </div>
          <div class="actions">
            <button type="submit" class="btn btn-success">Импортировать</button>
            <a href="/subjects/<%= subject.id %>/topics" class="btn btn-ghost">Отмена</a>
          </div>
        </div>
      </form>
    </section>
  <% } %>
</div>
<%- include('../../layout/footer') %>
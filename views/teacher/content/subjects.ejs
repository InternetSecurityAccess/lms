<%- include('../../layout/header', { title: 'Мои предметы' }) %>
<%
  const baseQuery = {
    q: q || '',
    group: selectedGroup || ''
  };
%>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: 'Мои предметы',
    actions: [
      { href: '/subjects/new', label: '+ Создать предмет', class: 'btn-primary' }
    ]
  }) %>
  <div class="info-box info-box-blue info-box-how">
    <strong>Отвязать одну группу</strong> — в карточке предмета → «Группы».
    Снимите галочку, история сдач сохранится как только для чтения.<br>
    <strong>Удалить предмет</strong> — на странице предмета (вкладка «Темы»), кнопка «В корзину».
    Восстановить можно через «Корзину» в меню.<br>
    Завершить весь предмет может только администратор.
  </div>
  <form method="GET" action="/subjects" class="inline-add-form">
    <input type="search" name="q" value="<%= q %>" placeholder="Поиск по названию или описанию" maxlength="100" class="search-input-260">
    <select name="group">
      <option value="">Все группы</option>
      <% myGroups.forEach((g) => { %>
        <option value="<%= g.id %>" <%= selectedGroup === String(g.id) ? 'selected' : '' %>><%= g.name %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-primary btn-sm">Найти</button>
    <% if (q || selectedGroup) { %>
      <a href="<%= buildUrl('/subjects', baseQuery, { q: '', group: '' }) %>" class="btn btn-ghost btn-sm">Сбросить</a>
    <% } %>
  </form>
  <% if (subjects.length === 0) { %>
    <%- include('../../shared/ui/empty-state', {
      primary: (q || selectedGroup) ? 'Ничего не найдено.' : 'Предметов пока нет.',
      secondary: (!q && !selectedGroup) ? 'Создайте первый предмет — например, «Базы данных».' : null,
      action: (q || selectedGroup)
        ? { href: buildUrl('/subjects', baseQuery, { q: '', group: '' }), label: 'Сбросить фильтры' }
        : { href: '/subjects/new', label: 'Создать предмет', class: 'btn-primary' }
    }) %>
  <% } else { %>
    <div class="card-grid">
      <% subjects.forEach((s) => {
        const isActive = s.status === 'active';
      %>
        <div class="entity-card <%= !isActive ? 'cell-secondary' : '' %>">
          <a href="/subjects/<%= s.id %>/topics" style="text-decoration:none; color:inherit; display:block;">
            <div class="entity-card-title">
              <% if (!isActive) { %>📦 <% } %><%= s.title %>
            </div>
            <% if (s.description) { %>
              <div class="entity-card-subtitle"><%= s.description.slice(0, 100) %><%= s.description.length > 100 ? '…' : '' %></div>
            <% } %>
            <div class="entity-card-stats">
              <span>Тем: <%= s.topics_count %></span>
              <span>Заданий: <%= s.assignments_count %></span>
              <span>Групп: <%= s.groups_count %></span>
              <% if (!isActive) { %>
                <span class="status-badge status-muted">закрыт администратором</span>
              <% } %>
            </div>
            <% if (s.groups_list) { %>
              <div class="cell-secondary mt-1">👥 <%= s.groups_list %></div>
            <% } else { %>
              <div class="cell-secondary mt-1 text-warning">⚠ Не прикреплён ни к одной группе</div>
            <% } %>
          </a>
          <div class="actions-row mt-2">
            <a href="/subjects/<%= s.id %>/groups" class="btn btn-secondary btn-sm">
              Группы (<%= s.groups_count %>)
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../../layout/footer') %>
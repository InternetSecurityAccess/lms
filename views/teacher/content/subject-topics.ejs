<%- include('../../layout/header', { title: subject.title }) %>
<%
const basePath = `/subjects/${subject.id}/topics`;
const baseQuery = { topics_q: topicsQ || '', type: typeFilter || '' };
// Фильтр 'lectures' в роуте = assignment_id IS NULL, то есть лекции И тесты.
// Отдельного чипа «Тесты» нет: тесты видны в «Все» и в «Лекции и тесты».
const typeFilters = [
  { key: 'all',         label: `Все (${topicCounts.all})` },
  { key: 'lectures',    label: `Лекции и тесты (${topicCounts.lectures})` },
  { key: 'assignments', label: `Задания (${topicCounts.assignments})` }
].map((f) => ({
  ...f,
  href: buildUrl(basePath, baseQuery, { type: f.key === 'all' ? '' : f.key }),
  active: typeFilter === f.key
}));
const isSubjectActive = subject.status === 'active';
const quizCount = topics.filter((t) => !!t.quiz_id).length;
%>
<div class="content-wrapper">

<%- include('../../shared/page-top', {
  title: subject.title,
  subtitle: isSubjectActive ? null : 'закрыт администратором',
  actions: [
    { href: `/subjects/${subject.id}/edit`, label: 'Редактировать', class: 'btn-secondary btn-sm' },
    { href: `/subjects/${subject.id}/groups`, label: `Группы (${counts.groups})`, class: 'btn-secondary btn-sm' },
    {
      label: 'В корзину',
      class: 'btn-danger-soft btn-sm',
      form: {
        action: `/subjects/${subject.id}/delete`,
        confirm: 'Переместить предмет «' + subject.title + '» в корзину?\nДанные и файлы сохранятся. Восстановить можно в разделе «Корзина».',
        okText: 'В корзину',
        okClass: 'warning'
      }
    }
  ],
  back: { href: '/subjects' },
  flashes: [
    ...(query.updated ? [{ type: 'green', text: '<strong>Изменения сохранены.</strong>' }] : []),
    ...(query.deleted ? [{ type: 'yellow', text: '<strong>Тема удалена.</strong>' }] : [])
  ]
}) %>

<div class="tabs">
  <a href="/subjects/<%= subject.id %>/topics" class="tab active">Темы (<%= counts.topics %>)</a>
  <a href="/subjects/<%= subject.id %>/groups" class="tab">Группы (<%= counts.groups %>)</a>
  <a href="/subjects/<%= subject.id %>/assignments" class="tab">Задания (<%= counts.assignments %>)</a>
</div>

<% if (!isSubjectActive) { %>
  <div class="info-box info-box-yellow" role="status">
    <strong>Предмет закрыт администратором.</strong> Студенты видят его только для чтения:
    темы, работы и результаты тестов открываются, но сдавать, писать в чат и проходить
    тесты нельзя. Чтобы возобновить предмет — обратитесь к администратору.<br>
    <strong>Отвязать только одну группу</strong> — раздел «Группы», снять галочку.
  </div>
<% } %>

<% if (counts.groups === 0) { %>
  <div class="info-box info-box-yellow">
    <strong>Предмет не привязан ни к одной группе.</strong>
    Темы и задания никто не видит. <a href="/subjects/<%= subject.id %>/groups">Привязать группы →</a>
  </div>
<% } %>

<% if (quizCount > 0) { %>
  <div class="info-box info-box-blue">
    🧪 Тестов в списке: <strong><%= quizCount %></strong>.
    Кнопка <strong>«Результаты теста»</strong> открывает сводку по студентам и разбор попыток.
    После первой попытки студентов вопросы и варианты теста изменить уже нельзя —
    только настройки (название, порог, лимиты, показ ответов).
  </div>
<% } %>

<section class="card" id="topics">
  <div class="card-header">
    <h2>Темы (<%= topics.length %><%= topicsQ ? ' из ' + topicCounts.all : '' %>)</h2>
    <div class="actions-row">
      <a href="/subjects/<%= subject.id %>/topics/import" class="btn btn-secondary btn-sm">Импорт</a>
      <a href="/subjects/<%= subject.id %>/topics/new?assignment_mode=quiz" class="btn btn-secondary btn-sm">🧪 Создать тест</a>
      <a href="/subjects/<%= subject.id %>/topics/new" class="btn btn-primary btn-sm">+ Создать тему</a>
    </div>
  </div>

  <%- include('../../shared/ui/filter-chips', { items: typeFilters }) %>

  <form method="GET" action="<%= basePath %>" class="inline-add-form mb-2">
    <% if (typeFilter !== 'all') { %><input type="hidden" name="type" value="<%= typeFilter %>"><% } %>
    <input type="search" name="topics_q" value="<%= topicsQ %>"
           placeholder="Поиск по названию или описанию" maxlength="100" class="search-input-280">
    <button type="submit" class="btn btn-primary btn-sm">Найти</button>
    <% if (topicsQ) { %>
      <a href="<%= buildUrl(basePath, {}, { type: typeFilter === 'all' ? '' : typeFilter }) %>"
         class="btn btn-ghost btn-sm">Сбросить</a>
    <% } %>
  </form>

  <% if (topics.length === 0) { %>
    <div class="empty-state">
      <% if (topicsQ) { %>
        <p>Ничего не найдено по запросу «<%= topicsQ %>».</p>
      <% } else if (typeFilter === 'lectures') { %>
        <p>Лекций и тестов пока нет.</p>
        <a href="/subjects/<%= subject.id %>/topics/new" class="btn btn-primary mt-3">+ Создать тему</a>
      <% } else if (typeFilter === 'assignments') { %>
        <p>Заданий пока нет.</p>
        <a href="/subjects/<%= subject.id %>/topics/new?assignment_mode=internal"
           class="btn btn-primary mt-3">+ Создать задание</a>
      <% } else { %>
        <p>Тем пока нет.</p>
        <div class="actions-row mt-3" style="justify-content:center;">
          <a href="/subjects/<%= subject.id %>/topics/new" class="btn btn-primary">+ Создать тему</a>
          <a href="/subjects/<%= subject.id %>/topics/new?assignment_mode=quiz" class="btn btn-secondary">🧪 Создать тест</a>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th class="th-40">#</th>
            <th>Название</th>
            <th class="th-80" style="text-align:center;">📎</th>
            <th class="th-180">Задание / Тест</th>
            <th class="th-160" style="text-align:center;">Статус</th>
            <th class="th-320"></th>
          </tr>
        </thead>
        <tbody>
        <% topics.forEach((t, idx) => {
          const fileCount = (t.attachments || []).length;
          const topicStatus = t.status;
          const isFuture = !!t.is_future;
          const isQuiz = !!t.quiz_id;
        %>
          <tr>
            <td class="cell-secondary"><%= idx + 1 %></td>
            <td>
              <a href="/subjects/<%= subject.id %>/topics/<%= t.id %>" class="text-inherit">
                <strong><%= t.title %></strong>
              </a>
              <% if (isQuiz) { %>
                <span class="status-badge status-info" title="Тестирование">🧪 Тест</span>
              <% } %>
              <% if (t.description) { %>
                <% const plain = String(t.description).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim(); %>
                <div class="cell-secondary"><%= plain.slice(0, 100) %><%= plain.length > 100 ? '…' : '' %></div>
              <% } %>
            </td>
            <td style="text-align:center;">
              <% if (fileCount > 0 || t.content_url) { %>
                <button type="button" class="btn btn-ghost btn-sm"
                        onclick="openMaterialsModal(<%= t.id %>)"
                        title="Материалы<%= fileCount > 0 ? ' (' + fileCount + ' файл.)' : '' %><%= t.content_url ? ' + ссылка' : '' %>">
                  <%= fileCount > 0 ? '📎 ' + fileCount : '🔗' %>
                </button>
              <% } else { %>
                <span class="cell-secondary">—</span>
              <% } %>
            </td>
            <td class="cell-secondary">
              <% if (isQuiz) { %>
                <a href="/teacher/quiz/<%= t.id %>/results">🧪 Тестирование</a>
                <div class="cell-secondary">автоматическая проверка</div>
              <% } else if (t.assignment_id) { %>
                <a href="/subjects/<%= subject.id %>/assignments/<%= t.assignment_id %>">
                  📝 <%= t.assignment_title || '—' %>
                </a>
                <div class="cell-secondary">Работ: <%= t.assignment_works_count || 0 %></div>
              <% } else if (t.homework_text || t.assignment_url) { %>
                <span class="status-badge status-info">📖 ДЗ</span>
              <% } else { %>—<% } %>
            </td>
            <td style="text-align:center;">
              <% if (isFuture) { %>
                <span class="status-badge status-info" title="Доступно с <%= formatDate(t.available_from, true) %>">
                  ⏰ отложено
                </span>
                <div class="cell-secondary">с <%= formatDate(t.available_from, true) %></div>
              <% } else if (topicStatus === 'published') { %>
                <span class="status-badge status-success" title="Опубликовано">✅ опубликовано</span>
              <% } else if (topicStatus === 'finished') { %>
                <span class="status-badge status-muted" title="Завершено (только для чтения)">📦 завершено</span>
              <% } else { %>
                <span class="status-badge status-warning" title="Черновик">📝 черновик</span>
              <% } %>
            </td>
            <td>
              <div class="actions-row actions-nowrap">
                <a href="/subjects/<%= subject.id %>/topics/<%= t.id %>/edit"
                   class="btn btn-secondary btn-sm">Редактировать</a>
                <% if (isQuiz) { %>
                  <a href="/teacher/quiz/<%= t.id %>/results"
                     class="btn btn-primary btn-sm">Результаты теста</a>
                <% } %>
                <form method="POST" action="/subjects/<%= subject.id %>/topics/<%= t.id %>/delete"
                      class="inline-form"
                      data-confirm="Удалить тему «<%= t.title %>»?&#10;<% if (isQuiz) { %>Тест и все попытки студентов будут скрыты. Восстановить тему можно из «Корзины».<% } else if (t.assignment_id) { %>Связанное задание <% if ((t.assignment_works_count || 0) > 0) { %>будет завершено (работы сохранятся)<% } else { %>удалится полностью<% } %>.<% } %>">
                  <button type="submit" class="btn btn-danger-soft btn-sm">Удалить</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
</div>

<div id="materialsModal" class="modal" hidden>
  <div class="modal-backdrop" onclick="closeMaterialsModal()"></div>
  <div class="modal-dialog modal-lg">
    <div class="modal-header">
      <h3 id="materialsModalTitle">Материалы</h3>
      <button type="button" class="modal-close" onclick="closeMaterialsModal()" aria-label="Закрыть">✕</button>
    </div>
    <div id="materialsModalBody"></div>
  </div>
</div>

<script>
(function () {
  const PREVIEWABLE_EXTS = <%- JSON.stringify(Array.from(PREVIEWABLE_EXTS)) %>;

  function canPreviewClient(name) {
    const m = String(name || '').match(/\.[a-z0-9]+$/i);
    if (!m) return false;
    return PREVIEWABLE_EXTS.includes(m[0].toLowerCase());
  }

  const MATERIALS = <%- JSON.stringify(topics.map((t) => ({
    id: t.id,
    title: t.title,
    files: (t.attachments || []).map((f) => ({
      id: f.id,
      name: f.filename,
      size: Number(f.filesize) || 0,
      url: '/file/attachment/' + f.id,
      inlineUrl: '/file/attachment/' + f.id + '?inline=1'
    })),
    contentUrl: t.content_url || null
  }))).replace(/</g, '\\u003c') %>;

  for (const m of MATERIALS) {
    for (const f of m.files) f.previewable = canPreviewClient(f.name);
  }

  function escHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  window.openMaterialsModal = function (topicId) {
    const m = MATERIALS.find((x) => Number(x.id) === Number(topicId));
    if (!m) return;
    document.getElementById('materialsModalTitle').textContent = 'Материалы: ' + m.title;
    const body = document.getElementById('materialsModalBody');
    let html = '';
    if (m.files.length > 0) {
      html += '<div class="file-list">';
      for (const f of m.files) {
        const sizeKb = (f.size / 1024).toFixed(1);
        html += '<div class="file-row">'
          + '<div class="file-row-info">'
          + '<div class="file-row-name">' + escHtml(f.name) + '</div>'
          + '<div class="cell-secondary">' + sizeKb + ' КБ</div>'
          + '</div>';
        if (f.previewable) {
          html += '<a href="' + escHtml(f.inlineUrl) + '"'
            + ' class="btn btn-ghost btn-sm"'
            + ' data-file-preview'
            + ' data-file-name="' + escHtml(f.name) + '"'
            + ' data-view-url="' + escHtml(f.inlineUrl) + '"'
            + ' data-download-url="' + escHtml(f.url) + '"'
            + ' onclick="closeMaterialsModal()">Открыть</a>';
        }
        html += '<a href="' + escHtml(f.url) + '" class="btn btn-secondary btn-sm">Скачать</a>';
        html += '</div>';
      }
      html += '</div>';
    }
    if (m.contentUrl) {
      html += '<div class="info-box info-box-blue mt-2">'
        + '🔗 <a href="' + escHtml(m.contentUrl) + '" target="_blank" rel="noopener">'
        + escHtml(m.contentUrl) + '</a></div>';
    }
    if (!html) html = '<div class="empty-state">Нет материалов.</div>';
    body.innerHTML = html;
    document.getElementById('materialsModal').hidden = false;
    document.body.classList.add('modal-open');
  };

  window.closeMaterialsModal = function () {
    document.getElementById('materialsModal').hidden = true;
    document.body.classList.remove('modal-open');
  };

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('materialsModal');
      if (modal && !modal.hidden) closeMaterialsModal();
    }
  });
})();
</script>

<%- include('../../shared/ui/file-viewer') %>
<%- include('../../layout/footer') %>
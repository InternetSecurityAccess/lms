<%- include('../../layout/header', {
  title: mode === 'create' ? 'Новое задание' : 'Редактировать задание'
}) %>
<div class="content-wrapper narrow">
  <%- include('../../shared/page-top', {
    title: mode === 'create' ? 'Новое задание' : 'Редактировать задание',
    subtitle: subject.title,
    back: { href: `/subjects/${subject.id}/assignments` },
    flashes: (mode === 'create' && query.added)
      ? [{ type: 'green', text: '<strong>Задание создано.</strong> Можно добавить следующее.' }]
      : []
  }) %>
  <div class="tabs">
    <a href="/subjects/<%= subject.id %>/topics" class="tab">Темы (<%= counts.topics %>)</a>
    <a href="/subjects/<%= subject.id %>/groups" class="tab">Группы (<%= counts.groups %>)</a>
    <a href="/subjects/<%= subject.id %>/assignments" class="tab active">Задания (<%= counts.assignments %>)</a>
  </div>
  <div class="info-box info-box-blue info-box-how">
    Задание доступно всем группам, к которым привязан предмет «<%= subject.title %>».
    <% if (counts.groups === 0) { %>
      <br><strong>Предмет не привязан ни к одной группе.</strong>
      <a href="/subjects/<%= subject.id %>/groups">Привязать группы →</a>
    <% } %>
  </div>
  <section class="card">
    <% if (error) { %><div class="info-box info-box-red"><%= error %></div><% } %>
    <form id="assignmentForm" <%= mode === 'edit' ? 'data-unsaved-guard' : '' %>
          action="/subjects/<%= subject.id %>/assignments<%= mode === 'edit' ? '/' + assignment.id : '' %>"
          method="POST" enctype="multipart/form-data">
      <div class="form-grid">
        <label for="a-title" class="form-label">Название <span class="required">*</span></label>
        <div class="field">
          <input type="text" id="a-title" name="title" required maxlength="200"
            value="<%= assignment.title || '' %>" placeholder="Например: Практическая работа №1">
        </div>
        <label for="a-desc" class="form-label">Описание</label>
        <div class="field">
          <textarea id="a-desc" name="description" maxlength="2000" rows="4"
            placeholder="Требования"><%= assignment.description || '' %></textarea>
        </div>
        <label for="a-deadline" class="form-label">Дедлайн</label>
        <div class="field">
          <input type="datetime-local" id="a-deadline" name="deadline" value="<%= deadlineInput %>">
          <div class="hint">
            Время в часовом поясе колледжа (<%= college.TZ %>).
            Пусто — без ограничения по времени.
          </div>
        </div>
        <label for="a-url" class="form-label">Ссылка на материалы</label>
        <div class="field">
          <input type="url" id="a-url" name="external_url" maxlength="1000"
            value="<%= assignment.external_url || '' %>"
            placeholder="https://disk.yandex.ru/...">
        </div>
        <label class="form-label">Файлы задания</label>
        <div class="field">
          <% if (mode === 'edit' && existingFiles && existingFiles.length > 0) { %>
            <div class="hint mb-1">Текущие файлы — отметьте, чтобы удалить:</div>
            <%- include('../../shared/ui/attachments-list', {
              items: existingFiles, empty: '—', removeAction: true
            }) %>
          <% } %>
          <input type="file" id="a-files" name="files" multiple
            accept="<%= ACCEPT_UPLOAD %>"
            data-max-size-mb="<%= MAX_FILE_SIZE_MB %>"
            data-max-files="<%= MAX_FILES_PER_UPLOAD %>">
          <div class="hint">
            <%= HINT_UPLOAD %> Необязательно.
          </div>
        </div>
        <div class="actions">
          <% if (mode === 'create') { %>
            <button type="submit" name="_action" value="open" class="btn btn-success">Создать и открыть</button>
            <button type="submit" name="_action" value="again" class="btn btn-success">Создать и добавить ещё</button>
          <% } else { %>
            <button type="submit" name="_action" value="open" class="btn btn-success">Сохранить изменения</button>
          <% } %>
          <a href="/subjects/<%= subject.id %>/assignments" class="btn btn-ghost">Отмена</a>
        </div>
      </div>
    </form>
  </section>
</div>
<%- include('../../shared/ui/file-viewer') %>
<%- include('../../layout/footer') %>
<%- include('../../layout/header', { title: group.name }) %>
<%
  const baseQuery = {
    tab: tab || 'subjects',
    subjects_q: subjectsQ || '',
    has_works: hasWorks || '',
    q: q || '',
    sort: sort || (tab === 'students' ? 'name_asc' : '')
  };
  const buildUrl_ = (overrides = {}) => buildUrl(`/g/${group.id}`, baseQuery, overrides);
%>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: group.name,
    subtitle: `Студентов: ${students.length}`,
    back: { href: '/my-groups' }
  }) %>
  <div class="tabs">
    <a href="<%= buildUrl_({ tab: 'subjects' }) %>"
       class="tab <%= tab === 'subjects' ? 'active' : '' %>">Предметы (<%= subjects ? subjects.length : 0 %>)</a>
    <a href="<%= buildUrl_({ tab: 'students' }) %>"
       class="tab <%= tab === 'students' ? 'active' : '' %>">Студенты</a>
    <% if (isSubscribed) { %>
      <a href="/g/<%= group.id %>/chat" class="tab">💬 Чат</a>
    <% } %>
  </div>
  <% if (tab === 'subjects') { %>
    <section class="card">
      <div class="card-header">
        <h2>Предметы группы (<%= subjects ? subjects.length : 0 %>)</h2>
        <div class="actions-row">
          <a href="/subjects/new?attach=<%= group.id %>" class="btn btn-primary btn-sm">+ Создать предмет</a>
        </div>
      </div>
      <div class="info-box info-box-blue info-box-how">
        Предметы принадлежат преподавателю. Здесь показаны те, что прикреплены к этой группе.
      </div>
      <% if ((subjects && subjects.length > 0) || subjectsQ) { %>
        <form method="GET" action="/g/<%= group.id %>" class="inline-add-form mb-2">
          <input type="hidden" name="tab" value="subjects">
          <input type="search" name="subjects_q" value="<%= subjectsQ || '' %>"
            placeholder="Поиск по названию или описанию предмета"
            maxlength="100" class="search-input-280">
          <button type="submit" class="btn btn-primary btn-sm">Найти</button>
          <% if (subjectsQ) { %>
            <a href="/g/<%= group.id %>?tab=subjects" class="btn btn-ghost btn-sm">Сбросить</a>
          <% } %>
        </form>
      <% } %>
      <% if (!subjects || subjects.length === 0) { %>
        <div class="empty-state">
          <% if (subjectsQ) { %>
            <p>Ничего не найдено по запросу «<%= subjectsQ %>».</p>
            <a href="/g/<%= group.id %>?tab=subjects" class="btn btn-secondary mt-3">Сбросить поиск</a>
          <% } else { %>
            <p>К этой группе пока не прикреплено ни одного предмета.</p>
            <div class="actions-row mt-3">
              <a href="/subjects/new?attach=<%= group.id %>" class="btn btn-primary">+ Создать предмет</a>
              <a href="/subjects" class="btn btn-secondary">Мои предметы</a>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="card-grid">
          <% subjects.forEach((s) => { %>
            <a href="/subjects/<%= s.id %>" class="entity-card">
              <div class="entity-card-title"><%= s.title %></div>
              <% if (s.description) { %>
                <div class="entity-card-subtitle"><%= s.description.slice(0, 100) %><%= s.description.length > 100 ? '…' : '' %></div>
              <% } %>
              <div class="entity-card-stats">
                <span>Тем: <%= s.topics_count %></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
      <% if (allMySubjects && allMySubjects.length > 0) { %>
        <div class="card-header mt-3"><h2>Прикрепить существующий предмет</h2></div>
        <div class="card-grid">
          <% allMySubjects.forEach((s) => { %>
            <div class="entity-card">
              <div class="entity-card-title"><%= s.title %></div>
              <form method="POST" action="/subjects/<%= s.id %>/attach" class="mt-1">
                <input type="hidden" name="group_id" value="<%= group.id %>">
                <button type="submit" class="btn btn-secondary btn-sm">Прикрепить к <%= group.name %></button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  <% } else { %>
    <div class="filter-chips">
      <a href="<%= buildUrl_({ has_works: '' }) %>" class="chip <%= !hasWorks ? 'active' : '' %>">Все</a>
      <a href="<%= buildUrl_({ has_works: 'yes' }) %>" class="chip <%= hasWorks === 'yes' ? 'active' : '' %>">Есть работы</a>
      <a href="<%= buildUrl_({ has_works: 'none' }) %>" class="chip <%= hasWorks === 'none' ? 'active' : '' %>">Без работ</a>
    </div>
    <form method="GET" action="/g/<%= group.id %>" class="inline-add-form">
      <input type="hidden" name="tab" value="students">
      <% if (hasWorks) { %><input type="hidden" name="has_works" value="<%= hasWorks %>"><% } %>
      <input type="search" name="q" value="<%= q %>" maxlength="100"
        placeholder="Поиск по ФИО или логину" class="search-input">
      <select name="sort">
        <option value="name_asc" <%= sort === 'name_asc' ? 'selected' : '' %>>По имени (А→Я)</option>
        <option value="name_desc" <%= sort === 'name_desc' ? 'selected' : '' %>>По имени (Я→А)</option>
        <option value="date_desc" <%= sort === 'date_desc' ? 'selected' : '' %>>Сначала новые</option>
        <option value="date_asc" <%= sort === 'date_asc' ? 'selected' : '' %>>Сначала старые</option>
      </select>
      <button type="submit" class="btn btn-primary btn-sm">Найти</button>
      <% if (q) { %>
        <a href="<%= buildUrl_({ q: '' }) %>" class="btn btn-ghost btn-sm">Сбросить</a>
      <% } %>
    </form>
    <section class="card">
      <div class="card-header"><h2>Студенты группы</h2></div>
      <% if (!isSubscribed) { %>
        <div class="info-box info-box-yellow">Чтобы управлять доступом, отметьте «Моя группа».</div>
      <% } %>
      <% if (students.length === 0) { %>
        <div class="empty-state"><%= q || hasWorks ? 'Ничего не найдено.' : 'В группе пока нет студентов.' %></div>
      <% } else { %>
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>ФИО и логин</th>
                <th class="th-100">Моих работ</th>
                <th>Зарегистрирован</th>
                <th class="th-340">Действия</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach((s) => { %>
                <tr>
                  <td>
                    <strong><%= s.name %></strong>
                    <% if (s.login) { %>
                      <div class="cell-secondary">Логин: <code class="user-select-all"><%= s.login %></code></div>
                    <% } %>
                    <% if (!s.approved_at) { %>
                      <span class="status-badge status-warning">не подтверждён</span>
                    <% } %>
                    <% if (s.must_change_password) { %>
                      <span class="status-badge status-warning">ждёт смены</span>
                    <% } %>
                  </td>
                  <td><%= s.my_works_count %></td>
                  <td class="cell-secondary"><%= formatDate(s.created_at) %></td>
                  <td>
                    <div class="actions-row">
                      <% if (!s.approved_at) { %>
                        <% if (isSubscribed) { %>
                          <form method="POST" action="/g/<%= group.id %>/students/<%= s.id %>/approve" class="inline-form"
                            data-confirm="Подтвердить регистрацию студента <%= s.name %>?"
                            data-confirm-ok-text="Подтвердить"
                            data-confirm-ok-class="success">
                            <button type="submit" class="btn btn-success btn-sm">Подтвердить</button>
                          </form>
                          <form method="POST" action="/g/<%= group.id %>/students/<%= s.id %>/reject" class="inline-form"
                            data-confirm="Отклонить регистрацию студента <%= s.name %>?"
                            data-confirm-ok-text="Отклонить"
                            data-confirm-ok-class="danger">
                            <input type="text" name="reason" required maxlength="500" placeholder="Причина"
                              class="inline-input inline-input-140">
                            <button type="submit" class="btn btn-danger btn-sm">Отклонить</button>
                          </form>
                        <% } else { %>
                          <span class="cell-secondary">—</span>
                        <% } %>
                      <% } else if (isSubscribed) { %>
                        <button type="button" class="btn btn-secondary btn-sm reset-password-btn"
                          data-student-id="<%= s.id %>"
                          data-student-name="<%= s.name %>"
                          data-group-id="<%= group.id %>">Сбросить пароль</button>
                      <% } else { %>
                        <span class="cell-secondary">—</span>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  <% } %>
</div>
<%- include('../../shared/ui/reset-password') %>
<%- include('../../layout/footer') %>
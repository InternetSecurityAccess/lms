<%- include('../../layout/header', { title: 'Результат импорта' }) %>
<div class="content-wrapper narrow">
  <div class="top-bar">
    <h1 class="top-bar-title">Результат импорта</h1>
  </div>
  <%
    const typeLabels = { teachers: 'Преподаватели', students: 'Студенты', groups: 'Группы' };
    const modeTitles = {
      create: 'Создание новых записей',
      update: 'Обновление существующих',
      upsert: 'Создание или обновление',
      delete: hardDelete ? 'Удаление навсегда' : 'Архивирование'
    };
    const modeTitle = modeTitles[mode] || mode;
  %>
  <section class="card">
    <div class="card-header">
      <h2><%= typeLabels[type] || type %></h2>
      <a href="/admin/import-export" class="btn btn-ghost btn-sm">← Импорт/экспорт</a>
    </div>
    <div class="info-box info-box-blue">
      <strong>Режим:</strong> <%= modeTitle %>
    </div>
    <div class="stats-grid mt-3">
      <div class="stat-card"><div class="stat-label">Создано</div><div class="stat-value success"><%= result.created %></div></div>
      <div class="stat-card"><div class="stat-label">Обновлено</div><div class="stat-value"><%= result.updated %></div></div>
      <div class="stat-card"><div class="stat-label">Архивировано</div><div class="stat-value warning"><%= result.archived %></div></div>
      <div class="stat-card"><div class="stat-label">Удалено</div><div class="stat-value error"><%= result.deleted %></div></div>
      <div class="stat-card"><div class="stat-label">Пропущено</div><div class="stat-value warning"><%= result.skipped %></div></div>
    </div>
    <% if (result.generatedPasswords && result.generatedPasswords.length > 0) { %>
      <div class="card-header mt-3"><h2>Сгенерированные пароли (<%= result.generatedPasswords.length %>)</h2></div>
      <div class="info-box info-box-yellow">
        Эти пользователи созданы без пароля в CSV — система сгенерировала пароли.
        Передайте их лично. Пароли показываются только один раз.
      </div>
      <div class="table-scroll mt-3">
        <table class="data-table">
          <thead><tr><th>Логин</th><th>Пароль</th></tr></thead>
          <tbody>
            <% result.generatedPasswords.forEach((p) => { %>
              <tr>
                <td><%= p.login %></td>
                <td><code class="user-select-all"><%= p.password %></code></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <% if (result.errors.length > 0) { %>
      <div class="card-header mt-3"><h2>Ошибки и пропуски (<%= result.errors.length %>)</h2></div>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr><th class="th-80">Строка</th><th>Причина</th></tr>
          </thead>
          <tbody>
            <% result.errors.forEach((e) => { %>
              <tr>
                <td class="cell-secondary"><%= e.line %></td>
                <td>
                  <%
                    const isSkip = /уже существует|не найден|не найдена|нет данных/.test(e.reason);
                  %>
                  <span class="status-badge <%= isSkip ? 'status-warning' : 'status-danger' %>">
                    <%= e.reason %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <div class="actions-row mt-3">
      <a href="/admin/<%= type %>" class="btn btn-primary">К списку</a>
      <a href="/admin/import-export" class="btn btn-secondary">Импортировать ещё</a>
    </div>
  </section>
</div>
<%- include('../../layout/footer') %>
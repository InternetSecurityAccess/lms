<%- include('../../layout/header', { title: 'Настройки' }) %>
<%
  const R = restartKeys || [];
  const needRestart = (key) => R.includes(key);
  const cs = current['security.cookieSecure'];
  const auditExt = !!current['audit.extended'];
  const auditUntil = current['audit.extendedUntil'];
  const extActive = auditExt && auditUntil != null && Date.now() < Number(auditUntil);
  const extExpired = auditExt && auditUntil != null && Date.now() >= Number(auditUntil);
  const untilText = auditUntil
    ? new Date(Number(auditUntil)).toLocaleString('ru-RU')
    : '—';
  const mutedSet = new Set(mutedActions || []);
  const forceSet = new Set(forceLogActions || []);
  const securityRestart = needRestart('security.sessionMaxAgeHours')
    || needRestart('security.cookieSecure');
  const rateMbps = Number(current['files.uploadRateLimitMbps']) || 0;
  // ← quillSelected берётся из уже развёрнутого набора (роут разворачивает
  //   старое значение media в link+image+formula). Если в БД сохранено
  //   media от прошлой версии, здесь всё равно будут три актуальные
  //   группы. quillToolbarGroupsDisplay приходит из GET-роута.
  const quillSelected = new Set(quillToolbarGroupsDisplay || []);
  const quillLabels = {
    fonts:   'Шрифт и заголовки',
    inline:  'Жирный / курсив / подчёркнутый / зачёркнутый',
    color:   'Цвет текста и фона',
    script:  'Надстрочный / подстрочный',
    list:    'Списки (маркированный, нумерованный, чек-лист)',
    indent:  'Отступы',
    align:   'Выравнивание',
    blocks:  'Цитата и блок кода',
    link:    'Ссылки',
    image:   'Картинки',
    formula: 'Формулы',
    clean:   'Очистить форматирование',
  };
%>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: 'Настройки',
    actions: [{ href: '/admin', label: '← В админку' }],
    flashes: saved
      ? [{
          type: 'green',
          text: '<strong>Настройки сохранены.</strong>'
            + (R.length > 0
              ? ' Некоторые изменения вступят в силу после перезапуска сервера.'
              : '')
        }]
      : []
  }) %>
  <div class="info-box info-box-blue info-box-how">
    Здесь меняются настройки, которые раньше жили в <code>.env</code>.
    Инфраструктурные параметры (<code>PORT</code>, <code>HOST</code>, <code>NODE_ENV</code>,
    <code>DATA_DIR</code>, <code>TRUST_PROXY</code>, <code>DEMO_MODE</code>,
    <code>SESSION_SECRET</code>) остаются в переменных окружения.
    Пароль администратора меняется в <a href="/admin/profile">Профиле</a>.
    <br>
    <strong>Секции свёрнуты.</strong> Нажмите на заголовок, чтобы раскрыть нужную.
  </div>
  <!-- ═══════════════ Демо-данные (сворачиваемая, вне формы) ═══════════════ -->
  <details class="settings-collapsible">
    <summary>
      <span>Демо-данные</span>
      <span class="status-badge <%= demoEnabled ? 'status-success' : 'status-muted' %>">
        <%= demoEnabled ? 'включены' : 'выключены' %>
      </span>
    </summary>
    <div class="settings-collapsible-body">
      <p class="cell-secondary m-0">
        При включённых демо-данных при каждом старте сервера создаётся (если ещё нет):
        группа «<strong><%= demoGroupName %></strong>», преподаватель
        <code><%= demoTeacherLogin %></code>, студент
        <code><%= demoStudentLogin %></code>, а также полный набор материалов.
      </p>
      <p class="cell-secondary m-0">Пароль у обоих — <code><%= demoPassword %></code>.</p>
      <div class="actions-row">
        <% if (demoEnabled) { %>
          <form method="POST" action="/admin/settings/demo/disable"
            data-confirm="Удалить демо-данные? Группа, преподаватель, студент и все их материалы (работы, переписка, файлы) будут удалены. Отменить будет нельзя.">
            <button type="submit" class="btn btn-danger">Удалить демо-данные</button>
          </form>
        <% } else { %>
          <form method="POST" action="/admin/settings/demo/enable"
            data-confirm="Создать демо-данные? Будут добавлены группа, преподаватель, студент и демонстрационные материалы.">
            <button type="submit" class="btn btn-primary">Создать демо-данные</button>
          </form>
        <% } %>
      </div>
    </div>
  </details>
  <form method="POST" action="/admin/settings" autocomplete="off">
    <!-- ═══════════════ Безопасность ═══════════════ -->
    <details class="settings-collapsible">
      <summary>
        <span>Безопасность</span>
        <% if (securityRestart) { %>
          <span class="status-badge status-warning">требуется перезапуск</span>
        <% } %>
      </summary>
      <div class="settings-collapsible-body">
        <div class="form-grid">
          <label for="s-password-level" class="form-label">Уровень пароля (студенты, преподаватели)</label>
          <div class="field">
            <select id="s-password-level" name="passwordLevel">
              <% ['basic', 'medium', 'strong'].forEach((v) => { %>
                <option value="<%= v %>" <%= current['security.passwordLevel'] === v ? 'selected' : '' %>><%= v %></option>
              <% }) %>
            </select>
          </div>
          <label for="s-admin-password-level" class="form-label">Уровень пароля администратора</label>
          <div class="field">
            <select id="s-admin-password-level" name="adminPasswordLevel">
              <% ['basic', 'medium', 'strong'].forEach((v) => { %>
                <option value="<%= v %>" <%= current['security.adminPasswordLevel'] === v ? 'selected' : '' %>><%= v %></option>
              <% }) %>
            </select>
          </div>
          <label for="s-pass-min" class="form-label">Мин. длина пароля (0 = из уровня)</label>
          <div class="field">
            <input type="number" id="s-pass-min" name="passwordMinLength"
              min="0" max="200" value="<%= current['security.passwordMinLength'] %>">
            <div class="hint">0 — использовать минимум из выбранного уровня.</div>
          </div>
          <label for="s-session-age" class="form-label">
            Время жизни сессии (часов)
            <% if (needRestart('security.sessionMaxAgeHours')) { %>
              <span class="status-badge status-warning">требуется перезапуск</span>
            <% } %>
          </label>
          <div class="field">
            <input type="number" id="s-session-age" name="sessionMaxAgeHours"
              min="1" max="720" value="<%= current['security.sessionMaxAgeHours'] %>">
            <div class="hint">Применится к новым сессиям после перезапуска сервера.</div>
          </div>
          <span class="form-label">
            Cookie Secure
            <% if (needRestart('security.cookieSecure')) { %>
              <span class="status-badge status-warning">требуется перезапуск</span>
            <% } %>
          </span>
          <div class="field">
            <label class="checkbox-row">
              <input type="radio" name="cookieSecure" value="auto" <%= cs === null ? 'checked' : '' %>>
              <span>Авто (в проде — on, в деве — off)</span>
            </label>
            <label class="checkbox-row">
              <input type="radio" name="cookieSecure" value="on" <%= cs === true ? 'checked' : '' %>>
              <span>Всегда on</span>
            </label>
            <label class="checkbox-row">
              <input type="radio" name="cookieSecure" value="off" <%= cs === false ? 'checked' : '' %>>
              <span>Всегда off</span>
            </label>
            <div class="hint">Применится после перезапуска сервера.</div>
          </div>
        </div>
      </div>
    </details>
    <!-- ═══════════════ Аутентификация ═══════════════ -->
    <details class="settings-collapsible">
      <summary>
        <span>Аутентификация</span>
        <% if (current['auth.registrationEnabled']) { %>
          <span class="status-badge status-warning">регистрация открыта</span>
        <% } else { %>
          <span class="status-badge status-muted">регистрация закрыта</span>
        <% } %>
      </summary>
      <div class="settings-collapsible-body">
        <div class="form-grid">
          <span class="form-label">Тип логина студента</span>
          <div class="field">
            <label class="checkbox-row">
              <input type="radio" name="studentLoginType" value="student_id"
                <%= current['auth.studentLoginType'] === 'student_id' ? 'checked' : '' %>>
              <span>Номер студенческого билета</span>
            </label>
            <label class="checkbox-row">
              <input type="radio" name="studentLoginType" value="email"
                <%= current['auth.studentLoginType'] === 'email' ? 'checked' : '' %>>
              <span>Email</span>
            </label>
          </div>
          <label class="form-label">Регистрация студентов</label>
          <div class="field">
            <label class="checkbox-row">
              <input type="hidden" name="registrationEnabled" value="0">
              <input type="checkbox" name="registrationEnabled" value="1"
                <%= current['auth.registrationEnabled'] ? 'checked' : '' %>>
              <span>Открыта</span>
            </label>
          </div>
          <label class="form-label">Требуется подтверждение</label>
          <div class="field">
            <label class="checkbox-row">
              <input type="hidden" name="registrationNeedsApproval" value="0">
              <input type="checkbox" name="registrationNeedsApproval" value="1"
                <%= current['auth.registrationNeedsApproval'] ? 'checked' : '' %>>
              <span>Подтверждение преподавателем или администратором</span>
            </label>
          </div>
        </div>
      </div>
    </details>
    <!-- ═══════════════ Аудит ═══════════════ -->
    <details class="settings-collapsible">
      <summary>
        <span>Аудит</span>
        <% if (extActive) { %>
          <span class="status-badge status-warning">расширенный · до <%= untilText %></span>
        <% } else if (extExpired) { %>
          <span class="status-badge status-muted">истёк</span>
        <% } else { %>
          <span class="status-badge status-success">только критичные</span>
        <% } %>
      </summary>
      <div class="settings-collapsible-body">
        <div class="form-grid">
          <span class="form-label">Расширенный аудит</span>
          <div class="field">
            <label class="checkbox-row">
              <input type="hidden" name="auditExtended" value="0">
              <input type="checkbox" name="auditExtended" value="1"
                <%= extActive ? 'checked' : '' %>>
              <span>Включить (все выбранные ниже действия + галочка «писать всё»)</span>
            </label>
            <div class="hint">
              Без этой галочки пишутся только: критичные (жёстко), галочки «Всегда»
              и действия из белого списка по умолчанию (сброс паролей, удаления, импорт).
            </div>
          </div>
          <span class="form-label">Писать всё (отладка)</span>
          <div class="field">
            <label class="checkbox-row">
              <input type="hidden" name="auditExtendedAll" value="0">
              <input type="checkbox" name="auditExtendedAll" value="1"
                <%= extendedAllActive ? 'checked' : '' %>
                <%= !extActive ? 'disabled' : '' %>>
              <span>Писать абсолютно всё, включая замьюченное</span>
            </label>
            <div class="hint">
              Работает только при включённом расширенном аудите.
              Полезно для отладки: не нужно выставлять каждое действие вручную.
              Mute-настройки игнорируются на время отладки.
            </div>
          </div>
          <label for="s-audit-duration" class="form-label">Длительность расширенного аудита</label>
          <div class="field">
            <select id="s-audit-duration" name="auditExtendedDuration">
              <option value="1h">1 час</option>
              <option value="24h">24 часа</option>
              <option value="7d">7 дней</option>
            </select>
            <div class="hint">
              При каждом сохранении с включённым чекбоксом — таймер перезапускается.
              <% if (extExpired) { %>
                <br><strong>Прошлый расширенный аудит истёк.</strong>
                Поставьте галочку и сохраните, чтобы включить снова.
              <% } %>
            </div>
          </div>
          <label for="s-audit-retention" class="form-label">Хранить аудит (дней)</label>
          <div class="field">
            <input type="number" id="s-audit-retention" name="auditRetentionDays"
              min="1" max="36500" value="<%= current['audit.retentionDays'] %>">
            <div class="hint">
              Ротация запускается раз в сутки. Значение по умолчанию — 1500 дней (~4 года).
            </div>
          </div>
        </div>
        <details>
          <summary class="clickable" style="cursor: pointer;">
            <strong>Пишутся всегда</strong>
            <span class="cell-secondary">— жёсткий минимум, отключить нельзя</span>
          </summary>
          <div class="table-scroll" style="margin-top: var(--space-2);">
            <table class="data-table">
              <thead><tr><th>Действие</th><th>Код</th></tr></thead>
              <tbody>
                <% criticalActionsList.forEach((a) => { %>
                  <tr>
                    <td><%= a.label %></td>
                    <td class="cell-secondary"><code><%= a.code %></code></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </details>
        <div class="card-header" style="margin-top: var(--space-3);">
          <h2>Настройка остальных действий</h2>
        </div>
        <div class="info-box info-box-blue">
          <strong>Всегда</strong> — писать, даже если расширенный аудит выключен.<br>
          <strong>Не писать</strong> — замьютить (только для не-критичных).<br>
          Параметры взаимоисключающие: отметили «Всегда» — «Не писать» снимается.
        </div>
        <% manageableGroups.forEach((group) => { %>
          <details class="audit-group" style="margin-top: var(--space-2);">
            <summary class="clickable" style="cursor: pointer;">
              <strong><%= group.title %></strong>
              <span class="cell-secondary">(<%= group.actions.length %>)</span>
            </summary>
            <div class="table-scroll" style="margin-top: var(--space-2);">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Действие</th>
                    <th class="th-120">Всегда</th>
                    <th class="th-120">Не писать</th>
                  </tr>
                </thead>
                <tbody>
                  <% group.actions.forEach((a) => {
                    const isMuted = mutedSet.has(a.code);
                    const isForced = forceSet.has(a.code);
                  %>
                    <tr>
                      <td>
                        <%= a.label %>
                        <div class="cell-secondary"><code><%= a.code %></code></div>
                      </td>
                      <td>
                        <label class="checkbox-row">
                          <input type="checkbox"
                            name="auditForceLogActions"
                            value="<%= a.code %>"
                            data-audit-row="<%= a.code %>"
                            data-audit-role="force"
                            <%= isForced ? 'checked' : '' %>>
                        </label>
                      </td>
                      <td>
                        <label class="checkbox-row">
                          <input type="checkbox"
                            name="auditMutedActions"
                            value="<%= a.code %>"
                            data-audit-row="<%= a.code %>"
                            data-audit-role="mute"
                            <%= isMuted ? 'checked' : '' %>>
                        </label>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </details>
        <% }) %>
      </div>
    </details>
    <!-- ═══════════════ Файлы ═══════════════ -->
    <details class="settings-collapsible">
      <summary>
        <span>Файлы</span>
        <% if (rateMbps > 0) { %>
          <span class="status-badge status-info"><%= rateMbps %> Мбит/с</span>
        <% } %>
      </summary>
      <div class="settings-collapsible-body">
        <div class="form-grid">
          <label for="s-files-mb" class="form-label">Макс. размер одного файла (МБ)</label>
          <div class="field">
            <input type="number" id="s-files-mb" name="filesMaxSizeMb"
              min="1" max="1000" value="<%= current['files.maxSizeMb'] %>">
          </div>
          <label for="s-files-count" class="form-label">Макс. файлов за одну загрузку</label>
          <div class="field">
            <input type="number" id="s-files-count" name="filesMaxFilesPerUpload"
              min="1" max="50" value="<%= current['files.maxFilesPerUpload'] %>">
            <div class="hint">Применяется на следующем запросе — перезапуск не нужен.</div>
          </div>
          <label for="s-files-rate" class="form-label">Ограничение скорости загрузки (Мбит/с)</label>
          <div class="field">
            <input type="number" id="s-files-rate" name="filesUploadRateLimitMbps"
              min="0" max="10000" step="1" value="<%= rateMbps %>">
            <div class="hint">
              <strong>0</strong> — без ограничения (по умолчанию).<br>
              Действует на всех загрузках: работы, лекции, задания, чаты, поддержка.
              Применяется сразу, без перезапуска.<br>
              Соответствие: <code>8</code> Мбит/с = 1 МБ/с, <code>40</code> Мбит/с = 5 МБ/с,
              <code>80</code> Мбит/с = 10 МБ/с.
            </div>
          </div>
          <label for="s-files-ext" class="form-label">Разрешённые расширения</label>
          <div class="field">
            <textarea id="s-files-ext" name="filesUploadExtensions" rows="3"
              maxlength="2000"><%= (current['files.uploadExtensions'] || []).join(', ') %></textarea>
            <div class="hint">
              Через запятую, с точкой. Например: <code>.pdf, .docx, .png, .mp4</code>.<br>
              Для загрузки видео файлом к теме добавьте <code>.mp4</code> (или <code>.webm</code>).
            </div>
          </div>
        </div>
      </div>
    </details>
    <!-- ═══════════════ Редактор тем (Quill) ═══════════════ -->
    <details class="settings-collapsible">
      <summary>
        <span>Редактор тем (Quill)</span>
        <span class="status-badge status-info"><%= quillSelected.size %> из <%= quillGroupsList.length %> групп</span>
      </summary>
      <div class="settings-collapsible-body">
        <div class="info-box info-box-blue">
          <strong>Группы кнопок тулбара.</strong> Если группа не отмечена — её кнопок
          не будет в редакторе. Это влияет только на преподавателей; уже сохранённый
          HTML отображается студентам как есть (если тег разрешён санитайзером).<br>
          <strong>Ссылки, Картинки, Формулы</strong> — три независимые группы.
          Раньше это была одна группа «Медиа»: снять её — терялись все три кнопки
          сразу. Теперь можно отключить, например, только формулы, а картинки
          оставить.<br>
          <strong>Видео</strong> в редакторе нет (ни кнопки, ни тега) — загружайте
          видео файлом к теме через форму прикрепления, оно появится у студента
          в «Материалах».<br>
          <strong>Таблица</strong> — отдельная кнопка с плавающей панелью
          (добавить строку/столбец, удалить). Не входит в список групп.
        </div>
        <div class="form-grid">
          <span class="form-label">Группы кнопок</span>
          <div class="field">
            <% quillGroupsList.forEach((g) => { %>
              <label class="checkbox-row">
                <input type="checkbox" name="quillToolbarGroups" value="<%= g %>"
                  <%= quillSelected.has(g) ? 'checked' : '' %>>
                <span><%= quillLabels[g] || g %></span>
              </label>
            <% }) %>
            <div class="hint">Снимайте галочки, чтобы упростить редактор для преподавателей.</div>
          </div>
          <span class="form-label">Таблица</span>
          <div class="field">
            <label class="checkbox-row">
              <input type="hidden" name="quillTableEnabled" value="0">
              <input type="checkbox" name="quillTableEnabled" value="1"
                <%= current['quill.tableEnabled'] !== false ? 'checked' : '' %>>
              <span>Кнопка «Таблица» в тулбаре</span>
            </label>
          </div>
        </div>
      </div>
    </details>
    <!-- ═══════════════ Чаты ═══════════════ -->
    <details class="settings-collapsible">
      <summary>
        <span>Чаты</span>
      </summary>
      <div class="settings-collapsible-body">
        <div class="info-box info-box-blue info-box-how">
          Лимит применяется ко всем чатам: по работам, групповым и в поддержке.
          При достижении лимита отправка блокируется на указанное время.
          Настройки применяются на следующем запросе — перезапуск не нужен.
        </div>
        <div class="form-grid">
          <label for="s-chat-max" class="form-label">Макс. сообщений за окно</label>
          <div class="field">
            <input type="number" id="s-chat-max" name="chatRateLimitMax"
              min="1" max="1000" value="<%= current['chat.messageRateLimitMax'] %>">
            <div class="hint">По умолчанию — 30.</div>
          </div>
          <label for="s-chat-window" class="form-label">Окно (минут)</label>
          <div class="field">
            <input type="number" id="s-chat-window" name="chatRateLimitWindowMin"
              min="1" max="10080" value="<%= current['chat.messageRateLimitWindowMin'] %>">
            <div class="hint">По умолчанию — 1 минута.</div>
          </div>
          <label for="s-chat-block" class="form-label">Блокировка (минут)</label>
          <div class="field">
            <input type="number" id="s-chat-block" name="chatRateLimitBlockMin"
              min="1" max="10080" value="<%= current['chat.messageRateLimitBlockMin'] %>">
            <div class="hint">Сколько не пускать после превышения лимита. По умолчанию — 1 минута.</div>
          </div>
        </div>
      </div>
    </details>
    <!-- ═══════════════ Сдача работ ═══════════════ -->
    <details class="settings-collapsible">
      <summary>
        <span>Сдача работ</span>
      </summary>
      <div class="settings-collapsible-body">
        <div class="info-box info-box-blue info-box-how">
          Лимит на отправку работы студентом (POST /submit). Считается по пользователю.
          При достижении лимита отправка блокируется на указанное время.
          Настройки применяются на следующем запросе — перезапуск не нужен.
        </div>
        <div class="form-grid">
          <label for="s-submit-max" class="form-label">Макс. сдач за окно</label>
          <div class="field">
            <input type="number" id="s-submit-max" name="submitRateLimitMax"
              min="1" max="1000" value="<%= current['submit.rateLimitMax'] %>">
            <div class="hint">По умолчанию — 30.</div>
          </div>
          <label for="s-submit-window" class="form-label">Окно (минут)</label>
          <div class="field">
            <input type="number" id="s-submit-window" name="submitRateLimitWindowMin"
              min="1" max="10080" value="<%= current['submit.rateLimitWindowMin'] %>">
            <div class="hint">По умолчанию — 1 минута.</div>
          </div>
          <label for="s-submit-block" class="form-label">Блокировка (минут)</label>
          <div class="field">
            <input type="number" id="s-submit-block" name="submitRateLimitBlockMin"
              min="1" max="10080" value="<%= current['submit.rateLimitBlockMin'] %>">
            <div class="hint">Сколько не пускать после превышения лимита. По умолчанию — 1 минута.</div>
          </div>
        </div>
      </div>
    </details>
    <!-- ═══════════════ Обратная связь ═══════════════ -->
    <details class="settings-collapsible">
      <summary>
        <span>Обратная связь</span>
      </summary>
      <div class="settings-collapsible-body">
        <div class="form-grid">
          <label for="s-fb-max" class="form-label">Макс. сообщений с одного IP</label>
          <div class="field">
            <input type="number" id="s-fb-max" name="feedbackRateLimitMax"
              min="1" max="100" value="<%= current['feedback.rateLimitMax'] %>">
            <div class="hint">За указанное окно. Защита от спама в форме /feedback.</div>
          </div>
          <label for="s-fb-window" class="form-label">Окно (минут)</label>
          <div class="field">
            <input type="number" id="s-fb-window" name="feedbackRateLimitWindowMin"
              min="1" max="10080" value="<%= current['feedback.rateLimitWindowMin'] %>">
            <div class="hint">Например, 60 — один час. 10080 — неделя.</div>
          </div>
        </div>
      </div>
    </details>
    <!-- ═══════════════ Колледж ═══════════════ -->
    <!-- ═══════════════ Колледж ═══════════════ -->
    <details class="settings-collapsible">
      <summary>
        <span>Колледж</span>
      </summary>
      <div class="settings-collapsible-body">
        <div class="form-grid">
          <label for="s-c-short" class="form-label">Короткое имя (SHORT)</label>
          <div class="field">
            <input type="text" id="s-c-short" name="collegeShort" maxlength="50"
              value="<%= current['college.short'] %>">
          </div>
          <label for="s-c-short-name" class="form-label">SHORT_NAME</label>
          <div class="field">
            <input type="text" id="s-c-short-name" name="collegeShortName" maxlength="300"
              value="<%= current['college.shortName'] %>">
          </div>
          <label for="s-c-name" class="form-label">Полное официальное название (NAME)</label>
          <div class="field">
            <input type="text" id="s-c-name" name="collegeName" maxlength="300"
              value="<%= current['college.name'] %>">
          </div>
          <label for="s-c-sys" class="form-label">SYSTEM_NAME</label>
          <div class="field">
            <input type="text" id="s-c-sys" name="collegeSystemName" maxlength="50"
              value="<%= current['college.systemName'] %>">
          </div>
          <label for="s-c-sys-full" class="form-label">SYSTEM_FULL</label>
          <div class="field">
            <input type="text" id="s-c-sys-full" name="collegeSystemFull" maxlength="200"
              value="<%= current['college.systemFull'] %>">
          </div>
          <label for="s-c-addr" class="form-label">Адрес</label>
          <div class="field">
            <input type="text" id="s-c-addr" name="collegeAddress" maxlength="300"
              value="<%= current['college.address'] %>">
          </div>
          <label for="s-c-phone" class="form-label">Телефон</label>
          <div class="field">
            <input type="text" id="s-c-phone" name="collegePhone" maxlength="50"
              value="<%= current['college.phone'] %>">
          </div>
          <label for="s-c-email" class="form-label">Email</label>
          <div class="field">
            <input type="email" id="s-c-email" name="collegeEmail" maxlength="200"
              value="<%= current['college.email'] %>">
          </div>
          <label for="s-c-site" class="form-label">Сайт</label>
          <div class="field">
            <input type="url" id="s-c-site" name="collegeSite" maxlength="300"
              value="<%= current['college.site'] %>">
          </div>
          <label for="s-c-tz" class="form-label">Часовой пояс</label>
          <div class="field">
            <input type="text" id="s-c-tz" name="collegeTimezone" maxlength="100"
              list="college-tz-list"
              value="<%= current['college.timezone'] || 'Asia/Irkutsk' %>">
            <datalist id="college-tz-list">
              <option value="Europe/Kaliningrad">Europe/Kaliningrad (UTC+2)</option>
              <option value="Europe/Moscow">Europe/Moscow (UTC+3)</option>
              <option value="Europe/Volgograd">Europe/Volgograd (UTC+3)</option>
              <option value="Europe/Astrakhan">Europe/Astrakhan (UTC+4)</option>
              <option value="Europe/Saratov">Europe/Saratov (UTC+4)</option>
              <option value="Europe/Ulyanovsk">Europe/Ulyanovsk (UTC+4)</option>
              <option value="Europe/Samara">Europe/Samara (UTC+4)</option>
              <option value="Asia/Yekaterinburg">Asia/Yekaterinburg (UTC+5)</option>
              <option value="Asia/Omsk">Asia/Omsk (UTC+6)</option>
              <option value="Asia/Novosibirsk">Asia/Novosibirsk (UTC+7)</option>
              <option value="Asia/Barnaul">Asia/Barnaul (UTC+7)</option>
              <option value="Asia/Tomsk">Asia/Tomsk (UTC+7)</option>
              <option value="Asia/Krasnoyarsk">Asia/Krasnoyarsk (UTC+7)</option>
              <option value="Asia/Irkutsk">Asia/Irkutsk (UTC+8)</option>
              <option value="Asia/Chita">Asia/Chita (UTC+9)</option>
              <option value="Asia/Yakutsk">Asia/Yakutsk (UTC+9)</option>
              <option value="Asia/Vladivostok">Asia/Vladivostok (UTC+10)</option>
              <option value="Asia/Magadan">Asia/Magadan (UTC+11)</option>
              <option value="Asia/Sakhalin">Asia/Sakhalin (UTC+11)</option>
              <option value="Asia/Kamchatka">Asia/Kamchatka (UTC+12)</option>
              <option value="Asia/Anadyr">Asia/Anadyr (UTC+12)</option>
            </datalist>
            <div class="hint">
              IANA-зона, например <code>Asia/Irkutsk</code>. Используется для показа
              дат в интерфейсе и для ввода дедлайнов / «Доступно с». В БД всё хранится в UTC.
              Можно выбрать из списка или ввести вручную.
            </div>
          </div>
        </div>
      </div>
    </details>
    <div class="actions-row" style="margin-top: var(--space-4);">
      <button type="submit" class="btn btn-primary">Сохранить настройки</button>
      <a href="/admin" class="btn btn-ghost">Отмена</a>
    </div>
  </form>
</div>
<script>
  document.addEventListener('change', (e) => {
    const cb = e.target.closest('input[data-audit-row]');
    if (!cb) return;
    const row = cb.dataset.auditRow;
    const role = cb.dataset.auditRole;
    if (!cb.checked) return;
    const other = role === 'force' ? 'mute' : 'force';
    const otherEl = document.querySelector(
      `input[data-audit-row="${CSS.escape(row)}"][data-audit-role="${other}"]`
    );
    if (otherEl && otherEl.checked) otherEl.checked = false;
  });
  document.addEventListener('change', (e) => {
    const cb = e.target;
    if (!cb || cb.name !== 'auditExtended') return;
    const all = document.querySelector('input[name="auditExtendedAll"][type="checkbox"]');
    if (!all) return;
    if (!cb.checked) {
      if (all.checked) all.checked = false;
      all.disabled = true;
    } else {
      all.disabled = false;
    }
  });
</script>

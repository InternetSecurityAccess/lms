<%- include('../layout/header', { title: 'Корзина' }) %>
<div class="content-wrapper">
  <%- include('../shared/page-top', {
    title: 'Корзина',
    actions: [{ href: '/admin', label: '← В админку' }],
    flashes: [
      ...(restored ? [{ type: 'green', text: 'Восстановлено.' }] : []),
      ...(purged ? [{ type: 'yellow', text: '<strong>Удалено навсегда.</strong> Файлы стёрты с диска.' }] : []),
      ...(purgeErrors ? [{ type: 'red', text: 'Ошибка: ' + purgeErrors }] : [])
    ]
  }) %>
  <div class="info-box info-box-blue info-box-how">
    Здесь всё, что было удалено. «Восстановить» — вернуть (<code>deleted_at = NULL</code>).<br>
    <strong>«Удалить навсегда»</strong> — стереть строку и файлы с диска. Необратимо.
    Всего в корзине: <strong><%= total %></strong>.
  </div>
  <% if (groups.length === 0) { %>
    <%- include('../shared/ui/empty-state', { primary: 'Корзина пуста.' }) %>
  <% } else { %>
    <% groups.forEach((g) => { %>
      <section class="card mb-3">
        <div class="card-header">
          <h2><%= g.label %> (<%= g.rows.length %>)</h2>
        </div>
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th class="th-50">ID</th>
                <th>Название</th>
                <th class="th-160">Удалено</th>
                <th class="th-260"></th>
              </tr>
            </thead>
            <tbody>
              <% g.rows.forEach((r) => { %>
                <tr>
                  <td class="cell-secondary"><%= r.id %></td>
                  <td>
                    <div class="cell-primary"><%= r.title %></div>
                    <% if (r.subtitle) { %><div class="cell-secondary"><%= r.subtitle %></div><% } %>
                  </td>
                  <td class="cell-secondary text-nowrap"><%= formatDate(r.deleted_at, true) %></td>
                  <td>
                    <div class="actions-row actions-nowrap">
                      <form method="POST" action="/admin/trash/<%= g.kind %>/<%= r.id %>/restore"
                        class="inline-form"
                        data-confirm="Восстановить «<%= r.title %>»?"
                        data-confirm-ok-text="Восстановить"
                        data-confirm-ok-class="success">
                        <button type="submit" class="btn btn-success btn-sm">Восстановить</button>
                      </form>
                      <form method="POST" action="/admin/trash/<%= g.kind %>/<%= r.id %>/hard-delete"
                        class="inline-form"
                        data-confirm="Удалить «<%= r.title %>» НАВСЕГДА? Файлы будут стёрты с диска. Необратимо."
                        data-confirm-ok-text="Удалить"
                        data-confirm-ok-class="danger">
                        <button type="submit" class="btn btn-danger btn-sm">Удалить навсегда</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    <% }) %>
  <% } %>
</div>
<%- include('../layout/footer') %>
<%- include('../../layout/header', { title: 'Группы' }) %>
<%
  const baseQuery = { q: q || '', status: status || 'active', sort: sort || 'name_asc' };
  const redirectTo = buildUrl('/admin/groups', baseQuery);
  const flashes = [];
  if (created) flashes.push({ type: 'green', text: 'Группа создана.' });
  if (renamed) flashes.push({ type: 'green', text: 'Название изменено.' });
  if (finishedDone) flashes.push({ type: 'green', text: 'Статус группы изменён.' });
  if (deletedDone) flashes.push({ type: 'yellow', text: '<strong>Группа перемещена в корзину.</strong> Восстановить можно в <a href="/admin/trash">/admin/trash</a>.' });
%>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: 'Группы',
    actions: [
      { href: '/admin/trash', label: 'Корзина', class: 'btn-ghost btn-sm' },
      { href: '/admin', label: '← В админку' }
    ],
    flashes
  }) %>
  <div class="info-box info-box-blue info-box-how">
    Группа — учебная единица студентов. <strong>«Завершить»</strong> делает группу только для чтения
    (для выпускников): студенты остаются в ней, но новые действия недоступны.
    <strong>«В корзину»</strong> — soft-delete. Файлы не удаляются, восстановление — из корзины.
  </div>
  <section class="card">
    <div class="card-header"><h2>Добавить группу</h2></div>
    <form action="/admin/groups" method="POST" class="inline-add-form">
      <input type="text" name="name" required maxlength="50"
        placeholder="Например: ИС-25" class="search-input-260">
      <button type="submit" class="btn btn-success">Добавить</button>
    </form>
    <div class="hint">Название должно быть уникальным, до 50 символов.</div>
  </section>
  <section class="card">
    <div class="tabs">
      <a href="<%= buildUrl('/admin/groups', baseQuery, { status: 'active' }) %>"
         class="tab <%= status === 'active' ? 'active' : '' %>">Активные (<%= counts.active %>)</a>
      <a href="<%= buildUrl('/admin/groups', baseQuery, { status: 'finished' }) %>"
         class="tab <%= status === 'finished' ? 'active' : '' %>">Завершённые (<%= counts.finished %>)</a>
      <a href="<%= buildUrl('/admin/groups', baseQuery, { status: 'all' }) %>"
         class="tab <%= status === 'all' ? 'active' : '' %>">Все (<%= counts.all %>)</a>
    </div>
    <form method="GET" action="/admin/groups" class="inline-add-form">
      <input type="hidden" name="status" value="<%= status %>">
      <input type="search" name="q" value="<%= q %>" placeholder="Поиск по названию"
        maxlength="100" class="search-input-260">
      <select name="sort">
        <option value="name_asc" <%= sort === 'name_asc' ? 'selected' : '' %>>По названию (А→Я)</option>
        <option value="name_desc" <%= sort === 'name_desc' ? 'selected' : '' %>>По названию (Я→А)</option>
        <option value="date_desc" <%= sort === 'date_desc' ? 'selected' : '' %>>Сначала новые</option>
        <option value="date_asc" <%= sort === 'date_asc' ? 'selected' : '' %>>Сначала старые</option>
      </select>
      <button type="submit" class="btn btn-primary btn-sm">Найти</button>
      <% if (q) { %>
        <a href="<%= buildUrl('/admin/groups', baseQuery, { q: '' }) %>" class="btn btn-ghost btn-sm">Сбросить</a>
      <% } %>
    </form>
<%- include('../../shared/ui/bulk-toolbar', {
  entity: 'groups',
  scope: 'groups',
  actions: [
    {
      href: '/admin/bulk-finish',
      label: 'Завершить',
      class: 'btn-warning btn-sm',
      method: 'POST',
      confirm: 'Завершить выбранные группы? Студенты останутся, но статус станет «Завершена».',
      okText: 'Завершить',
      okClass: 'warning'
    },
    {
      href: '/admin/bulk-activate',
      label: 'Возобновить',
      class: 'btn-success btn-sm',
      method: 'POST',
      confirm: 'Возобновить выбранные группы?'
    },
    {
      href: '/admin/bulk-delete',
      label: 'В корзину',
      class: 'btn-danger btn-sm',
      method: 'POST',
      confirm: 'Переместить выбранные группы в корзину? Файлы сохранятся, восстановить можно в /admin/trash.',
      okText: 'В корзину',
      okClass: 'danger'
    }
  ]
}) %>
    <div class="info-box info-box-blue">
      Клик по названию открывает карточку: переименование, статус, удаление в корзину.
    </div>
    <div class="card-header"><h2>Список (<%= groups.length %>)</h2></div>
    <% if (groups.length === 0) { %>
      <%- include('../../shared/ui/empty-state', {
        primary: (q || status !== 'active') ? 'Ничего не найдено.' : 'Групп пока нет.',
        action: q ? { href: buildUrl('/admin/groups', baseQuery, { q: '' }), label: 'Сбросить поиск' } : null,
        wrapper: false
      }) %>
    <% } else { %>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th class="bulk-th"><input type="checkbox" data-bulk-all aria-label="Выбрать всех"></th>
              <th class="th-50">ID</th>
              <th>Название</th>
              <th class="th-100">Студентов</th>
              <th class="th-120">Преподавателей</th>
              <th class="th-100">Предметов</th>
              <th class="th-100">Работ</th>
              <th class="th-100">Статус</th>
            </tr>
          </thead>
          <tbody>
            <% groups.forEach((g) => {
              const hasData = g.students_count > 0 || g.works_count > 0
                || g.teachers_count > 0 || g.subjects_count > 0
                || g.announcements_count > 0 || g.threads_count > 0;
              const isActive = g.status === 'active';
            %>
              <tr class="<%= !isActive ? 'cell-secondary' : '' %>">
                <td class="bulk-td"><input type="checkbox" data-bulk-checkbox data-bulk-scope="groups" value="<%= g.id %>" aria-label="Выбрать группу <%= g.name %>"></td>
                <td><%= g.id %></td>
                <td>
                  <button type="button" class="link-button"
                          data-modal-open="group-modal-<%= g.id %>"
                          title="Открыть карточку">
                    <%= g.name %>
                  </button>
                </td>
                <td><%= g.students_count %></td>
                <td><%= g.teachers_count %></td>
                <td><%= g.subjects_count %></td>
                <td><%= g.works_count %></td>
                <td>
                  <span class="status-badge <%= isActive ? 'status-success' : 'status-muted' %>">
                    <%= isActive ? 'активна' : 'завершена' %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../../shared/ui/paginator', {
        page, pages, total,
        urlFn: (p) => buildUrl('/admin/groups', baseQuery, { page: p > 1 ? p : '' })
      }) %>
    <% } %>
  </section>
</div>

<%# ═══════════════ МОДАЛКИ РЕДАКТИРОВАНИЯ ═══════════════ %>
<% groups.forEach((g) => {
  const hasData = g.students_count > 0 || g.works_count > 0
    || g.teachers_count > 0 || g.subjects_count > 0
    || g.announcements_count > 0 || g.threads_count > 0;
  const isActive = g.status === 'active';
%>
  <div class="modal" id="group-modal-<%= g.id %>" hidden role="dialog" aria-modal="true"
       aria-labelledby="group-modal-title-<%= g.id %>">
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 id="group-modal-title-<%= g.id %>">
          Группа #<%= g.id %>
        </h3>
        <button type="button" class="modal-close" data-modal-close aria-label="Закрыть">✕</button>
      </div>

      <div class="modal-section">
        <h4>Название</h4>
        <form method="POST" action="/admin/groups/<%= g.id %>/rename"
              class="form-row"
              data-confirm="Переименовать группу «<%= g.name %>»?">
          <input type="hidden" name="redirect" value="<%= redirectTo %>">
          <input type="text" name="name" value="<%= g.name %>"
                 required maxlength="50" placeholder="Название группы">
          <button type="submit" class="btn btn-success btn-sm">Сохранить</button>
        </form>
        <div class="hint">Название должно быть уникальным, до 50 символов.</div>
      </div>

      <div class="modal-section">
        <h4>Состав</h4>
        <div class="info-list">
          <div><strong>Студентов</strong><span><%= g.students_count %></span></div>
          <div><strong>Преподавателей</strong><span><%= g.teachers_count %></span></div>
          <div><strong>Предметов</strong><span><%= g.subjects_count %></span></div>
          <div><strong>Работ</strong><span><%= g.works_count %></span></div>
          <div><strong>Объявлений</strong><span><%= g.announcements_count %></span></div>
        </div>
      </div>

      <div class="modal-section">
        <h4>Статус</h4>
        <div class="actions-row">
          <span class="status-badge <%= isActive ? 'status-success' : 'status-muted' %>">
            <%= isActive ? 'активна' : 'завершена' %>
          </span>
          <form method="POST" action="/admin/groups/<%= g.id %>/toggle-status"
                class="inline-form"
                data-confirm="<%= isActive
                  ? 'Завершить группу «' + g.name + '»? Студенты останутся, группа станет только для чтения.'
                  : 'Возобновить группу «' + g.name + '»?' %>"
                data-confirm-ok-text="<%= isActive ? 'Завершить' : 'Возобновить' %>"
                data-confirm-ok-class="<%= isActive ? 'warning' : 'success' %>">
            <button type="submit" class="btn <%= isActive ? 'btn-warning' : 'btn-success' %> btn-sm">
              <%= isActive ? 'Завершить' : 'Возобновить' %>
            </button>
          </form>
        </div>
        <div class="hint">
          Завершённая группа даёт студентам readonly-доступ к истории. Новые студенты в неё не регистрируются.
        </div>
      </div>

      <div class="modal-section">
        <h4>Удаление</h4>
        <form method="POST" action="/admin/groups/<%= g.id %>/delete"
              class="form-row"
              data-confirm="<%= (hasData
                ? 'В группе «' + g.name + '» есть данные. Группа будет перемещена в корзину. '
                : 'Переместить группу «' + g.name + '» в корзину? ')
                + 'Восстановить можно в /admin/trash.' %>"
              data-confirm-ok-text="В корзину"
              data-confirm-ok-class="danger">
          <button type="submit" class="btn btn-danger btn-sm">В корзину</button>
        </form>
        <div class="hint">
          Soft-delete. Данные и файлы сохраняются, восстановить можно из
          <a href="/admin/trash">корзины</a>.
        </div>
      </div>

      <div class="actions-row" style="justify-content: flex-end; margin-top: var(--space-3);">
        <button type="button" class="btn btn-ghost" data-modal-close>Закрыть</button>
      </div>
    </div>
  </div>
<% }) %>

<%- include('../../layout/footer') %>
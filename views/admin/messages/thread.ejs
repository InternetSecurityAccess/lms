<%- include('../../layout/header', { title: 'Обращение' }) %>
<div class="content-wrapper">
  <div class="top-bar">
    <h1 class="top-bar-title"><%= thread.student_name || thread.teacher_name || 'Пользователь' %></h1>
    <div class="top-bar-actions">
      <a href="/admin/support" class="btn btn-ghost">← К списку</a>
    </div>
  </div>
  <div class="info-box info-box-blue info-box-how">
    Ваш ответ <strong>увидит только этот пользователь</strong> — в разделе
    «Поддержка» при следующем визите. Другие пользователи и администраторы
    переписку не видят. Скриншот прикрепляется вставкой из буфера:
    <kbd>Ctrl</kbd>+<kbd>V</kbd>.
  </div>
  <% if (deletedMsgId) { %>
    <div class="info-box info-box-yellow" role="status">Сообщение удалено.</div>
  <% } %>
  <% if (cleared) { %>
    <div class="info-box info-box-yellow" role="status">Чат очищен.</div>
  <% } %>
  <div class="info-box info-box-blue">
    <strong><%= thread.student_id ? 'Студент' : 'Преподаватель' %></strong>
    · Обращение создано <%= formatDate(thread.created_at, true) %>
  </div>
  <section class="card">
    <div class="card-header">
      <h2>Переписка</h2>
      <div class="chat-meta">
        <span>Сообщений: <strong id="supportMessageCount"><%= messages.length %></strong></span>
        <span id="supportLastUpdate"></span>
      </div>
    </div>
    <div class="chat-toolbar gap-2 items-center flex-wrap">
      <form method="GET" action="/admin/support/<%= thread.id %>" class="inline-add-form search-input-240 m-0">
        <input type="search" name="q" value="<%= q || '' %>" maxlength="200"
          placeholder="Поиск по сообщениям" class="search-input-180">
        <button type="submit" class="btn btn-primary btn-sm">Найти</button>
        <% if (q) { %>
          <a href="/admin/support/<%= thread.id %>" class="btn btn-ghost btn-sm">Сбросить</a>
        <% } %>
      </form>
      <% if (messages.length > 0) { %>
        <form method="POST" action="/admin/support/<%= thread.id %>/clear" class="inline-form"
          data-confirm="Очистить всю переписку? Все сообщения и скриншоты будут удалены. Необратимо."
          data-confirm-ok-text="Очистить"
          data-confirm-ok-class="danger">
          <button type="submit" class="btn btn-danger btn-sm">🗑 Очистить</button>
        </form>
      <% } %>
      <button type="button" class="btn btn-secondary btn-sm" id="supportRefreshBtn" >
        <span class="spinner"></span> ↻ Обновить
      </button>
    </div>
    <% if (q) { %>
      <div class="info-box info-box-blue">Найдено: <strong><%= messages.length %></strong> по запросу «<%= q %>».</div>
    <% } %>
    <div id="supportMessages" class="messages-list" aria-live="polite">
      <% if (messages.length === 0) { %>
        <div class="empty-state"><%= q ? 'Ничего не найдено.' : 'Сообщений пока нет.' %></div>
      <% } else { %>
        <% messages.forEach((m) => {
             const isOwn = m.sender_type === 'admin';
        %>
          <article class="message <%= isOwn ? 'is-own' : 'is-other' %> <%= m.deleted_at ? 'message-deleted' : '' %>" data-id="<%= m.id %>">
            <div class="message-header">
              <span class="message-sender">
                <%= m.sender_name %><%= m.sender_type === 'admin' ? ' (админ)' : '' %>
              </span>
              <div class="actions-row gap-2">
                <time class="message-time"><%= formatDate(m.created_at, true) %></time>
                <% if (!m.deleted_at) { %>
                  <form method="POST" action="/admin/support/<%= thread.id %>/messages/<%= m.id %>/delete"
                    class="inline-form"
                    data-confirm="Удалить сообщение?"
                    data-confirm-ok-text="Удалить"
                    data-confirm-ok-class="danger">
                    <button type="submit" class="btn-delete-message" title="Удалить">×</button>
                  </form>
                <% } %>
              </div>
            </div>
            <% if (m.deleted_at) { %>
              <div class="message-text message-text-deleted">Сообщение удалено</div>
            <% } else { %>
              <% if (m.message) { %><div class="message-text"><%- renderText(m.message) %></div><% } %>
              <% if (m.file_path) { %>
                <% const supFile = m.file_path.split('/').pop(); %>
                <% const supName = m.file_name || 'screenshot.png'; %>
                <div class="message-file">
                  <a href="/support/image/<%= encodeURIComponent(supFile) %>"
                     class="support-image-link"
                     data-file-preview
                     data-file-name="<%= supName %>"
                     data-view-url="/support/image/<%= encodeURIComponent(supFile) %>"
                     data-download-url="/support/image/<%= encodeURIComponent(supFile) %>">
                    <img class="support-image"
                         src="/support/image/<%= encodeURIComponent(supFile) %>"
                         alt="<%= supName %>">
                  </a>
                </div>
              <% } %>
            <% } %>
          </article>
        <% }) %>
      <% } %>
    </div>
    <form id="supportForm" action="/admin/support/<%= thread.id %>" method="POST" class="mt-3">
      <div class="form-grid">
        <label for="support-msg" class="form-label">Ответ</label>
        <div class="field">
          <textarea id="support-msg" name="message" maxlength="5000" rows="3"
            placeholder="Ответ пользователю"></textarea>
          <div class="hint">
            Скриншот можно прикрепить вставкой из буфера: <kbd>Ctrl</kbd>+<kbd>V</kbd>.
          </div>
          <div id="supportAttachment" class="support-attachment" hidden>
            <div class="support-attachment-preview">
              <img id="supportAttachmentPreview" alt="предпросмотр скриншота">
            </div>
            <div class="support-attachment-info">
              <div class="support-attachment-name" id="supportAttachmentName"></div>
              <button type="button" class="btn btn-ghost btn-sm" id="supportAttachmentRemove">Убрать</button>
            </div>
            <input type="hidden" name="file_path" value="">
            <input type="hidden" name="file_name" value="">
          </div>
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-success">Отправить</button>
        </div>
      </div>
    </form>
  </section>
</div>
<div id="supportToast" class="toast"></div>
<script type="application/json" id="support-init-data"><%- JSON.stringify({
  messagesUrl: '/admin/support/' + thread.id + '/messages.json' + (q ? '?q=' + encodeURIComponent(q) : ''),
  viewerRole: 'admin',
  threadId: thread.id
}).replace(/</g, '\\u003c') %></script>
<script src="/js/support.js" defer></script>
<%- include('../../shared/ui/file-viewer') %>
<%- include('../../layout/footer') %>
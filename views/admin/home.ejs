<%- include('../layout/header', { title: 'Админка' }) %>
<div class="content-wrapper">
  <div class="top-bar">
    <h1 class="top-bar-title">Админка</h1>
    <div class="top-bar-actions">
      <a href="/admin/settings" class="btn btn-ghost btn-sm">Настройки</a>
      <a href="/admin/audit" class="btn btn-ghost btn-sm">Аудит</a>
      <a href="/admin/sessions" class="btn btn-ghost btn-sm">Сессии</a>
      <a href="/admin/trash" class="btn btn-ghost btn-sm">Корзина</a>
      <a href="/admin/import-export" class="btn btn-ghost btn-sm">Импорт/экспорт</a>
    </div>
  </div>
  <%# Плитки внимания %>
  <div class="admin-dashboard-grid">
    <a href="/admin/approvals"
       class="admin-tile <%= stats.pendingApprovals > 0 ? 'is-warning' : 'is-ok' %>">
      <div class="admin-tile-icon">📝</div>
      <div class="admin-tile-body">
        <div class="admin-tile-label">Заявки на регистрацию</div>
        <div class="admin-tile-value"><%= stats.pendingApprovals %></div>
      </div>
    </a>
    <a href="/admin/works?status=pending"
       class="admin-tile <%= stats.pendingWorks > 0 ? 'is-warning' : 'is-ok' %>">
      <div class="admin-tile-icon">📋</div>
      <div class="admin-tile-body">
        <div class="admin-tile-label">Работ на проверке</div>
        <div class="admin-tile-value"><%= stats.pendingWorks %></div>
      </div>
    </a>
    <a href="/admin/support"
       class="admin-tile <%= stats.supportUnread > 0 ? 'is-warning' : 'is-ok' %>">
      <div class="admin-tile-icon">💬</div>
      <div class="admin-tile-body">
        <div class="admin-tile-label">Обращений в поддержку</div>
        <div class="admin-tile-value"><%= stats.supportUnread %></div>
      </div>
    </a>
  </div>
  <%# Основные счётчики %>
  <div class="stats-grid">
    <a href="/admin/teachers" class="stat-card is-link">
      <div class="stat-label">Преподавателей</div>
      <div class="stat-value"><%= stats.teachers %></div>
    </a>
    <a href="/admin/students" class="stat-card is-link">
      <div class="stat-label">Студентов</div>
      <div class="stat-value"><%= stats.students %></div>
    </a>
    <a href="/admin/groups" class="stat-card is-link">
      <div class="stat-label">Групп</div>
      <div class="stat-value"><%= stats.groups %></div>
    </a>
    <a href="/admin/groups?status=finished" class="stat-card is-link">
      <div class="stat-label">Групп завершено</div>
      <div class="stat-value warning"><%= stats.finishedGroups %></div>
    </a>
    <a href="/admin/subjects" class="stat-card is-link">
      <div class="stat-label">Предметов</div>
      <div class="stat-value"><%= stats.subjects %></div>
    </a>
  </div>
  <%# Управление %>
  <section class="card">
    <div class="card-header"><h2>Управление</h2></div>
    <div class="card-grid">
      <a href="/admin/teachers" class="entity-card">
        <div class="entity-card-title">Преподаватели</div>
        <div class="entity-card-subtitle">Учётные записи, пароли, группы</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/groups" class="entity-card">
        <div class="entity-card-title">Группы</div>
        <div class="entity-card-subtitle">Создание, завершение, статистика</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/students" class="entity-card">
        <div class="entity-card-title">Студенты</div>
        <div class="entity-card-subtitle">Сброс паролей, группы, удаление</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/subjects" class="entity-card">
        <div class="entity-card-title">Предметы</div>
        <div class="entity-card-subtitle">Завершение, смена владельца, удаление</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/topics" class="entity-card">
        <div class="entity-card-title">Темы</div>
        <div class="entity-card-subtitle">Все темы всех предметов</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/works" class="entity-card">
        <div class="entity-card-title">Работы</div>
        <div class="entity-card-subtitle">Все сдачи, статусы, удаление</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/announcements" class="entity-card">
        <div class="entity-card-title">Объявления</div>
        <div class="entity-card-subtitle">Все объявления всех групп</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/approvals" class="entity-card">
        <div class="entity-card-title">Заявки</div>
        <div class="entity-card-subtitle">Подтверждение студентов</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/support" class="entity-card">
        <div class="entity-card-title">Обращения</div>
        <div class="entity-card-subtitle">Чаты поддержки</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/sessions" class="entity-card">
        <div class="entity-card-title">Сессии</div>
        <div class="entity-card-subtitle">Кто сейчас в системе</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/trash" class="entity-card">
        <div class="entity-card-title">Корзина</div>
        <div class="entity-card-subtitle">Удалённое, восстановление и hard-delete</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/settings" class="entity-card">
        <div class="entity-card-title">Настройки</div>
        <div class="entity-card-subtitle">Пароли, регистрация, файлы, колледж</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/audit" class="entity-card">
        <div class="entity-card-title">Аудит</div>
        <div class="entity-card-subtitle">Журнал критичных действий</div>
        <div class="entity-card-arrow">→</div>
      </a>
      <a href="/admin/import-export" class="entity-card">
        <div class="entity-card-title">Импорт/экспорт</div>
        <div class="entity-card-subtitle">CSV: преподаватели, студенты, группы</div>
        <div class="entity-card-arrow">→</div>
      </a>
    </div>
  </section>
</div>
<%- include('../layout/footer') %>
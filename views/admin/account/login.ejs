<%- include('../../layout/header', { title: 'Вход для администратора' }) %>
<div class="content-wrapper narrow">
  <div class="top-bar">
    <h1 class="top-bar-title">Вход для администратора</h1>
  </div>
  <% if (demoMode) { %>
    <section class="card demo-card">
      <div class="card-header"><h2>🎭 Демо-режим</h2></div>
      <form action="/demo/login-admin" method="POST">
        <button type="submit" class="demo-login-btn demo-login-admin btn-block">
          <div class="demo-login-role">Администратор</div>
          <div class="demo-login-name">Войти без пароля</div>
          <div class="demo-login-meta">Полный доступ к системе</div>
        </button>
      </form>
    </section>
  <% } %>
  <section class="card">
    <% if (error) { %>
      <div class="info-box info-box-red" role="alert"><%= error %></div>
    <% } %>
    <form action="/admin/login" method="POST" autocomplete="on">
      <div class="form-grid">
        <label for="admin-name" class="form-label">Логин</label>
        <div class="field">
          <input type="text" id="admin-name" name="name" required maxlength="200"
            value="<%= form?.name || '' %>" autocomplete="username" autofocus>
        </div>
        <label for="admin-password" class="form-label">Пароль</label>
        <div class="field">
          <input type="password" id="admin-password" name="password" required maxlength="200"
            autocomplete="current-password">
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-success btn-block">Войти</button>
        </div>
      </div>
    </form>
  </section>
</div>
<%- include('../../layout/footer') %>
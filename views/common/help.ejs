<style>
  /* Sticky-шапка (college-header) висит сверху и при прокрутке
     перекрывает верх раздела. scroll-margin-top сдвигает точку
     привязки вниз, чтобы заголовок раздела оказался под шапкой,
     а не за ней. 8rem — с запасом: верхняя строка шапки
     (логотип + кнопки) + строка навигации + воздушка.
     Применяется только на /help, чтобы не влиять на другие страницы. */
  .help-section { scroll-margin-top: 8rem; }
</style>
<script>
  // Раскрытие <details> при переходе по ссылке из «Содержания».
  //
  // Проблема: <a href="#general"> прокручивает к элементу, но
  // <details> при этом остаётся свёрнутым — пользователь видит только
  // заголовок и должен кликать ещё раз. Это стандартное поведение
  // браузера: scroll к якорю не открывает <details>.
  //
  // Решение: перехватываем клик, раскрываем <details>, обновляем URL
  // через history.replaceState (без перезагрузки и без hashchange) и
  // плавно прокручиваем к разделу. preventDefault нужен, чтобы браузер
  // не проскроллил раньше раскрытия — иначе после раскрытия позиция
  // съедет, потому что высота документа изменится.
  (function () {
    'use strict';
    const prefersReducedMotion = window.matchMedia
      && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';
    // Раскрывает <details id="...">. Возвращает элемент или null,
    // если такого нет (например, admin-раздел под не-админом).
    function openSection(id) {
      if (!id) return null;
      const el = document.getElementById(id);
      if (!el || el.tagName !== 'DETAILS') return null;
      if (!el.open) el.open = true;
      return el;
    }
    // Клик по ссылке «Содержания».
    document.addEventListener('click', function (e) {
      const a = e.target.closest('a[href^="#"]');
      if (!a) return;
      const id = a.getAttribute('href').slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      openSection(id);
      try { history.replaceState(null, '', '#' + id); } catch (err) { /* ignore */ }
      target.scrollIntoView({ behavior: scrollBehavior, block: 'start' });
    });
    // Заход по закладке с #hash (например, /help#special из закладок).
    function openFromHash() {
      const id = location.hash.replace(/^#/, '');
      if (id) openSection(id);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', openFromHash, { once: true });
    } else {
      openFromHash();
    }
    // Ручная смена хеша в адресной строке или возврат/вперёд по истории.
    window.addEventListener('hashchange', openFromHash);
  })();
</script>

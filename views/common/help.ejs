<%- include('../layout/header', { title: 'Помощь' }) %>
<%
  // role приходит из роута /help (routes/public.js). Возможные значения:
  //   'guest'   — не вошёл
  //   'student' — студент
  //   'teacher' — преподаватель
  //   'admin'   — администратор
  const isAdmin = role === 'admin';
  const isTeacher = role === 'teacher';
  const isStudent = role === 'student';
  const isGuest = role === 'guest';
  // Справочник для залогиненных: «Содержание» и «Особые ситуации» гостю
  // не нужны — там про функции, которых у него нет. Исключение — раздел
  // «Общее»: он объясняет, как войти, поэтому виден всем.
  const isAuthed = !isGuest;
  // Свой раздел раскрыт по умолчанию; для гостя — «Общее».
  const defaultSection = isAdmin ? 'admin' : isTeacher ? 'teacher' : isStudent ? 'student' : 'general';
  const actionHref = isAdmin ? '/admin' : isTeacher ? '/groups' : isStudent ? '/my-teachers' : '/login/student';
  const actionLabel = isAdmin ? 'В админку' : isTeacher ? 'К группам' : isStudent ? 'К преподавателям' : 'Войти';
%>
<div class="content-wrapper">
  <div class="top-bar">
    <h1 class="top-bar-title">Помощь</h1>
    <div class="top-bar-actions">
      <a href="<%= actionHref %>" class="btn btn-secondary"><%= actionLabel %></a>
    </div>
  </div>
  <div class="info-box info-box-blue">
    <strong>Инструкция по работе с системой.</strong>
    Ниже — все возможности: что можно делать и как это устроено.
    Каждый раздел сворачивается: нажмите на заголовок, чтобы открыть.
    <% if (isAuthed && !isAdmin) { %>
      Ваш раздел отмечен значком <span class="badge">ваш раздел</span>.
    <% } %>
  </div>
  <%# ═══════════════ НАПИСАТЬ АДМИНИСТРАТОРУ ═══════════════ %>
  <%# Идёт ПЕРЕД «Содержанием»: если человек пришёл на /help с проблемой,
      ему нужна кнопка «Открыть поддержку», а не список разделов. Навигация
      по инструкции — уже второй шаг. %>
  <% if (isAuthed && !isAdmin) { %>
    <section class="card" style="border-color: var(--accent);">
      <div class="card-header">
        <h2>Написать администратору</h2>
        <% if (supportUnreadCount > 0) { %>
          <span class="unread-badge"><%= supportUnreadCount %> новых</span>
        <% } %>
      </div>
      <p class="cell-secondary m-0">
        Что-то не работает, есть вопрос по доступу — напишите. Отвечаем в этом же окне.
      </p>
      <div class="actions-row">
        <a href="/support" class="btn btn-primary">Открыть поддержку</a>
      </div>
    </section>
  <% } %>
  <%# ═══════════════ ОГЛАВЛЕНИЕ ═══════════════ %>
  <%# Гостю не показываем: у него нет доступа к большинству разделов. %>
  <% if (isAuthed) { %>
    <section class="card">
      <div class="card-header"><h2>Содержание</h2></div>
      <div class="info-list">
        <div><strong>Общее</strong><a href="#general">О системе, вход, пароль, тема, поиск</a></div>
        <div><strong>Студент</strong><a href="#student">Регистрация, предметы, задания, чаты, история</a></div>
        <div><strong>Преподаватель</strong><a href="#teacher">Группы, предметы, темы, проверка работ</a></div>
        <% if (isAdmin) { %>
          <div><strong>Администратор</strong><a href="#admin">Пользователи, контент, корзина, аудит</a></div>
        <% } %>
        <div><strong>Особые ситуации</strong><a href="#special">История, завершение, корзина, метка ИИ</a></div>
      </div>
    </section>
  <% } %>

  <%# ═══════════════ ОБЩЕЕ ═══════════════ %>
  <details class="help-section" id="general" <%= defaultSection === 'general' ? 'open' : '' %>>
    <summary>Общее: о системе, вход, пароль, тема, поиск</summary>
    <div class="help-body">
      <h4>О системе</h4>
      <p>
        Это система управления обучением колледжа. Студенты получают материалы,
        сдают работы и переписываются с преподавателями. Преподаватели ведут
        предметы, темы и задания, проверяют работы. Администратор управляет
        пользователями, группами и содержимым.
      </p>
      <h4>Три роли</h4>
      <ul>
        <li><strong>Студент</strong> — входит через страницу <em>Вход → Студент</em>.</li>
        <li><strong>Преподаватель</strong> — входит через страницу <em>Вход → Преподаватель</em> (по email).</li>
        <li><strong>Администратор</strong> — входит по отдельной ссылке <em>Вход для администратора</em>.</li>
      </ul>
      <h4>Первый вход и смена пароля</h4>
      <p>
        При создании аккаунта администратором пароль выдаётся один раз.
        При первом входе система обяжет сменить его — остальные разделы будут
        недоступны, пока пароль не изменён. Это защита от того, чтобы временный
        пароль остался навсегда.
      </p>
      <h4>Смена пароля</h4>
      <p>
        Откройте <em>Профиль</em> (кнопка с вашим именем в шапке) → раздел
        «Смена пароля». Введите текущий и новый. Требования показаны под полем.
        После смены все остальные устройства, где вы вошли, выйдут из системы
        при следующем действии.
      </p>
      <h4>Тема оформления</h4>
      <p>
        Кнопка <em>Тема</em> в шапке переключает тёмное и светлое оформление.
        Выбор запоминается в браузере на этом устройстве.
      </p>
      <h4>Поиск</h4>
      <p>
        Кнопка <em>Поиск</em> в шапке ищет по доступным вам разделам: предметам,
        темам, заданиям, работам, объявлениям. Результаты ограничены тем, что
        вам разрешено видеть.
      </p>
      <h4>Обратная связь и поддержка</h4>
      <p>
        <em>Помощь → Написать администратору</em> — личный чат с администратором
        (доступен студентам и преподавателям).
        <em>Обратная связь</em> (ссылка в подвале) — сообщение о проблеме,
        контакт можно не указывать.
      </p>
      <h4>Файлы: что можно загружать</h4>
      <p><%= HINT_UPLOAD %></p>
      <p><strong>Скриншоты и картинки в редакторе:</strong> <%= HINT_IMAGE %></p>
      <h4>Скриншоты в поддержке</h4>
      <p>
        В чате поддержки скриншот прикладывается <strong>вставкой из буфера</strong>:
        <kbd>Win</kbd>+<kbd>Shift</kbd>+<kbd>S</kbd> → курсор в поле → <kbd>Ctrl</kbd>+<kbd>V</kbd>.
      </p>
    </div>
  </details>

  <%# ═══════════════ СТУДЕНТ ═══════════════ %>
  <details class="help-section" id="student" <%= defaultSection === 'student' ? 'open' : '' %>>
    <summary>Студенту <% if (isStudent) { %><span class="badge ml-2">ваш раздел</span><% } %></summary>
    <div class="help-body">
      <h4>Регистрация</h4>
      <ol>
        <li>Откройте <em>Вход</em> → вкладка <em>Студент</em> → <em>Регистрация</em>.</li>
        <li>Укажите ФИО полностью, выберите группу.</li>
        <li>Придумайте пароль — требования показаны под полем.</li>
      </ol>
      <div class="info-box info-box-yellow">
        <strong>Требуется подтверждение.</strong>
        После регистрации вы попадаете на страницу ожидания. Учётную запись
        подтверждает преподаватель вашей группы или администратор.
        Пока заявка не подтверждена, войти можно, но доступна только
        страница ожидания и поддержка.
      </div>
      <h4>Что видно в меню</h4>
      <ul>
        <li><strong>Мои преподаватели</strong> — те, кто ведёт вашу группу.</li>
        <li><strong>Мои предметы</strong> — активные предметы вашей группы.</li>
        <li><strong>Вся учёба</strong> — активные и завершённые предметы (история).</li>
        <li><strong>Мои задания</strong> — все активные задания по всем преподавателям.</li>
        <li><strong>Уведомления</strong> — работы, где что-то произошло.</li>
        <li><strong>Групповые чаты</strong> — чаты с преподавателями группы.</li>
        <li><strong>Объявления</strong> — важные сообщения от преподавателей.</li>
      </ul>
      <h4>Мои преподаватели</h4>
      <p>
        Карточка преподавателя с количеством предметов, работ на проверке и
        непрочитанных сообщений. Если у преподавателя указан канал MAX —
        кнопка «Канал MAX» ведёт на него.
      </p>
      <h4>Мои предметы и Вся учёба</h4>
      <p>
        <em>Мои предметы</em> — только активное: предмет активен, преподаватель
        активен, ваша группа активна. <em>Вся учёба</em> — те же предметы плюс
        завершённые: их видно, но они <strong>только для чтения</strong>.
        История сохраняется, пока администратор не удалит её навсегда.
      </p>
      <h4>Задания и их статусы</h4>
      <ul>
        <li><span class="status-badge status-pending">Не сдано</span> — работы ещё нет.</li>
        <li><span class="status-badge status-pending">На проверке</span> — ждёт преподавателя.</li>
        <li><span class="status-badge status-accepted">Принято</span> — всё, доработки не нужны.</li>
        <li><span class="status-badge status-rejected">Отклонено</span> — нужно доработать и сдать заново.</li>
        <li><span class="status-badge status-muted">Просрочено</span> — срок сдачи прошёл, но сдать можно (если преподаватель не завершил задание).</li>
      </ul>
      <h4>Как сдать работу</h4>
      <ol>
        <li>Откройте задание → «Сдать работу».</li>
        <li>Приложите файлы и/или укажите ссылку (одно из двух обязательно).</li>
        <li>Добавьте комментарий — необязательно.</li>
        <li>Нажмите «Отправить на проверку».</li>
      </ol>
      <p>
        <strong>Новая версия.</strong> Пока работа не принята, можно отправить
        новую версию — статус снова станет «На проверке». Старые файлы можно
        отметить на удаление прямо в форме сдачи; остальные сохранятся.
      </p>
      <p>
        <strong>Принятая работа.</strong> Заменить файлы нельзя. Если нужно
        что-то уточнить — напишите в переписке по работе (чат ещё открыт)
        или обратитесь в поддержку.
      </p>
      <h4>Переписка с преподавателем</h4>
      <p>
        У каждой вашей работы есть отдельный чат с преподавателем. Здесь
        обсуждаются замечания, доработки и оценки. Чат закрывается, когда работа
        принята, а также когда задание или предмет завершены.
      </p>
      <h4>Групповые чаты</h4>
      <p>
        Отдельный чат с каждым преподавателем, который ведёт вашу группу.
        Видят все студенты группы и этот преподаватель. Другие преподаватели
        переписку не видят.
      </p>
      <h4>Объявления</h4>
      <p>
        Важные сообщения от преподавателей вашей группы: переносы, срок сдачи,
        объявления о защитах. Это не чат — отвечать нельзя, но можно
        вернуться и перечитать. Прочитанные объявления помечаются автоматически.
      </p>
      <h4>Уведомления</h4>
      <p>
        Раздел <em>Уведомления</em> собирает работы, где появилось что-то новое:
        сообщение преподавателя, смена статуса, отметка «сделано с ИИ».
        Как только вы открыли работу, уведомление по ней исчезает из списка.
      </p>
      <h4>Профиль</h4>
      <p>
        Ваше ФИО, группа, логин. Логин меняет только администратор. Пароль
        меняете сами: минимум 8 символов, отличается от текущего.
      </p>
      <h4>Забыли пароль</h4>
      <p>
        Обратитесь к преподавателю вашей группы или к администратору — они
        сбросят пароль и выдадут новый. При первом входе система попросит
        сменить его.
      </p>
    </div>
  </details>

  <%# ═══════════════ ПРЕПОДАВАТЕЛЬ ═══════════════ %>
  <details class="help-section" id="teacher" <%= defaultSection === 'teacher' ? 'open' : '' %>>
    <summary>Преподавателю <% if (isTeacher) { %><span class="badge ml-2">ваш раздел</span><% } %></summary>
    <div class="help-body">
      <h4>Первый вход</h4>
      <p>
        Войдите через <em>Вход → Преподаватель</em> (по email). Сразу смените
        пароль в <em>Профиле</em> — до этого остальные разделы недоступны.
      </p>
      <h4>Группы: каталог и «Моя группа»</h4>
      <p>
        <em>Группы</em> — каталог всех групп колледжа. Отметьте «Моя группа» у
        тех, что вы ведёте. Это:
      </p>
      <ul>
        <li>добавляет группу в <em>Мои группы</em>;</li>
        <li>подписывает всех её студентов на вас (они увидят вас в «Моих преподавателях»);</li>
        <li>даёт доступ к управлению студентами этой группы (подтверждение регистрации, сброс пароля);</li>
        <li>открывает чат с группой и объявления для неё.</li>
      </ul>
      <p>
        <strong>Снятие галочки</strong> ничего не удаляет, но предметы, привязанные
        к этой группе, будут отвязаны автоматически — студенты потеряют доступ
        к новым материалам, а история сдач останется как «только для чтения».
        Система предупредит перед снятием.
      </p>
      <h4>Мои группы (рабочее место)</h4>
      <p>
        Карточка группы: сколько студентов, работ, есть ли непрочитанные
        сообщения в чате. Внутри — три вкладки: <em>Предметы</em>, <em>Студенты</em>, <em>Чат</em>.
      </p>
      <ul>
        <li><strong>Предметы</strong> — ваши предметы, привязанные к этой группе. Здесь же можно прикрепить существующий предмет.</li>
        <li><strong>Студенты</strong> — список группы. Для новых заявок: <em>Подтвердить</em> или <em>Отклонить</em> (с причиной). Для подтверждённых — <em>Сбросить пароль</em> (новый показывается один раз).</li>
        <li><strong>Чат</strong> — личный чат с группой.</li>
      </ul>
      <h4>Мои предметы</h4>
      <p>
        Предмет принадлежит вам. Внутри — темы, задания и привязка к группам.
        Создание: <em>Мои предметы → + Создать предмет</em>. После создания
        обязательно привяжите предмет к группам, иначе студенты его не увидят.
      </p>
      <p>
        <strong>«Закрыть предмет для всех»</strong> — отдельная операция.
        Студенты всех групп увидят его только для чтения; новые сдачи и
        сообщения недоступны. Используйте, когда предмет больше не ведётся.
        Обратная операция — «Возобновить».
      </p>
      <p>
        <strong>Отвязать одну группу</strong> — в карточке предмета → вкладка
        «Группы». Снимите галочку, сохраните. История сдач этой группы
        сохранится, но станет только для чтения. Используйте, когда группа
        выпустилась или у неё больше нет этого предмета.
      </p>
      <h4>Темы и задания</h4>
      <p>
        Внутри предмета — список тем. <strong>Тема</strong> — это материал
        (текст, файлы, ссылка). <strong>Тема с заданием</strong> — материал плюс
        приём работ: файлы, срок сдачи, проверка.
      </p>
      <ul>
        <li><strong>Создать тему:</strong> <em>Предмет → Темы → + Создать тему</em>. Выберите тип: «Лекция» или «Задание».</li>
        <li><strong>Импорт тем:</strong> <em>Предмет → Темы → Импорт</em>. CSV с колонками title, description, content_url, assignment_url, status. Максимум 2000 строк за раз.</li>
        <li><strong>Черновик</strong> — тема видна только вам. <strong>Опубликовано</strong> — видна студентам. <strong>Завершено</strong> — только для чтения.</li>
      </ul>
      <p>
        В редакторе темы доступны: форматирование текста, ссылки, картинки
        (загружаются на сервер), формулы, таблицы. Видео в текст темы не
        встраивается — прикрепляйте файл через блок «Материалы».
      </p>
      <h4>Проверка работ</h4>
      <p>
        Работа открывается из <em>Уведомлений</em>, из карточки группы или
        из задания. Кнопки:
      </p>
      <ul>
        <li><strong>Принять</strong> — работа закрыта, студент не может присылать новые версии и писать в чат.</li>
        <li><strong>Отклонить</strong> — студент сможет сдать новую версию и продолжить переписку.</li>
        <li><strong>Вернуть в работу</strong> — для принятой работы, если ошиблись: статус снова «Отклонена», чат открывается.</li>
        <li><strong>🤖 Сделано с ИИ</strong> — отметить, что работа выполнена с помощью искусственного интеллекта. Статус «Отклонена», студенту автоматически уходит сообщение с пояснением. Если ошиблись — «Принять» снимает метку.</li>
      </ul>
      <p>
        В карточке задания есть блок <strong>«Кто ещё не сдал»</strong> — по
        каждому студенту видно текущий статус. Перед «Завершить задание»
        полезно принять или отклонить все работы «На проверке», иначе
        студент попадёт в тупик: отклонено, а пересдать уже нельзя.
      </p>
      <h4>Групповые чаты</h4>
      <p>
        У каждого преподавателя — свой чат с каждой группой. Студенты видят
        все чаты своих преподавателей, но вашу переписку не видят другие
        преподаватели. Кнопка «Очистить» удаляет все сообщения без
        возможности восстановления.
      </p>
      <h4>Объявления</h4>
      <p>
        Объявления для конкретной группы. В отличие от чата, они не тонут в
        переписке. Студенты видят все объявления всех преподавателей группы,
        а вы — только свои. Закреплённые объявления отображаются вверху.
      </p>
      <h4>Уведомления</h4>
      <p>
        Раздел <em>Уведомления</em> собирает работы, где появилось что-то
        новое: сообщение студента, новая сдача. Как только вы открыли работу,
        уведомление исчезает из списка.
      </p>

<%- include('../../layout/header', { title: 'Все работы' }) %>
<%
  const baseQuery = {
    q: q || '',
    status: status || '',
    deleted: deleted || 'no',
    group: groupId || '',
    teacher: teacherId || ''
  };
  const redirectTo = buildUrl('/admin/works', baseQuery);
  const flashes = [];
  if (deletedDone) flashes.push({ type: 'yellow', text: '<strong>Работа перемещена в корзину.</strong> Восстановить можно в <a href="/admin/trash">/admin/trash</a>.' });
  if (statusDone) flashes.push({ type: 'green', text: 'Статус работы изменён.' });
  if (restoreDone) flashes.push({ type: 'green', text: 'Работа восстановлена из корзины.' });
  const filters = [
    { href: buildUrl('/admin/works', baseQuery, { status: '', deleted: 'no', page: '' }),  label: 'Активные',     active: !status && deleted === 'no' },
    { href: buildUrl('/admin/works', baseQuery, { status: '', deleted: 'yes', page: '' }), label: 'В корзине',    active: !status && deleted === 'yes' },
    { href: buildUrl('/admin/works', baseQuery, { status: '', deleted: 'all', page: '' }), label: 'Все',          active: !status && deleted === 'all' },
    { href: buildUrl('/admin/works', baseQuery, { status: 'pending', page: '' }),          label: 'На проверке',  active: status === 'pending' },
    { href: buildUrl('/admin/works', baseQuery, { status: 'accepted', page: '' }),         label: 'Принятые',     active: status === 'accepted' },
    { href: buildUrl('/admin/works', baseQuery, { status: 'rejected', page: '' }),         label: 'Отклонённые',  active: status === 'rejected' }
  ];
%>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: 'Все работы',
    actions: [
      { href: '/admin/trash', label: 'Корзина', class: 'btn-ghost btn-sm' },
      { href: '/admin', label: '← В админку' }
    ],
    flashes
  }) %>
  <div class="info-box info-box-blue info-box-how">
    Полный список работ по всем группам, преподавателям и студентам.
    Изменение статуса дублирует действия преподавателя.<br>
    <strong>«В корзину»</strong> — soft-delete. <strong>«Удалить навсегда»</strong> —
    из /admin/trash, стирает файлы с диска.
  </div>
  <%- include('../../shared/ui/filter-chips', { items: filters }) %>
  <form method="GET" action="/admin/works" class="inline-add-form">
    <input type="hidden" name="status" value="<%= status %>">
    <input type="hidden" name="deleted" value="<%= deleted %>">
    <input type="search" name="q" value="<%= q %>" maxlength="100"
      placeholder="Поиск по теме, ФИО, группе" class="search-input-240">
    <select name="group">
      <option value="">Все группы</option>
      <% groups.forEach((g) => { %>
        <option value="<%= g.id %>" <%= String(groupId) === String(g.id) ? 'selected' : '' %>><%= g.name %></option>
      <% }) %>
    </select>
    <select name="teacher">
      <option value="">Все преподаватели</option>
      <% teachers.forEach((t) => { %>
        <option value="<%= t.id %>" <%= String(teacherId) === String(t.id) ? 'selected' : '' %>><%= t.name %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-primary btn-sm">Найти</button>
    <% if (q || groupId || teacherId) { %>
      <a href="/admin/works" class="btn btn-ghost btn-sm">Сбросить</a>
    <% } %>
  </form>
  <section class="card">
    <div class="card-header">
      <h2>Работы (<%= total %><%= pages > 1 ? ', стр. ' + page + ' из ' + pages : '' %>)</h2>
    </div>
    <%- include('../../shared/ui/bulk-toolbar', {
      entity: 'works',
      scope: 'works',
      actions: [
        {
          href: '/admin/bulk-delete',
          label: 'В корзину',
          class: 'btn-danger btn-sm',
          method: 'POST',
          confirm: 'Переместить выбранные работы в корзину? Файлы сохранятся до hard-delete из /admin/trash.',
          okText: 'В корзину',
          okClass: 'danger'
        }
      ]
    }) %>
    <div class="info-box info-box-blue">
      Клик по теме открывает карточку: смена статуса, перемещение в корзину, удаление.
    </div>
    <% if (rows.length === 0) { %>
      <%- include('../../shared/ui/empty-state', {
        primary: 'Работ не найдено.',
        secondary: (q || groupId || teacherId) ? 'Попробуйте изменить фильтры.' : null,
        action: (q || groupId || teacherId) ? { href: '/admin/works', label: 'Сбросить фильтры' } : null,
        wrapper: false
      }) %>
    <% } else { %>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th class="bulk-th"><input type="checkbox" data-bulk-all data-bulk-scope="works" aria-label="Выбрать всех"></th>
              <th class="th-50">ID</th>
              <th>Студент / группа</th>
              <th>Преподаватель</th>
              <th>Тема</th>
              <th class="th-120">Статус</th>
              <th class="th-120">Корзина</th>
              <th class="th-160">Загружено</th>
              <th class="th-80">Файлы</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach((r) => { %>
              <tr class="<%= r.deleted_at ? 'cell-secondary' : '' %>">
                <td class="bulk-td"><input type="checkbox" data-bulk-checkbox data-bulk-scope="works" value="<%= r.id %>" aria-label="Выбрать работу <%= r.topic %>"></td>
                <td><%= r.id %></td>
                <td>
                  <div class="cell-primary"><%= r.student_name %></div>
                  <div class="cell-secondary">
                    <%= r.group_name %>
                    <% if (r.student_login) { %>· логин: <code class="user-select-all"><%= r.student_login %></code><% } %>
                  </div>
                </td>
                <td class="cell-secondary"><%= r.teacher_name %></td>
                <td>
                  <button type="button" class="link-button"
                          data-modal-open="work-modal-<%= r.id %>"
                          title="Открыть карточку">
                    <%= r.topic %>
                  </button>
                  <% if (r.external_url) { %>
                    <div class="cell-secondary">🔗 <a href="<%= r.external_url %>" target="_blank" rel="noopener">ссылка</a></div>
                  <% } %>
                </td>
                <td><%- include('../../shared/ui/status-badge', { status: r.status }) %></td>
                <td>
                  <% if (r.deleted_at) { %>
                    <span class="status-badge status-muted">в корзине</span>
                    <div class="cell-secondary mt-1"><%= formatDate(r.deleted_at) %></div>
                  <% } else { %>
                    <span class="cell-secondary">—</span>
                  <% } %>
                </td>
                <td class="cell-secondary text-nowrap"><%= formatDate(r.uploaded_at, true) %></td>
                <td><%= r.files_count %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../../shared/ui/paginator', {
        page, pages, total,
        urlFn: (p) => buildUrl('/admin/works', baseQuery, { page: p > 1 ? p : '' })
      }) %>
    <% } %>
  </section>
</div>

<%# ═══════════════ МОДАЛКИ РЕДАКТИРОВАНИЯ ═══════════════ %>
<% rows.forEach((r) => { %>
  <div class="modal" id="work-modal-<%= r.id %>" hidden role="dialog" aria-modal="true"
       aria-labelledby="work-modal-title-<%= r.id %>">
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 id="work-modal-title-<%= r.id %>">
          Работа #<%= r.id %>
        </h3>
        <button type="button" class="modal-close" data-modal-close aria-label="Закрыть">✕</button>
      </div>

      <div class="modal-section">
        <h4>Информация</h4>
        <div class="info-list">
          <div><strong>Студент</strong><span><%= r.student_name %></span></div>
          <div><strong>Группа</strong><span><%= r.group_name %></span></div>
          <div><strong>Преподаватель</strong><span><%= r.teacher_name %></span></div>
          <div><strong>Тема</strong><span><%= r.topic %></span></div>
          <div><strong>Загружено</strong><span><%= formatDate(r.uploaded_at, true) %></span></div>
          <div><strong>Файлов</strong><span><%= r.files_count %></span></div>
          <% if (r.external_url) { %>
            <div>
              <strong>Ссылка</strong>
              <a href="<%= r.external_url %>" target="_blank" rel="noopener"><%= r.external_url %></a>
            </div>
          <% } %>
          <% if (r.deleted_at) { %>
            <div><strong>В корзине</strong><span><%= formatDate(r.deleted_at, true) %></span></div>
          <% } %>
        </div>
      </div>

      <div class="modal-section">
        <h4>Статус</h4>
        <div class="actions-row" style="align-items: center;">
          <%- include('../../shared/ui/status-badge', { status: r.status }) %>
          <form method="POST" action="/admin/works/<%= r.id %>/status"
                class="inline-form"
                data-confirm="Сменить статус работы?"
                data-confirm-ok-text="Изменить"
                data-confirm-ok-class="primary">
            <input type="hidden" name="redirect" value="<%= redirectTo %>">
            <select name="status" data-auto-submit>
              <option value="pending"  <%= r.status === 'pending'  ? 'selected' : '' %>>На проверке</option>
              <option value="accepted" <%= r.status === 'accepted' ? 'selected' : '' %>>Принята</option>
              <option value="rejected" <%= r.status === 'rejected' ? 'selected' : '' %>>Отклонена</option>
            </select>
            <noscript><button type="submit" class="btn btn-success btn-sm">OK</button></noscript>
          </form>
        </div>
        <div class="hint">Дублирует действие преподавателя. При «Принята» снимается метка «Сделано с ИИ».</div>
      </div>

      <div class="modal-section">
        <h4>Корзина</h4>
        <form method="POST" action="/admin/works/<%= r.id %>/toggle-deleted"
              class="form-row"
              data-confirm="<%= r.deleted_at ? 'Восстановить работу из корзины?' : 'Переместить работу в корзину? Файлы сохранятся.' %>"
              data-confirm-ok-text="<%= r.deleted_at ? 'Восстановить' : 'В корзину' %>"
              data-confirm-ok-class="<%= r.deleted_at ? 'success' : 'warning' %>">
          <input type="hidden" name="redirect" value="<%= redirectTo %>">
          <button type="submit" class="btn btn-<%= r.deleted_at ? 'success' : 'warning' %> btn-sm">
            <%= r.deleted_at ? 'Восстановить из корзины' : 'В корзину' %>
          </button>
        </form>
        <div class="hint">
          <% if (r.deleted_at) { %>
            Вернуть работу в активный список. Данные и файлы сохранены.
          <% } else { %>
            Soft-delete. Данные и файлы сохраняются, восстановить можно из
            <a href="/admin/trash">корзины</a>.
          <% } %>
        </div>
      </div>

      <div class="modal-section">
        <h4>Удаление</h4>
        <form method="POST" action="/admin/works/<%= r.id %>/delete"
              class="form-row"
              data-confirm="Переместить работу «<%= r.topic %>» в корзину? Файлы сохранятся до hard-delete из /admin/trash."
              data-confirm-ok-text="В корзину"
              data-confirm-ok-class="danger">
          <input type="hidden" name="redirect" value="<%= redirectTo %>">
          <button type="submit" class="btn btn-danger btn-sm" <%= r.deleted_at ? 'disabled' : '' %>>
            Удалить
          </button>
        </form>
        <div class="hint">
          Действует так же, как «В корзину». Полное удаление с диска — только из
          <a href="/admin/trash">корзины</a>.
        </div>
      </div>

      <div class="actions-row" style="justify-content: flex-end; margin-top: var(--space-3);">
        <button type="button" class="btn btn-ghost" data-modal-close>Закрыть</button>
      </div>
    </div>
  </div>
<% }) %>

<%- include('../../layout/footer') %>
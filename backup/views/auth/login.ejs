<%- include('../layout/header', { title: 'Вход' }) %>
<%
  const dUsers = Array.isArray(demoUsers) ? demoUsers : [];
  const dTeachers = dUsers.filter((u) => u.role === 'teacher');
  const dStudents = dUsers.filter((u) => u.role === 'student');
%>
<div class="content-wrapper narrow">
  <div class="top-bar">
    <h1 class="top-bar-title">Вход в систему</h1>
  </div>
  <% if (demoMode && dUsers.length > 0) { %>
    <section class="card demo-card">
      <div class="card-header"><h2>🎭 Демонстрационный режим</h2></div>
      <div class="info-box info-box-yellow">
        Включён режим демонстрации. Кнопки ниже пускают без пароля.
        Пароль у всех — <code>Demo2026!</code>, если понадобится войти вручную.
      </div>
      <div class="card-header"><h3>Преподаватели (<%= dTeachers.length %>)</h3></div>
      <div class="demo-logins">
        <% dTeachers.forEach((u) => { %>
          <form action="/demo/login/teacher/<%= encodeURIComponent(u.login) %>"
                method="POST" class="demo-login-form">
            <button type="submit" class="demo-login-btn demo-login-teacher">
              <div class="demo-login-role">Преподаватель</div>
              <div class="demo-login-name">
                <%= u.last_name %> <%= u.first_name %> <%= u.middle_name %>
              </div>
              <div class="demo-login-meta">
                Логин: <code><%= u.login %></code>
                <% if (u.subject) { %> · <%= u.subject.title.replace('[Демо] ', '') %><% } %>
              </div>
            </button>
          </form>
        <% }) %>
      </div>
      <div class="card-header"><h3>Студенты (<%= dStudents.length %>)</h3></div>
      <div class="demo-logins">
        <% dStudents.forEach((u) => { %>
          <form action="/demo/login/student/<%= encodeURIComponent(u.login) %>"
                method="POST" class="demo-login-form">
            <button type="submit" class="demo-login-btn demo-login-student">
              <div class="demo-login-role">Студент</div>
              <div class="demo-login-name">
                <%= u.last_name %> <%= u.first_name %> <%= u.middle_name %>
              </div>
              <div class="demo-login-meta">
                Логин: <code><%= u.login %></code> · Группа: <%= u.group %>
              </div>
            </button>
          </form>
        <% }) %>
      </div>
      <div class="card-header"><h3>Администратор</h3></div>
      <div class="demo-logins">
        <form action="/demo/login-admin" method="POST" class="demo-login-form">
          <button type="submit" class="demo-login-btn demo-login-admin">
            <div class="demo-login-role">Администратор</div>
            <div class="demo-login-name">Войти без пароля</div>
            <div class="demo-login-meta">Полный доступ к системе</div>
          </button>
        </form>
      </div>
    </section>
  <% } %>
  <section class="card">
    <% if (error) { %>
      <div class="info-box info-box-red" role="alert"><%= error %></div>
    <% } %>
    <div class="tabs" id="roleTabs">
      <button type="button" class="tab <%= tab === 'student' ? 'active' : '' %>">Студент</button>
      <button type="button" class="tab <%= tab === 'teacher' ? 'active' : '' %>">Преподаватель</button>
    </div>
    <div class="form-section <%= tab === 'student' ? 'active' : '' %>" id="pane-student">
      <div class="tabs" id="modeTabs">
        <button type="button" class="tab <%= mode === 'login' ? 'active' : '' %>">Вход</button>
        <% if (registrationEnabled) { %>
          <button type="button" class="tab <%= mode === 'register' ? 'active' : '' %>">Регистрация</button>
        <% } %>
      </div>
      <form action="/login/student" method="POST"
        class="form-section <%= mode === 'login' ? 'active' : '' %>" id="form-login">
        <div class="form-grid">
          <label for="s-login-login" class="form-label">Логин</label>
          <div class="field">
            <input type="text" id="s-login-login" name="login" required maxlength="200"
              value="<%= form?.login || '' %>" autocomplete="username"
              placeholder="<%= studentLoginType === 'email' ? 'student@example.com' : 'Номер студенческого' %>">
            <div class="hint">
              <%= studentLoginType === 'email' ? 'Email, указанный при регистрации.' : 'Номер студенческого билета.' %>
            </div>
          </div>
          <label for="s-login-pass" class="form-label">Пароль</label>
          <div class="field">
            <input type="password" id="s-login-pass" name="password" required maxlength="200"
              autocomplete="current-password" placeholder="Пароль">
          </div>
          <div class="actions">
            <button type="submit" class="btn btn-success">Войти</button>
          </div>
        </div>
      </form>
      <% if (registrationEnabled) { %>
        <form action="/register/student" method="POST"
          class="form-section <%= mode === 'register' ? 'active' : '' %>" id="form-register">
          <div class="info-box info-box-blue info-box-how">
            После регистрации вы попадёте на страницу ожидания. Учётную запись подтверждает
            преподаватель вашей группы или администратор — обычно в течение учебного дня.
            Пока заявка не подтверждена, доступны только страница ожидания и
            <a href="/support">поддержка</a>.<br>
            Пароль можно будет сменить позже в профиле; требования к паролю — под полем.
          </div>
          <div class="form-grid">
            <label for="s-reg-login" class="form-label">Логин <span class="required">*</span></label>
            <div class="field">
              <input type="text" id="s-reg-login" name="login" required maxlength="200"
                value="<%= form?.login || '' %>" autocomplete="username"
                placeholder="<%= studentLoginType === 'email' ? 'student@example.com' : 'Номер студенческого' %>">
            </div>
            <label for="s-reg-last" class="form-label">Фамилия <span class="required">*</span></label>
            <div class="field">
              <input type="text" id="s-reg-last" name="last_name" required maxlength="100"
                value="<%= form?.last_name || '' %>" placeholder="Иванов">
            </div>
            <label for="s-reg-first" class="form-label">Имя <span class="required">*</span></label>
            <div class="field">
              <input type="text" id="s-reg-first" name="first_name" required maxlength="100"
                value="<%= form?.first_name || '' %>" placeholder="Иван">
            </div>
            <label for="s-reg-middle" class="form-label">Отчество</label>
            <div class="field">
              <input type="text" id="s-reg-middle" name="middle_name" maxlength="100"
                value="<%= form?.middle_name || '' %>" placeholder="Иванович">
            </div>
            <label for="s-reg-group" class="form-label">Группа <span class="required">*</span></label>
            <div class="field">
              <select id="s-reg-group" name="group_id" required>
                <option value="">Выберите группу</option>
                <% groups.forEach((g) => { %>
                  <option value="<%= g.id %>" <%= String(form?.group_id) === String(g.id) ? 'selected' : '' %>><%= g.name %></option>
                <% }) %>
              </select>
            </div>
            <label for="s-reg-pass" class="form-label">Пароль <span class="required">*</span></label>
            <div class="field">
              <input type="password" id="s-reg-pass" name="password" required
                minlength="<%= passwordRequirements[0]?.text.match(/\d+/)?.[0] || 8 %>"
                maxlength="200" autocomplete="new-password" placeholder="Пароль">
              <div class="hint">
                <div>Требования к паролю:</div>
                <ul class="hint-list">
                  <% passwordRequirements.forEach((r) => { %><li><%= r.text %></li><% }) %>
                </ul>
              </div>
            </div>
            <div class="actions">
              <button type="submit" class="btn btn-success">Зарегистрироваться</button>
            </div>
          </div>
        </form>
      <% } %>
    </div>
    <div class="form-section <%= tab === 'teacher' ? 'active' : '' %>" id="pane-teacher">
      <form action="/login/teacher" method="POST">
        <div class="form-grid">
          <label for="t-login-login" class="form-label">Email</label>
          <div class="field">
            <input type="email" id="t-login-login" name="login" required maxlength="200"
              value="<%= form?.login || '' %>" autocomplete="username"
              placeholder="teacher@example.com">
          </div>
          <label for="t-login-pass" class="form-label">Пароль</label>
          <div class="field">
            <input type="password" id="t-login-pass" name="password" required maxlength="200"
              autocomplete="current-password" placeholder="Пароль">
          </div>
          <div class="actions">
            <button type="submit" class="btn btn-success">Войти</button>
          </div>
        </div>
      </form>
      <div class="info-box info-box-yellow mt-3">
        <strong>Нет аккаунта?</strong> Обратитесь к администратору.
      </div>
    </div>
  </section>
</div>
<%- include('../layout/footer') %>
<%- include('../../layout/header', { title: 'Мои группы' }) %>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: 'Мои группы',
    actions: [{ href: '/groups', label: 'Список групп', class: 'btn-secondary' }]
  }) %>
  <div class="info-box info-box-blue info-box-how">
    Группы, которые вы ведёте. Здесь доступны предметы, задания, студенты и чат.
    Отметить новые — «Список групп». Снять — там же, сняв галочку.
    Снятие галочки ничего не удаляет, но предметы этой группы станут только для чтения.
  </div>
  <% if (groups.length > 0) { %>
    <form method="GET" action="/my-groups" class="inline-add-form">
      <input type="search" name="q" value="<%= q %>" placeholder="Поиск по названию" maxlength="100" class="search-input">
      <button type="submit" class="btn btn-primary btn-sm">Найти</button>
      <% if (q) { %><a href="/my-groups" class="btn btn-ghost btn-sm">Сбросить</a><% } %>
    </form>
  <% } %>
  <% if (groups.length === 0) { %>
    <section class="card">
      <div class="empty-state">
        <% if (q) { %>
          <p>Ничего не найдено по запросу «<%= q %>».</p>
          <a href="/my-groups" class="btn btn-secondary mt-md">Сбросить поиск</a>
        <% } else { %>
          <p>Вы пока не подписаны ни на одну группу.</p>
          <a href="/groups" class="btn btn-primary mt-md">Перейти в список групп</a>
        <% } %>
      </div>
    </section>
  <% } else { %>
    <div class="card-grid">
      <% groups.forEach((g) => { %>
        <a href="/g/<%= g.id %>" class="entity-card">
          <div class="entity-card-title"><%= g.name %></div>
          <div class="entity-card-subtitle">Студентов: <%= g.students_count %></div>
          <div class="entity-card-stats">
            <% if (g.my_works_count > 0) { %>
              <span>Работ: <%= g.my_works_count %></span>
              <% if (g.my_pending_count > 0) { %>
                <span class="status-badge status-pending">на проверке: <%= g.my_pending_count %></span>
              <% } %>
            <% } else { %>
              <span class="cell-secondary">Моих работ пока нет</span>
            <% } %>
            <% if (g.unread_count > 0) { %>
              <span class="unread-badge">💬 <%= g.unread_count %></span>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../../layout/footer') %>
<%- include('../../layout/header', { title: submission.topic }) %>
<%
  const isAccepted = submission.status === 'accepted';
  const isAiFlagged = !!submission.ai_flag && !isAccepted;
  const aiConfirmText = isAccepted
    ? 'Вернуть работу студенту и пометить «Сделано с ИИ»?\n\nСтатус станет «Отклонена», в переписку уйдёт сообщение о том, что работа выполнена с помощью ИИ.\n\nСтудент сможет пересдать.'
    : 'Отклонить с пометкой «Сделано с ИИ»?\n\nРабота будет отклонена, а в переписку уйдёт сообщение о том, что она выполнена с помощью ИИ.\n\nСтудент получит уведомление и сможет пересдать.';
%>
<div class="content-wrapper">
  <%- include('../../shared/page-top', {
    title: submission.topic,
    actions: [
      submission.assignment_id && submission.assignment_subject_id
        ? { href: `/subjects/${submission.assignment_subject_id}/assignments/${submission.assignment_id}`, label: 'К заданию', class: 'btn-secondary' }
        : null,
      { href: `/g/${submission.group_id}`, label: 'К группе' }
    ].filter(Boolean)
  }) %>
  <div class="info-box info-box-blue">
    <strong>Работа студента <%= submission.student_name %> (<%= submission.group_name %>).</strong>
    Статус, файлы и переписка.
  </div>
  <section class="card">
    <div class="card-header">
      <h2>Работа</h2>
      <div class="actions-row">
        <% if (isAiFlagged) { %>
          <span class="status-badge status-flag" title="Работа отмечена как сделанная с помощью ИИ">🤖 Сделано с ИИ</span>
        <% } %>
        <%- include('../../shared/ui/status-badge', { status: submission.status }) %>
      </div>
    </div>
    <div class="info-list">
      <div>
        <strong>Студент</strong>
        <span><%= submission.student_name %> · <%= submission.group_name %></span>
      </div>
      <div>
        <strong>Предмет</strong>
        <span>
          <% if (submission.subject_title) { %>
            <a href="/subjects/<%= submission.subject_id %>/topics"><%= submission.subject_title %></a>
          <% } else { %><span class="cell-secondary">—</span><% } %>
        </span>
      </div>
      <% if (submission.assignment_title) { %>
        <div>
          <strong>Задание</strong>
          <span>
            <% if (submission.assignment_subject_id) { %>
              <a href="/subjects/<%= submission.assignment_subject_id %>/assignments/<%= submission.assignment_id %>"><%= submission.assignment_title %></a>
            <% } else { %><%= submission.assignment_title %><% } %>
          </span>
        </div>
      <% } %>
      <div><strong>Тема</strong><span><%= submission.topic %></span></div>
      <% if (submission.external_url) { %>
        <div>
          <strong>Ссылка</strong>
          <a href="<%= submission.external_url %>" target="_blank" rel="noopener"><%= submission.external_url %></a>
        </div>
      <% } %>
      <div>
        <strong>Файлы</strong>
        <div>
          <%- include('../../shared/ui/attachments-list', {
            items: submission.attachments || [],
            empty: '—'
          }) %>
        </div>
      </div>
      <div><strong>Загружено</strong><span><%= formatDate(submission.uploaded_at, true) %></span></div>
      <% if (submission.comment) { %>
        <div><strong>Комментарий</strong><span class="text-pre"><%= submission.comment %></span></div>
      <% } %>
    </div>
    <div class="actions-row mt-3">
      <% if (isAccepted) { %>
        <form method="POST" action="/g/<%= submission.group_id %>/works/<%= submission.id %>/status" class="inline-form"
          data-confirm="Вернуть работу студенту? Статус станет «Отклонена». Студент сможет пересдать и снова писать сообщения."
          data-confirm-ok-text="Вернуть"
          data-confirm-ok-class="danger">
          <input type="hidden" name="status" value="rejected">
          <button type="submit" class="btn btn-danger btn-sm">Отклонить и вернуть студенту</button>
        </form>
      <% } else { %>
        <form method="POST" action="/g/<%= submission.group_id %>/works/<%= submission.id %>/status" class="inline-form"
          data-confirm="Принять работу?"
          data-confirm-ok-text="Принять"
          data-confirm-ok-class="success">
          <input type="hidden" name="status" value="accepted">
          <button type="submit" class="btn btn-success btn-sm">Принять</button>
        </form>
        <form method="POST" action="/g/<%= submission.group_id %>/works/<%= submission.id %>/status" class="inline-form"
          data-confirm="Отклонить работу?"
          data-confirm-ok-text="Отклонить"
          data-confirm-ok-class="danger">
          <input type="hidden" name="status" value="rejected">
          <button type="submit" class="btn btn-danger btn-sm" <%= submission.status === 'rejected' ? 'disabled' : '' %>>Отклонить</button>
        </form>
      <% } %>
      <form method="POST"
        action="/g/<%= submission.group_id %>/works/<%= submission.id %>/reject-ai"
        class="inline-form"
        data-confirm="<%= aiConfirmText %>"
        data-confirm-ok-text="Отклонить"
        data-confirm-ok-class="warning">
        <button type="submit" class="btn btn-warning btn-sm">🤖 Отклонить (сделано с ИИ)</button>
      </form>
    </div>
    <% if (isAccepted) { %>
      <div class="info-box info-box-green mt-3">
        <strong>Работа принята.</strong> Действия по работе завершены.
        Студент не может писать сообщения и прикреплять файлы.
        Если нужно вернуть работу — нажмите «Отклонить и вернуть студенту».
      </div>
    <% } else if (isAiFlagged) { %>
      <div class="info-box info-box-yellow mt-3">
        <strong>Работа помечена как сделанная с ИИ.</strong>
        Студент видит метку и получил уведомление.
        Если вы ошиблись — нажмите «Принять», метка снимется автоматически.
      </div>
    <% } %>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Переписка со студентом
        <% if (submission.subject_title) { %>
          <span class="cell-secondary page-subtitle">· <%= submission.subject_title %></span>
        <% } %>
      </h2>
      <div class="chat-meta">
        <span>Сообщений: <strong id="messageCount"><%= messages.length %></strong></span>
        <span id="lastUpdateTime"></span>
      </div>
    </div>
    <div class="chat-toolbar gap-2 items-center flex-wrap">
      <form method="GET" action="/g/<%= submission.group_id %>/works/<%= submission.id %>" class="inline-add-form search-input-240 m-0">
        <input type="search" name="q" value="<%= q || '' %>" maxlength="200" placeholder="Поиск по сообщениям" class="search-input-180">
        <button type="submit" class="btn btn-primary btn-sm">Найти</button>
        <% if (q) { %><a href="/g/<%= submission.group_id %>/works/<%= submission.id %>" class="btn btn-ghost btn-sm">Сбросить</a><% } %>
      </form>
      <button type="button" class="btn btn-secondary btn-sm" id="refreshBtn" >
        <span class="spinner"></span> ↻ Обновить
      </button>
    </div>
    <div id="messages" class="messages-list" aria-live="polite">
      <% if (messages.length === 0) { %>
        <%- include('../../shared/ui/empty-state', { primary: q ? 'Ничего не найдено.' : 'Сообщений пока нет.', wrapper: false }) %>
      <% } else { %>
        <% messages.forEach((m) => { %>
          <%- include('../../shared/chat/message', {
            m,
            viewerRole: 'teacher',
            viewerId: session.teacherId,
            deleteAction: isAccepted ? null : `/g/${submission.group_id}/works/${submission.id}/messages/${m.id}/delete`
          }) %>
        <% }) %>
      <% } %>
    </div>
    <% if (isAccepted) { %>
      <div class="info-box info-box-green mt-3">
        <strong>Работа принята.</strong> Переписка закрыта.
        Если нужно вернуть работу — нажмите «Отклонить и вернуть студенту» выше.
      </div>
    <% } else { %>
      <%- include('../../shared/chat/form', {
        action: `/g/${submission.group_id}/works/${submission.id}/messages`,
        placeholder: 'Ответ студенту'
      }) %>
    <% } %>
  </section>
</div>
<div id="newMessagesToast" class="toast"></div>
<script>
  window.submissionId = <%= JSON.stringify(submission.id) %>;
  window.userRole = 'teacher';
  window.userId = <%= JSON.stringify(session.teacherId) %>;
  window.baseUrl = '/g/<%= submission.group_id %>/works/<%= submission.id %>';
</script>
<script src="/js/chat.js" defer></script>
<%- include('../../shared/ui/file-viewer') %>
<%- include('../../layout/footer') %>
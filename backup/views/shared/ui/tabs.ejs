<%
  const _items = (typeof items !== 'undefined' && Array.isArray(items)) ? items : [];
%>
<div class="tabs">
  <% _items.forEach((it) => { %>
    <% if (it.href) { %>
      <a href="<%= it.href %>" class="tab <%= it.active ? 'active' : '' %>"><%= it.label %></a>
    <% } else if (it.onclick) { %>
      <button type="button" class="tab <%= it.active ? 'active' : '' %>" onclick="<%= it.onclick %>"><%= it.label %></button>
    <% } else { %>
      <span class="tab <%= it.active ? 'active' : '' %>"><%= it.label %></span>
    <% } %>
  <% }) %>
</div>
<%- include('../../layout/header', { title: 'Мои преподаватели' }) %>
<div class="content-wrapper">
  <%- include('../../shared/page-top', { title: 'Мои преподаватели' }) %>
  <div class="info-box info-box-blue info-box-how">
    Здесь преподаватели, которые ведут вашу группу.
    У них доступны предметы, лекции, задания и чаты.<br>
    Если нужного преподавателя нет — попросите его отметить вашу группу как
    «Моя группа» в разделе «Группы», или обратитесь к администратору.
  </div>
  <% if (teachers.length > 0) { %>
    <form method="GET" action="/my-teachers" class="inline-add-form">
      <input type="search" name="q" value="<%= q %>" placeholder="Поиск по ФИО" maxlength="100" class="search-input">
      <button type="submit" class="btn btn-primary btn-sm">Найти</button>
      <% if (q) { %><a href="/my-teachers" class="btn btn-ghost btn-sm">Сбросить</a><% } %>
    </form>
  <% } %>
  <% if (teachers.length === 0) { %>
    <section class="card">
      <div class="empty-state">
        <% if (q) { %>
          <p>Ничего не найдено по запросу «<%= q %>».</p>
          <a href="/my-teachers" class="btn btn-secondary mt-md">Сбросить поиск</a>
        <% } else { %>
          <p>Пока ни один преподаватель не отметил вашу группу как «Моя группа».</p>
          <p class="cell-secondary">
            Обратитесь к преподавателю или администратору — как только он отметит группу,
            он появится здесь, а вместе с ним — предметы, лекции и задания.
          </p>
        <% } %>
      </div>
    </section>
  <% } else { %>
    <div class="card-grid">
      <% teachers.forEach((t) => { %>
        <div class="entity-card entity-card-clickable">
          <a href="/t/<%= t.id %>" class="entity-card-link">
            <div class="entity-card-title"><%= t.name %></div>
            <div class="entity-card-subtitle">
              <% if (t.subjects_count > 0) { %>
                Предметов у вашей группы: <%= t.subjects_count %>
              <% } else { %>
                Пока не прикрепил предметы к вашей группе
              <% } %>
            </div>
            <div class="entity-card-stats">
              <% if (t.my_works_count > 0) { %>
                <span>Работ: <%= t.my_works_count %></span>
                <% if (t.my_pending_count > 0) { %>
                  <span class="status-badge status-pending">на проверке: <%= t.my_pending_count %></span>
                <% } %>
              <% } else { %>
                <span class="cell-secondary">Работ пока нет</span>
              <% } %>
              <% if (t.unread_count > 0) { %>
                <span class="unread-badge">💬 <%= t.unread_count %></span>
              <% } %>
            </div>
          </a>
          <% if (t.max_url) { %>
            <div style="padding: 0 var(--space-5) var(--space-4);">
              <a href="<%= t.max_url %>" target="_blank" rel="noopener noreferrer"
                 class="btn btn-secondary btn-sm">
                <img src="/img/sferum_Logo.svg" alt="" class="btn-icon"
                  onerror="this.style.display='none'">Канал MAX
              </a>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../../layout/footer') %>
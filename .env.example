# ============================================================
# .env.example — шаблон для репозитория.
#
#   cp .env.example .env
#
# Всё, что не помечено как обязательное, можно оставить пустым.
# Бизнес-настройки — в /admin/settings после первого входа.
#
# Демо-данные создаются автоматически, если включён флаг
# demo.enabled в /admin/settings (по умолчанию включён).
# Из админки их можно удалить одной кнопкой.
# ============================================================


# ─── Режим ─────────────────────────────────────────────────
# development | production
NODE_ENV=production


# ─── Сеть ──────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true


# ─── Демо-кнопки (только development) ──────────────────────
DEMO_MODE=false


# ─── Данные ────────────────────────────────────────────────
# Пусто — <проект>/data.
# DATA_DIR=/var/lib/workstud
DATA_DIR=


# ─── Секреты ───────────────────────────────────────────────
# production: обязателен, >= 32 символов.
# development: пусто => сгенерируется в DATA_DIR/.session-secret.
SESSION_SECRET=


# ─── Первый администратор (bootstrap) ─────────────────────
# Используется ОДИН РАЗ — при первом старте, когда admins пуст.
# production: ADMIN_PASSWORD обязателен, минимум 12 символов.
ADMIN_NAME=admin
ADMIN_PASSWORD=adminadminadmin
# --- QWEN.md rule (added 2026-11-17) ---
# Do not install or run the application; work with code only.
NO_INSTALL=1
SKIP_POSTINSTALL=1
